            function getEnvironment() {
                const domainName = window.location.hostname;
                const isTestEnv =
                    (
                        domainName.includes('localhost') ||
                        domainName.includes('tst.') ||
                        domainName.includes('dev.') ||
                        domainName.includes('stg.')
                    );

                return isTestEnv ? 'test' : 'prod';
            }

