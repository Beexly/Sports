+const BIND_HOST = process.env.HOST?.trim() || "127.0.0.1";
+const tokenHashes = loadTokenHashMapFromEnv(process.env);
+if (
+  BIND_HOST !== "127.0.0.1" &&
+  BIND_HOST !== "localhost" &&
+  BIND_HOST !== "::1" &&
+  process.env.FLEET_ALLOW_NON_LOOPBACK !== "1"
+) {
+  throw new Error(
+    `Refusing non-loopback bind (${BIND_HOST}) without FLEET_ALLOW_NON_LOOPBACK=1`
+  );
+}
+app.listen(PORT, BIND_HOST, () => {
+  console.log(`gse-spark-mcp listening on ${BIND_HOST}:${PORT} (fleet auth: token, ${tokenHashes.size} agent(s) configured)`);
 });
