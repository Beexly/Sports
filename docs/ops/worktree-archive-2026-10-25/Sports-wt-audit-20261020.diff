+/**
+ * Hard pre-kickoff publication gate enforcing 100% alignment between live 90-min
+ * inactives, live weather sensor telemetry, live book lines, ESPN scoreboard matchups,
+ * internal engine layer unanimity, and @GalaxySportsHQ brand handle.
+ */
+export function evaluatePreKickoffRealityReconciliationGate(
+  input: PreKickoffRealityGateInput,
+): PreKickoffRealityGateVerdict {
+  const violations: string[] = [];
+  if (!input.inactivesVerified90MinPreKick) {
+    violations.push("90-minute official inactive list not yet verified against active roster");
+  }
+  if (Math.abs(input.cardWindMph - input.sensorWindMph) > 3.0) {
+    violations.push(`Wind mismatch: card states ${input.cardWindMph} mph vs sensor ${input.sensorWindMph} mph`);
+  }
+  if (Math.abs(input.cardTempF - input.sensorTempF) > 5.0) {
+    violations.push(`Temperature mismatch: card states ${input.cardTempF}°F vs sensor ${input.sensorTempF}°F`);
+  }
+  if (Math.abs(input.cardSpread - input.liveBookSpread) > 0.5) {
+    violations.push(`Stale spread: card states ${input.cardSpread} vs live book ${input.liveBookSpread}`);
+  }
+  if (!input.engineLayersUnanimous) {
+    violations.push("Internal engine contradiction: runIntelligence vs overlay/pipeline publish state mismatch");
+  }
+  if (!input.espnScoreboardMatchupsVerified) {
+    violations.push("Multi-sport board matchups not verified against live ESPN scoreboard API");
+  }
+  if (input.brandHandle !== "@GalaxySportsHQ") {
+    violations.push(`Invalid brand handle ${input.brandHandle}; must be @GalaxySportsHQ`);
+  }
+  return {
+    publishAllowed: violations.length === 0,
+    violations,
+  };
+}
