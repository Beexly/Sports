+  draftRound: number;
+  trailingTwoWeekRouteRate: number;
+  seasonPriorTargetShare: number;
+  veteranCoStarterLimitedOrDecoy: boolean;
+}
+
+export interface RookieTargetRampResult {
+  adjustedTargetShare: number;
+  rampBoostDelta: number;
+  breakoutActive: boolean;
+}
+
+/**
+ * Learned from 2026-10-22 NE @ CHI (Rookie TE Colston Loveland 12 TGTS / 7 REC / 69 YDS / 1 TD,
+ * Rookie WR Luther Burden III 4 REC / 130 YDS / 1 TD, Rookie TE Eli Raridon 3 REC / 56 YDS / 1 TD):
+ * Overrides stale season-long target priors when Day-1/Day-2 rookies cross the 65% route ramp
+ * or when a veteran co-starter (e.g. DJ Moore 0 targets) is decoyed/limited.
+ */
+export function evaluateRookieSnapAndTargetRampOverride(
+  input: RookieTargetRampInput,
+): RookieTargetRampResult {
+  const highDraftCapital = input.draftRound >= 1 && input.draftRound <= 3;
+  const routeThresholdMet = input.trailingTwoWeekRouteRate >= 0.65;
+  let rampBoostDelta = 0;
+  if (highDraftCapital && routeThresholdMet) rampBoostDelta += 0.065;
+  if (input.veteranCoStarterLimitedOrDecoy) rampBoostDelta += 0.055;
+
+  return {
+    adjustedTargetShare: clamp01(input.seasonPriorTargetShare + rampBoostDelta),
+    rampBoostDelta,
+    breakoutActive: rampBoostDelta >= 0.06,
+  };
+}
