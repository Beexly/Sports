+export interface MutualDefensiveAttritionTotalInput {
+  homeStartingLbsOut: number;
+  awayStartingCb1Out: boolean;
+  homeEdgePrimaryPassRusherActive: boolean;
+  temperatureF: number;
+  windMph: number;
+  baseProjectedTotal: number;
+}
+
+export interface MutualDefensiveAttritionTotalResult {
+  adjustedProjectedTotal: number;
+  explosivePlayPointsDelta: number;
+  calmWeatherExtendedFgPointsDelta: number;
+  overridesOlineUnderLean: boolean;
+  explanation: string;
+}
+
+/**
+ * Learned from 2026-10-22 NE @ CHI (30-24 = 54 pts, 785 total yds, 7.6 & 6.1 YPP,
+ * 58-yd Santos FG + 47-yd Borregales FG in 57°F / 5.1 mph calm weather):
+ * When both defenses suffer spine attrition (both starting LBs OUT on one side,
+ * CB1 OUT on the other) in calm weather (wind <= 8 mph, temp >= 50°F), mutual
+ * explosive YAC and 50+ yard FG range override offensive-line red-zone stall Under leans.
+ */
+export function evaluateMutualDefensiveAttritionTotalOverride(
+  input: MutualDefensiveAttritionTotalInput,
+): MutualDefensiveAttritionTotalResult {
+  const calmWeather = input.windMph <= 8 && input.temperatureF >= 50;
+  const mutualSpineVoid = input.homeStartingLbsOut >= 2 && input.awayStartingCb1Out;
+  const passRushMuted = !input.homeEdgePrimaryPassRusherActive;
+
+  let explosivePlayPointsDelta = 0;
+  if (mutualSpineVoid) explosivePlayPointsDelta += 3.2;
+  if (passRushMuted) explosivePlayPointsDelta += 1.4;
+
+  const calmWeatherExtendedFgPointsDelta = calmWeather ? 1.5 : 0;
+  const totalDelta = explosivePlayPointsDelta + calmWeatherExtendedFgPointsDelta;
+  const adjustedProjectedTotal = input.baseProjectedTotal + totalDelta;
+
+  return {
+    adjustedProjectedTotal,
+    explosivePlayPointsDelta,
+    calmWeatherExtendedFgPointsDelta,
+    overridesOlineUnderLean: mutualSpineVoid && calmWeather,
+    explanation:
+      mutualSpineVoid && calmWeather
+        ? `Mutual defensive spine attrition (+${explosivePlayPointsDelta.toFixed(1)} pts) + calm-weather 55+ yd FG range (+${calmWeatherExtendedFgPointsDelta.toFixed(1)} pts) overrides O-line Under lean.`
+        : "Standard defensive availability regime.",
+  };
+}
