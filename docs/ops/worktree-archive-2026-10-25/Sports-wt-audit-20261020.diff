+export interface QbKneeldownRushHaircutInput {
+  rawProjectedRushYards: number;
+  propLine: number;
+  teamWinProbability: number;
+  projectedPassYards: number;
+}
+
+export interface QbKneeldownRushHaircutResult {
+  adjustedProjectedRushYards: number;
+  expectedKneeldownYardsDelta: number;
+  cleanPocketPassFirstHaircut: number;
+  hookRiskFlag: boolean;
+  recommendation: "PLAY_OVER" | "PASS_KNEELDOWN_HOOK_RISK";
+}
+
+/**
+ * Learned from 2026-10-22 NE @ CHI (Caleb Williams 18 rush yds vs 19.5 line;
+ * Drake Maye 26 rush yds vs 27.5 line — both missed by 1.5 yds while throwing for 308 & 321 yds):
+ * Accounts for victory-formation kneel-downs and high-efficiency pocket passing reducing scramble volume.
+ */
+export function evaluateQbKneeldownAndLeadScriptRushHaircut(
+  input: QbKneeldownRushHaircutInput,
+): QbKneeldownRushHaircutResult {
+  const expectedKneeldownYardsDelta =
+    input.teamWinProbability >= 0.55 ? -2.4 * input.teamWinProbability : -0.6;
+  const cleanPocketPassFirstHaircut =
+    input.projectedPassYards >= 285 ? -1.8 : 0;
+  const adjustedProjectedRushYards = Math.max(
+    0,
+    input.rawProjectedRushYards + expectedKneeldownYardsDelta + cleanPocketPassFirstHaircut,
+  );
+  const edgeAfterHaircut = adjustedProjectedRushYards - input.propLine;
+  const hookRiskFlag = edgeAfterHaircut < 3.5;
+
+  return {
+    adjustedProjectedRushYards,
+    expectedKneeldownYardsDelta,
+    cleanPocketPassFirstHaircut,
+    hookRiskFlag,
+    recommendation: hookRiskFlag ? "PASS_KNEELDOWN_HOOK_RISK" : "PLAY_OVER",
+  };
+}
