+export interface LbVoidAbsorptionInput {
+  startingInsideLbsOut: number;
+  opposingNickelCbActive: boolean;
+  te1BaseTargetShare: number;
+  te2BaseTargetShare: number;
+  rb1BaseTargetShare: number;
+  slotWrBaseTargetShare: number;
+}
+
+export interface LbVoidAbsorptionResult {
+  te1AdjustedTargetShare: number;
+  te2AdjustedTargetShare: number;
+  rb1AdjustedTargetShare: number;
+  slotWrAdjustedTargetShare: number;
+  slotWrNickelSuppressionApplied: boolean;
+  combinedTeRbShareDelta: number;
+  explanation: string;
+}
+
+/**
+ * Learned from 2026-10-22 NE @ CHI (Hunter Henry 7/71, Eli Raridon 3/56/TD,
+ * Rhamondre Stevenson 5/93/TD vs DeMario Douglas 3/23 against active Nickel CB Kyler Gordon):
+ * When both starting inside LBs are OUT (Sanborn + Edwards), vacated MOF targets
+ * flow to TE1, TE2 (12-personnel seams), and RB1 angle/checkdown routes, NOT the
+ * slot WR when the opposing Nickel CB is active and healthy.
+ */
+export function evaluateLbVoidTeRbVsSlotAbsorption(
+  input: LbVoidAbsorptionInput,
+): LbVoidAbsorptionResult {
+  const lbFactor = clamp(input.startingInsideLbsOut, 0, 3) / 2;
+  const te1Boost = 0.045 * lbFactor;
+  const te2Boost = 0.035 * lbFactor;
+  const rb1Boost = 0.040 * lbFactor;
+  const slotAdjustment = input.opposingNickelCbActive
+    ? -0.045 * lbFactor
+    : 0.025 * lbFactor;
+
+  const te1AdjustedTargetShare = clamp01(input.te1BaseTargetShare + te1Boost);
+  const te2AdjustedTargetShare = clamp01(input.te2BaseTargetShare + te2Boost);
+  const rb1AdjustedTargetShare = clamp01(input.rb1BaseTargetShare + rb1Boost);
+  const slotWrAdjustedTargetShare = clamp01(input.slotWrBaseTargetShare + slotAdjustment);
+
+  return {
+    te1AdjustedTargetShare,
+    te2AdjustedTargetShare,
+    rb1AdjustedTargetShare,
+    slotWrAdjustedTargetShare,
+    slotWrNickelSuppressionApplied: input.opposingNickelCbActive && input.startingInsideLbsOut >= 1,
+    combinedTeRbShareDelta: te1Boost + te2Boost + rb1Boost,
+    explanation: input.opposingNickelCbActive
+      ? "Inside LB void absorbed by TE1/TE2 seams and RB1 checkdowns; active Nickel CB suppresses slot WR overflow."
+      : "Inside LB void shared across TE1, TE2, RB1, and slot WR.",
+  };
+}
