+ * present. Returns null when the QB's team cannot supply that many (thin team)
+ * instead of returning a half-stacked lineup.
+ */
+function stackToNeed(lu: DfsPlayer[], pool: readonly DfsPlayer[], opts: OptOpts, need: number): DfsPlayer[] | null {
+  let cur = lu;
+  for (let i = 0; i < need && qbStackCount(cur).stacked < need; i++) {
+    const next = stackToQb(cur, pool, opts);
+    if (!next) break;
+    cur = next;
+  }
+  return qbStackCount(cur).stacked >= need ? cur : null;
+}
