coverage/
!data/statking/coverage/
!data/statking/coverage/**

# Vercel
.vercel
**/.vercel/

# Turbo
.turbo
apps/web/tsconfig.tsbuildinfo

# Local agent/runtime debris
.agent/logs/
scrapes/
tmp/
.cache/

