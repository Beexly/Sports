_speedtest/
_speedtest.bad/
_disktest
_disktest.bad
node_modules.bad/
node_modules.partial/
_overnight_quarantine/
.synthetic-monitoring/

# Accidental nested repository clone from Phase 0 cleanup.
Sports/


# Local launch secrets — never commit
.launch-secrets/
VERCEL_ENV.txt
.env.vercel
.env*.local

# Playwright visual-review artifacts (generated by scripts/screenshot.mjs)
screenshots/
/test-results/
/playwright-report/
test-results/
playwright-report/

# Ignore local .claude config, but DO track shared project commands.
.claude/*
!.claude/commands/

# Local session helper scripts — never commit
*.bat
*.ps1
*.cmd

# GSE local waitlist runtime data — local-file fallback store, never commit
.gse-local/
packages/prediction-engine/node_modules/
machina-templates/

# Local npm-audit / route-inventory scratch dumps — never commit
scratch_audit_*.json
scratch_audit_err.txt
dashfiles.json
