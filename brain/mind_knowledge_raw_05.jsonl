\n{\"id\": \"1901.02776v2\", \"title\": \"Causal mediation analysis for stochastic interventions\", \"url\": \"https://arxiv.org/abs/1901.02776v2\", \"published\": \"2019-01-09T15:20:00Z\", \"wave\": null, \"query\": null, \"score\": 2, \"rationale\": \"Causal mediation analysis for stochastic interventions \\u2014 direct/indirect effect decomposition with weaker identification assumptions.\"}\n{\"id\": \"1809.08039v1\", \"title\": \"Besov and Triebel-Lizorkin spaces associated with Laguerre expansions of Hermite type\", \"url\": \"https://arxiv.org/abs/1809.08039v1\", \"published\": \"2018-09-21T11:10:34Z\", \"wave\": null, \"query\": null, \"score\": 0, \"rationale\": \"Pure harmonic analysis (Besov spaces) \\u2014 no sports content.\"}\n{\"id\": \"1806.06696v1\", \"title\": \"SMOGS: Social Network Metrics of Game Success\", \"url\": \"https://arxiv.org/abs/1806.06696v1\", \"published\": \"2018-06-18T13:56:13Z\", \"wave\": null, \"query\": null, \"score\": 2, \"rationale\": \"Passing as dynamic relational network + multiplicative latent factors; MCMC; college basketball tracking\"}\n{\"id\": \"1804.04226v1\", \"title\": \"Increased Prediction Accuracy in the Game of Cricket using Machine Learning\", \"url\": \"https://arxiv.org/abs/1804.04226v1\", \"published\": \"2018-04-09T13:56:41Z\", \"wave\": null, \"query\": null, \"score\": 2, \"rationale\": \"Cricket player-performance classification (runs/wickets ranges) via naive Bayes and other ML \\u2014 applied sports player modeling.\"}\n{\"id\": \"1802.04687v2\", \"title\": \"Neural Relational Inference for Interacting Systems\", \"url\": \"https://arxiv.org/abs/1802.04687v2\", \"published\": \"2018-02-13T15:35:11Z\", \"wave\": null, \"query\": null, \"score\": 3, \"rationale\": \"NRI discovers latent player-interaction graphs unsupervised from tracking data \\u2014 e.g., which rusher keys off which blocker.\"}\n{\"id\": \"1712.05879v1\", \"title\": \"Hierarchical Bayesian Bradley-Terry for Applications in Major League Baseball\", \"url\": \"https://arxiv.org/abs/1712.05879v1\", \"published\": \"2017-12-16T00:03:06Z\", \"wave\": null, \"query\": null, \"score\": 2, \"rationale\": \"Hierarchical Bayes BT beats MLE analogues for ranking and prediction\"}\n{\"id\": \"1708.02715v1\", \"title\": \"Order Flows and Limit Order Book Resiliency on the Meso-Scale\", \"url\": \"https://arxiv.org/abs/1708.02715v1\", \"published\": \"2017-08-09T04:40:29Z\", \"wave\": null, \"query\": null, \"score\": 2, \"rationale\": \"Nonlinear trade-imbalance\\u2192price link linearized by weighted order flows; limit flows most predictive; deep book shape matters\"}\n{\"id\": \"1705.05831v1\", \"title\": \"Match results prediction ability of official ATP singles ranking\", \"url\": \"https://arxiv.org/abs/1705.05831v1\", \"published\": \"2017-05-17T00:58:58Z\", \"wave\": null, \"query\": null, \"score\": 2, \"rationale\": \"ATP ranking-points logistic model validated on 24,000-plus matches \\u2014 tennis match-prediction baseline.\"}\n{\"id\": \"1610.00825v1\", \"title\": \"Predict genome-scale fluxes based solely on enzyme abundance by a novel Hyper-Cube Shrink Algorithm\", \"url\": \"https://arxiv.org/abs/1610.00825v1\", \"published\": \"2016-10-04T02:27:11Z\", \"wave\": null, \"query\": null, \"score\": 0, \"rationale\": \"Genome-scale metabolic modeling \\u2014 no sports content.\"}\n{\"id\": \"1604.05090v1\", \"title\": \"Robust Draws in Balanced Knockout Tournaments\", \"url\": \"https://arxiv.org/abs/1604.05090v1\", \"published\": \"2016-04-18T11:13:59Z\", \"wave\": null, \"query\": null, \"score\": 2, \"rationale\": \"Rejects rational coaching (PAT/4th down); logistic regression on turnovers/time of possession etc.; ~63% accuracy, beats experts 60%\"}\n{\"id\": \"1601.04302v6\", \"title\": \"Footballonomics: The Anatomy of American Football; Evidence from 7 years of NFL game data\", \"url\": \"https://arxiv.org/abs/1601.04302v6\", \"published\": \"2016-01-17T15:21:14Z\", \"wave\": null, \"query\": null, \"score\": 2, \"rationale\": \"Same Footballonomics work as the report's score-2 paper \\u2014 rejects rational coaching on 7 NFL seasons and quantifies win-probability factors.\"}\n{\"id\": \"1510.02172v2\", \"title\": \"Hockey Player Performance via Regularized Logistic Regression\", \"url\": \"https://arxiv.org/abs/1510.02172v2\", \"published\": \"2015-10-08T00:19:20Z\", \"wave\": null, \"query\": null, \"score\": 2, \"rationale\": \"Joint regularized logistic model for on-ice goal probability; partial player effects\"}\n{\"id\": \"1406.3402v2\", \"title\": \"Relieving and Readjusting Pythagoras\", \"url\": \"https://arxiv.org/abs/1406.3402v2\", \"published\": \"2014-06-13T01:28:05Z\", \"wave\": null, \"query\": null, \"score\": 2, \"rationale\": \"Linear combination of Weibulls for run distributions; ~25% better win% prediction (~4 games \\u2192 ~3 games error)\"}\n{\"id\": \"1310.4461v2\", \"title\": \"Scoring dynamics across professional team sports: tempo, balance and predictability\", \"url\": \"https://arxiv.org/abs/1310.4461v2\", \"published\": \"2013-10-16T17:44:35Z\", \"wave\": null, \"query\": null, \"score\": 3, \"rationale\": \"Compact generative scoring model (Poisson tempo plus lead-dependent Bernoulli balance) validated on NFL/CFB/NHL/NBA data.\"}\n{\"id\": \"1301.2954v1\", \"title\": \"The ranking lasso and its application to sport tournaments\", \"url\": \"https://arxiv.org/abs/1301.2954v1\", \"published\": \"2013-01-14T12:42:13Z\", \"wave\": null, \"query\": null, \"score\": 3, \"rationale\": \"Ranking lasso auto-tiers BT ratings and improves NFL predictions vs MLE \\u2014 race against ridge and phantom-player on GSE's own ratings.\"}\n{\"id\": \"1201.0317v2\", \"title\": \"Adjusted Plus-Minus for NHL Players using Ridge Regression with Goals, Shots, Fenwick, and Corsi\", \"url\": \"https://arxiv.org/abs/1201.0317v2\", \"published\": \"2012-01-01T00:13:03Z\", \"wave\": null, \"query\": null, \"score\": 2, \"rationale\": \"Ridge APM with