{"id": "arxiv-sweep/waves/wave5-worker5-status.jsonl", "corpus": "arxiv-sweep", "kind": "wave", "chars": 3258, "equations": [], "text": "{\"arxiv_id\": \"2106.11397v1\", \"status\": \"completed\", \"ledger\": \"/home/hatch/workspace/vendor/Sports/docs/research/2026-09-21/arxiv-deep/0429-evaluating-team-skill-aggregation-in-online.md\", \"verdict\": \"ADAPT\", \"notes\": \"MAX/SUM/MIN team-skill aggregation is a new GSE capability question; NFL role-weighted aggregation test proposed.\"}\n{\"arxiv_id\": \"2104.03252v2\", \"status\": \"completed\", \"ledger\": \"/home/hatch/workspace/vendor/Sports/docs/research/2026-09-21/arxiv-deep/0430-leaving-goals-on-the-pitch-evaluating.md\", \"verdict\": \"REJECT\", \"notes\": \"Soccer shot-policy MDP has no useful NFL transfer beyond already-covered 4th-down/in-game-WP methods.\"}\n{\"arxiv_id\": \"2003.10791v1\", \"status\": \"completed\", \"ledger\": \"/home/hatch/workspace/vendor/Sports/docs/research/2026-09-21/arxiv-deep/0431-predicting-play-calls-in-the-national.md\", \"verdict\": \"ADAPT\", \"notes\": \"Per-team two-state HMM for NFL run/pass regimes; new capability for props and live modeling.\"}\n{\"arxiv_id\": \"1901.02858v1\", \"status\": \"completed\", \"ledger\": \"/home/hatch/workspace/vendor/Sports/docs/research/2026-09-21/arxiv-deep/0432-adaptive-feature-processing-for-robust-human.md\", \"verdict\": \"REJECT\", \"notes\": \"Indoor RGB-D/LiDAR activity recognition; no GSE transfer path.\"}\n{\"arxiv_id\": \"1710.05284v1\", \"status\": \"completed\", \"ledger\": \"/home/hatch/workspace/vendor/Sports/docs/research/2026-09-21/arxiv-deep/0433-multivariate-generalized-linear-mixed-models-for.md\", \"verdict\": \"ADAPT\", \"notes\": \"Joint outcome/efficiency GLMM with correlated offense/defense/win-propensity effects extends hierarchical team-strength lane.\"}\n{\"arxiv_id\": \"1706.04943v1\", \"status\": \"completed\", \"ledger\": \"/home/hatch/workspace/vendor/Sports/docs/research/2026-09-21/arxiv-deep/0434-plusminus-player-ratings-for-soccer.md\", \"verdict\": \"ADAPT\", \"notes\": \"Ridge-adjusted plus-minus portable to NFL snap-level EPA/WPA attribution as nflWAR complement.\"}\n{\"arxiv_id\": \"1702.05982v1\", \"status\": \"completed\", \"ledger\": \"/home/hatch/workspace/vendor/Sports/docs/research/2026-09-21/arxiv-deep/0435-wages-of-wins-could-an-amateur.md\", \"verdict\": \"ADAPT\", \"notes\": \"Accuracy-vs-pay-out lesson adopted as pay-out-weighted model-selection doctrine; classifiers/stale lines not reused.\"}\n{\"arxiv_id\": \"1510.02172v2\", \"status\": \"completed\", \"ledger\": \"/home/hatch/workspace/vendor/Sports/docs/research/2026-09-21/arxiv-deep/0436-hockey-player-performance-via-regularized-logistic.md\", \"verdict\": \"ADAPT\", \"notes\": \"L1-regularized logistic partial plus-minus (PPM/PFP) transfers to NFL player attribution; NHL specifics do not.\"}\n{\"arxiv_id\": \"1208.0799v2\", \"status\": \"completed\", \"ledger\": \"/home/hatch/workspace/vendor/Sports/docs/research/2026-09-21/arxiv-deep/0437-competing-process-hazard-function-models-for.md\", \"verdict\": \"ADAPT\", \"notes\": \"Competing-process hazard framing with separate offensive/defensive ratings (MESH); NFL drive-outcome adaptation via penalized multinomial.\"}\n{\"arxiv_id\": \"2609.12468v1\", \"status\": \"completed\", \"ledger\": \"/home/hatch/workspace/vendor/Sports/docs/research/2026-09-21/arxiv-deep/0438-gibbs-sampling-for-bayesian-generalized-poisson.md\", \"verdict\": \"REJECT\", \"notes\": \"Pure Bayesian NMF methodology; no sports-prediction mechanism, descriptive soccer application only.\"}\n"}
