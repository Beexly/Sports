// ============================================================
// UNIVERSAL SIGNAL LEDGER ("weight absolutely everything")
// ------------------------------------------------------------
// One row per signal that moves an entity's value — hard metrics AND soft
// signals (practice status, rumors, coachspeak). Each row carries its OWN
// weight + confidence (the honesty valve) + a normalized directional `value`,
// so the weighting POLICY lives in the data (set by calibration-gated
// populators), never hardcoded. The prediction-engine `composeLedger` bridge
// blends these via the existing composite-score engine with freshness decay.
// Storage only — NOT wired into the published pick score.
// ============================================================

model Signal {
  id         String   @id @default(cuid())
  entityType String // "player" | "team"
  entityId   String // gsis id or team abbreviation
  key        String // e.g. "ngs.separation", "injury.practice_status", "rumor.holdout"
  category   String // SignalCategory value (PRODUCTION / HEALTH / NARRATIVE / ...)
  valueRaw   Float? // source reading, retained for audit
  value      Float // normalized directional reading (+ good / − bad) for the composer
  weight     Float    @default(1) // base importance (>= 0)
  confidence Float    @default(1) // 0..1 honesty valve (settled stat ≈ 1, rumor ≈ 0.2)
  capturedAt DateTime // drives freshness decay

  // Non-null with a 0 sentinel so the unique key actually enforces one row per
  // signal — Postgres treats NULLs as distinct, which would let duplicates
  // (and thus double-counted votes) through for non-seasonal signals.
  season Int @default(0) // 0 = season-agnostic / non-seasonal signal
  week   Int @default(0) // 0 = full-season / non-weekly signal

  sourceId       String   @default("nflverse")
  rightsSnapshot Json
  fetchedAt      DateTime

  @@unique([entityType, entityId, key, season, week])
  @@index([entityType, entityId])
  @@index([category])
  @@map("signals")
}

// ============================================================
// AI CONTROL PLANE — INVOCATION / ATTEMPT / FINANCIAL ATTRIBUTION LEDGER
// (Phase 2 PR-B, blueprint §B)
//
// Additive, dormant telemetry. These three tables record every AI task
// invocation, each provider attempt within it, and the pre-call financial
// attribution — WITHOUT ever claiming settlement. They are written only by
// the `executeAiTask` facade (apps/web/lib/ai-control-plane/execute.ts),
// which no call site uses yet, so this changes zero runtime behavior.
//
// Enum-like columns are plain String with an inline value list, matching the
// documented convention of OddsLineSnapshot.phase / Watchlist.entityType
// (Postgres has no `CREATE TYPE ... IF NOT EXISTS`, so native enums are not
// safely re-appliable in an IF-NOT-EXISTS additive migration).
//
// Two structural invariants live in the shape itself:
//   - provider ≠ payer (#151): `providerUsed` is nullable and is written ONLY
//     after transport dispatch begins; a failed provider is its own attempt
//     row (status FAILED) and can never be recorded as having "served" the
//     request. Dispatch writes `estimatedGrossUsd` + a pre-call `fundingLabel`
//     only; `reconciledLabel` / `billedUsd` stay null (a later reconciliation
//     PR is the sole writer of confirmed settlement).
//   - execution_status ≠ telemetry_status: `AiInvocation.telemetryStatus` is a
//     separate column so a degraded ledger write never mutates the execution
//     verdict.
// ============================================================

model AiInvocation {
  id              String    @id @default(cuid())
  requestId       String // caller-supplied idempotency handle
  taskClass       String
  surface         String
  entity          String // "GSE" | "GSN" | "XXX" | "PERSONAL"
  dataClass       String // serialized data-policy tag set (comma-joined)
  costMode        String // effective cost mode at execution
  envClass        String // "production" | "preview" | "development" | "test"
  envClassSource  String // "explicit" | "derived" (or "UNRESOLVED" on early blocks)
  policyVersion   String
  actorType       String // "HUMAN" | "SERVICE" | "SYSTEM" (TrustedActor, #159)
  actorSubjectId  String
  status          String // "RUNNING" | "SUCCEEDED" | "FAILED" | "AMBIGUOUS" | "POLICY_BLOCKED" | "BUDGET_BLOCKED" | "BLOCKED"
  telemetryStatus String    @default("OK") // "OK" | "DEGRADED" — separate from status
  createdAt       DateTime  @default(now())
  completedAt     DateTime?

  // ── §9.2 atomic claim / lease fencing ──────────────────────────────────
  requestFingerprint  String // sha256 of the canonicalized request payload
  executionOwnerToken String? // fencing token of the live claim owner (NULL when terminal/BLOCKED)
  leaseExpiresAt      DateTime? // live-claim lease; expired ⇒ eligible for fenced steal
  heartbeatAt         DateTime?
  stealCount          Int       @default(0)

  // ── §9.2 durable terminal result (replay source) ───────────────────────
  resultRef  String? // external result reference, if the payload lives elsewhere
  resultHash String? // sha256 of the canonicalized output
  resultJson Json? // the original validated output, replayed on terminal replay

  // ── §9.6 non-dispatchable blocked decisions ────────────────────────────
  // These fields are durable incident history: a CONFIGURATION_BLOCKED row
  // reclaimed after the config is fixed KEEPS them even once status moves on.
  blockedReasonCode String? // "POLICY_BLOCKED" | "BUDGET_BLOCKED" | "CONFIGURATION_BLOCKED"
  blockedDetail     String?

  attempts     AiAttempt[]
  attribution  AiFinancialAttribution[]
  recovery     AiTelemetryRecovery[]
  reservations AiBudgetReservation[]

  // Same (requestId, taskClass) replays; the unique key is the atomicity
  // anchor of the create-or-claim (INSERT .. ON CONFLICT DO NOTHING).
  @@unique([requestId, taskClass])
  @@index([taskClass, createdAt])
  @@map("ai_invocations")
}

model AiAttempt {
  id                String    @id @default(cuid())
  invocationId      String
  ordinal           Int // 0-based try order; a fallback is always ordinal+1
  providerRequested String // provider we intended to dispatch to
  providerUsed      String? // null until transport actually dispatched (#151)
  providerAccount   String?
  region            String?
  modelRequested    String
  modelResolved     String?
  substitutionId    String? // FK into the approved-substitution registry (PR E)
  providerRequestId String? // vendor-side id for later reconciliation
  status            String // "DISPATCHED" | "SUCCEEDED" | "FAILED" | "TIMEOUT" | "AMBIGUOUS"
  errorCode         String?
  startedAt         DateTime
  endedAt           DateTime?
  inputTokens       Int?
  outputTokens      Int?
  cacheReadTokens   Int?
  cacheWriteTokens  Int?
  pricingVersion    String?

  // ── §9.4 durable pre-dispatch attempt semantics ────────────────────────
  requestFingerprint String // fingerprint recorded BEFORE transport
  policyVersion      String // policy version recorded BEFORE transport
  attemptNonce       String // per-attempt lease/nonce
  resultHash         String? // sha256 of the output this attempt produced

  // RESTRICT: attempt rows are execution evidence; deleting an invocation
  // may never silently erase them (§6.2 doctrine).
  invocation   AiInvocation             @relation(fields: [invocationId], references: [id], onDelete: Restrict)
  attributions AiFinancialAttribution[]

  @@unique([invocationId, ordinal])
  @@index([invocationId])
  @@map("ai_attempts")
}

model AiFinancialAttribution {
  id                    String    @id @default(cuid())
  invocationId          String
  attemptId             String? // real FK into ai_attempts (§9.5)
  estimatedGrossUsd     Decimal   @db.Decimal(12, 6)
  // Pre-call funding intent — NEVER a claim of settlement:
  //   "CASH_EXPECTED" | "CREDIT_ELIGIBLE_UNCONFIRMED"
  //   | "CREDIT_EXPECTED_FROM_ACTIVE_GRANT" | "LOCAL_RESOURCE"
  //   | "EXTERNAL_FREE_ALLOWANCE_UNCONFIRMED" | "BLOCKED"
  fundingLabel          String
  // Post-billing reconciliation ONLY (a later PR writes this; the dispatch
  // writer's create path has no reconciliation fields — §9.5):
  //   "CREDIT_APPLIED_CONFIRMED" | "CASH_CHARGED_CONFIRMED"
  //   | "NO_VENDOR_CHARGE_CONFIRMED" | "UNRECONCILED"
  reconciledLabel       String?
  creditGrantSnapshotId String? // only ever set from a grant snapshot, never inferred from a model id
  billedUsd             Decimal?  @db.Decimal(12, 6)
  reconciledAt          DateTime?

  // §9.5 versioned attribution: exactly ONE current attribution per
  // invocation (partial unique index in the migration SQL) and a full
  // version history under (invocationId, version).
  version   Int     @default(1)
  isCurrent Boolean @default(true)

  // RESTRICT: financial attribution is settlement evidence; no cascade may
  // erase it (§6.2 doctrine).
  invocation AiInvocation @relation(fields: [invocationId], references: [id], onDelete: Restrict)
  attempt    AiAttempt?   @relation(fields: [attemptId], references: [id], onDelete: Restrict)

  @@unique([invocationId, version])
  @@index([invocationId])
  @@map("ai_financial_attributions")
}

// §9.7 minimal durable recovery queue for post-success telemetry: when the
// authoritative finalize cannot land AFTER a successful (paid) provider
// call, the pipeline queues the finalize payload here instead of EVER
// retrying the paid call. Hardened outbox semantics: lease-fenced claim,
// attempt cap, explicit delivered/abandoned terminals — never silent drop.
model AiTelemetryRecovery {
  id             String    @id @default(cuid())
  invocationId   String
  kind           String // "FINALIZE_SUCCESS" | "FINALIZE_AMBIGUOUS" | "FINALIZE_FAILURE" | "ATTEMPT_TELEMETRY"
  payload        Json
  attempts       Int       @default(0)
  maxAttempts    Int       @default(10)
  leaseOwner     String?
  leaseExpiresAt DateTime?
  createdAt      DateTime  @default(now())
  deliveredAt    DateTime?
  abandonedAt    DateTime?

  // RESTRICT: these rows exist precisely to preserve writes that could not
  // land — a cascade would silently drop them with the parent (§6.2 doctrine).
  invocation AiInvocation @relation(fields: [invocationId], references: [id], onDelete: Restrict)

  @@index([deliveredAt, leaseExpiresAt])
  @@index([invocationId])
  @@map("ai_telemetry_recovery")
}

// ============================================================
// AI CONTROL PLANE — atomic budget reservations
// (Phase 2 PR-C, blueprint §C, hardened per directive §10)
//
// Additive, dormant budget primitives. A budget WINDOW is a named cap over
// some scope dimension (request, day, month, surface, provider account,
// entity, emergency override). Every billable AI invocation RESERVES the
// worst case of its ENTIRE attempt plan against every policy-required window
// BEFORE dispatch, then provisionally settles the actual (releasing the held
// remainder), moves to a RECONCILIATION_HOLD on an ambiguous charge, or
// releases the whole hold on a proven-clean failure.
//
// The cap invariant lives in the DATABASE, not the app (§10.2):
//   reservedUsd + provisionalUsd + confirmedBilledUsd <= capUsd
// is enforced BOTH by the engine's single conditional UPDATE (see
// apps/web/lib/ai-control-plane/budget.ts) AND by a table CHECK constraint in
// the additive migration. An over-cap state is representable ONLY together
// with the explicit OVERAGE_LOCKED circuit breaker (a real charge that
// exceeded its hold is preserved, never truncated; the window then refuses
// every further reserve and an owner incident fires).
//
// §10.7: reserved / provisional / confirmed billed / confirmed credit /
// released / disputed are tracked as SEPARATE columns — a worst-case hold is
// never reported as a settled actual.
//
// Enum-like columns are plain String with an inline value list guarded by a
// CHECK constraint in the additive migration — the documented convention of
// OddsLineSnapshot.phase / Watchlist.entityType / the AI ledger tables.
// NOTE: `prisma db push` does not emit CHECK constraints; the PG acceptance
// test applies the migration SQL directly and proves the CHECKs fire.
// ============================================================

model AiBudgetWindow {
  // Deterministic id resolved ONLY from a policy-registry scope template
  // (§10.5), e.g. 'entity:GSE:daily:2026-07-22'. Call sites never compose
  // arbitrary window ids.
  id                 String   @id
  scopeKind          String // "REQUEST" | "DAILY" | "MONTHLY" | "SURFACE" | "PROVIDER_ACCOUNT" | "ENTITY" | "EMERGENCY_OVERRIDE"
  state              String   @default("ACTIVE") // "ACTIVE" | "OVERAGE_LOCKED" (§10.2 circuit breaker)
  capUsd             Decimal  @db.Decimal(12, 6)
  reservedUsd        Decimal  @default(0) @db.Decimal(12, 6) // HELD + RECONCILIATION_HOLD worst-case holds
  provisionalUsd     Decimal  @default(0) @db.Decimal(12, 6) // provisionally settled actuals (pre-reconciliation)
  confirmedBilledUsd Decimal  @default(0) @db.Decimal(12, 6) // reconciled billed actuals
  confirmedCreditUsd Decimal  @default(0) @db.Decimal(12, 6) // reconciled credit-covered spend (not cash)
  releasedUsd        Decimal  @default(0) @db.Decimal(12, 6) // cumulative released/expired holds (audit counter)
  disputedUsd        Decimal  @default(0) @db.Decimal(12, 6) // amounts under RECONCILIATION_HOLD (also still in reservedUsd)
  updatedAt          DateTime @default(now())

  reservations AiBudgetReservation[]

  @@map("ai_budget_windows")
}

model AiBudgetReservation {
  id                 String   @id @default(cuid())
  invocationId       String
  windowId           String
  // §10.6 idempotency key: (invocationId, windowId, reservationVersion) is
  // UNIQUE; a duplicate reserve returns the existing hold, never double-holds.
  reservationVersion Int      @default(1)
  amountUsd          Decimal  @db.Decimal(12, 6) // worst case of the ENTIRE attempt plan (§10.4)
  // §10.1 lifecycle: "HELD" | "PROVISIONALLY_SETTLED" | "RECONCILIATION_HOLD"
  //                | "CONFIRMED_SETTLED" | "RELEASED" | "EXPIRED"
  state              String
  provisionalUsd     Decimal? @db.Decimal(12, 6) // actual applied pre-reconciliation (PROVISIONALLY_SETTLED)
  confirmedUsd       Decimal? @db.Decimal(12, 6) // reconciled amount (CONFIRMED_SETTLED only, CHECK-enforced)
  confirmedKind      String? // "BILLED" | "CREDIT" — required exactly when confirmedUsd is set
  overage            Boolean  @default(false) // §10.2: provisional actual exceeded the hold
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now())
  expiresAt          DateTime // sweeper deadline; the sweeper still verifies authoritative attempt state (§10.1)

  // §10.6: BOTH parent FKs RESTRICT — financial evidence is never silently
  // deleted out from under a hold, including by deleting the window itself.
  window     AiBudgetWindow @relation(fields: [windowId], references: [id], onDelete: Restrict)
  invocation AiInvocation   @relation(fields: [invocationId], references: [id], onDelete: Restrict)

  @@unique([invocationId, windowId, reservationVersion])
  @@index([invocationId])
  @@index([windowId])
  @@index([state, expiresAt])
  @@map("ai_budget_reservations")
}

// ============================================================
// AI CONTROL PLANE — atomic credit-grant authorization
// (Phase 2 PR-D, directive §11.3)
//
// PR-D does NOT own credit-grant snapshots (NOVA/S5 does — see
// apps/web/lib/opportunity-engine/credit-snapshot.ts, the sole canonical
// `CreditGrantSnapshot` contract). These two tables are PR-D's OWN local
// reservation ledger: an additive, dormant hold mechanism that prevents a
// double-spend across concurrent `CreditAuthorizationPort.authorize()` calls
// against the SAME grant, mirroring the AiBudgetWindow/AiBudgetReservation
// pattern above exactly. The ledger's cap is not stored — it is supplied
// fresh on every authorize() call from the admitting snapshot's CURRENT
// spendable balance (remainingMinorUnits - reservedMinorUnits), so this
// table never claims to know NOVA's balance; it only prevents PR-D's own
// concurrent authorizers from over-committing against whatever balance was
// last observed. No cash/credit mode is enabled anywhere; this is dormant
// and additive (mirrors the budget doctrine comment above).
// ============================================================

model CreditGrantReservationLedger {
  // NOVA's CreditGrantSnapshot.grantId — not an FK (the snapshot table is
  // materialized by NOVA/S5, a different persistence unit; PR-D's ledger
  // must not create a hard dependency on S5's schema landing first).
  grantId            String   @id
  reservedMinorUnits BigInt   @default(0)
  updatedAt          DateTime @default(now())

  reservations CreditGrantReservation[]

  @@map("credit_grant_reservation_ledger")
}

model CreditGrantReservation {
  id                String   @id @default(cuid())
  grantId           String
  amountMinorUnits  BigInt // worst-case estimate HELD against the grant
  state             String // "HELD" | "SETTLED" | "RELEASED" | "EXPIRED"
  settledMinorUnits BigInt? // confirmed actual, set only on SETTLED
  createdAt         DateTime @default(now())
  expiresAt         DateTime // auto-release safety net (a future sweep, mirrors budget.ts)

  ledger CreditGrantReservationLedger @relation(fields: [grantId], references: [grantId], onDelete: Cascade)

  @@index([grantId])
  @@index([state, expiresAt])
  @@map("credit_grant_reservations")
}

// ============================================================
// AI CONTROL PLANE — idempotent event ledger + processed_event
// (Exactly-once runtime substrate, 2026-07-22 handoff, Track A)
//
// A generic, append-only record of control-plane outcomes that matter to
// DOWNSTREAM SINKS (Formal Heartbeat receipt export, future side-effect
// workers) — distinct in purpose from `AiInvocation`'s own
// (requestId, taskClass) claim-table idempotency, which governs whether the
// SAME invocation is dispatched twice. This ledger is per-EVENT (an
// invocation can emit several: finalized-success, finalized-failure,
// attempt-failed, ...) and exists so a PULL-based consumer reading the
// ledger can process each event AT MOST ONCE per sink, via
// `processed_event`, regardless of how many times the consumer's own run is
// retried/replayed.
//
// `eventId` is a deterministic string derived from the source row's own
// permanent identity + event type (e.g. `${invocationId}:FINALIZED_SUCCESS`)
// — never a random UUID, never wall-clock-derived. Writes happen in the
// SAME SQL statement as the authoritative state transition they record: see
// control-store.ts's finalizeSuccess / finalizeFailure / recordAttemptFailure,
// each of which folds an `INSERT ... ON CONFLICT ("eventId") DO NOTHING`
// ledger CTE into its existing fenced-update CTE, gated so the ledger row is
// written if and only if the real state transition actually applied. A
// retried call whose fencing no longer matches (already-terminal
// invocation, already-owner-fenced-out) writes neither the state change nor
// the ledger row — so double delivery of the same logical call is safe by
// construction, not by best-effort convention.
model ControlEventLedger {
  // Deterministic, caller-derived id — see the same-statement CTE writes in
  // control-store.ts's finalizeSuccess / finalizeFailure /
  // recordAttemptFailure. Never wall-clock, never a random UUID generated
  // by the writer.
  eventId   String   @id
  // Monotonic insertion-order tiebreaker for same-millisecond createdAt rows.
  // Per-invocation events are inserted by separate sequential statements, so a
  // larger seq means inserted-later (causal order). readRecentEvents orders by
  // (createdAt, seq) so the order-sensitive SRQC projection never observes a
  // FINALIZED_SUCCESS before its own ATTEMPT_STARTED on a createdAt tie.
  seq       BigInt   @unique @default(autoincrement())
  source    String // "ai_invocation" | "ai_attempt" | "credit" | "formal_heartbeat" | ...
  sourceId  String // invocationId / attemptId / window key / etc.
  eventType String
  payload   Json
  createdAt DateTime @default(now())

  processed ProcessedEvent[]

  @@index([source, sourceId])
  @@index([createdAt])
  @@map("control_event_ledger")
}

// One (event, sink) pair a consumer has finished acting on. Presence alone
// is the idempotency gate — no other column is read for that check.
model ProcessedEvent {
  eventId String
  sink    String // "formal_heartbeat" | "safety_ledger" | "receipt_export" | ...
  at      DateTime @default(now())

  event ControlEventLedger @relation(fields: [eventId], references: [eventId], onDelete: Restrict)

  @@id([eventId, sink])
  @@map("processed_event")
}

// ============================================================
// VERSIONED ENVELOPE — FormalIncident + SrqcVersion
// (Exactly-once runtime substrate, 2026-07-22 handoff, on top of Track A +
// Track B, same branch by owner authorization.)
//
// FormalIncident is the DURABLE row-store for an abstract CTI the Track B
// detection pass witnessed — a state the Formal Foundry's proofs say is
// unreachable (pendingCountClass GE2, or a rejected fingerprint with no
// bound id). It is written AT MOST ONCE per witness event, reusing Track B's
// EXISTING exactly-once gate: the insert is co-located with the
// `processed_event` mark on sink "formal_receipt_violation", so a re-run of
// the job over the same window never writes a second incident. This is still
// DETECTION-ONLY: `admitUnderSRQC` (srqc-projection.ts) remains always-ADMIT
// and nothing here gates a control-plane decision.
//
// SrqcVersion is the human-activated certificate-version register. A row is
// minted as "candidate", promoted to "active" ONLY by an explicit admin
// script (scripts/activate-srqc-version.mjs) — never by CI/cron — and an
// incident stamps the active version (if any) so a later reader can tell
// which certificate generation was live when the incident was recorded.
model FormalIncident {
  id            String    @id @default(cuid())
  violationKind String // "GE2_PENDING" | "REJECTED_FP_UNBOUND"
  abstractState Json
  eventIds      Json // the witnessEventId(s) this incident is gated on
  srqcVersion   Int? // soft int reference to SrqcVersion.version — NOT a hard FK
  status        String    @default("open") // "open" | "acknowledged" | "closed" — OPS-QUEUE state (is anyone still looking at this), NOT a correctness judgment
  createdAt     DateTime  @default(now())
  // W6 — human review label, orthogonal to `status`. `status` answers "is
  // anyone still looking at this"; `reviewOutcome` answers "was the
  // abstract-state violation this row witnessed a real problem or a
  // projection/modeling artifact" — the correctness label the ablation
  // counters (ablation-counters.ts) aggregate over. Deliberately separate
  // columns: conflating them (e.g. treating "closed" as false-positive)
  // would silently mislabel every incident closed for reasons other than
  // "not real" (fixed-and-resolved, stale, duplicate-of-another-incident).
  reviewOutcome String? // null (unreviewed) | "true_positive" | "false_positive"
  reviewedAt    DateTime?
  reviewedBy    String? // operator identifier (email or admin user id), free text

  @@index([status, createdAt])
  @@index([reviewOutcome])
  @@map("formal_incident")
}

model SrqcVersion {
  version               Int       @id
  indInvHash            String
  refinementReceiptHash String?
  status                String // "candidate" | "active" | "superseded"
  activatedAt           DateTime?
  notes                 String?

  @@map("srqc_version")
}

// ============================================================
// W1 — SHADOW METRICS (continuous operating evidence, on top of the
// versioned envelope; Wave 1 Foundation item, owner-authorized.)
//
// One row per Track B (formal-receipt-job.ts) detection pass, WHETHER OR NOT
// that pass witnessed a violation. Where FormalIncident is written only on a
// newly-witnessed CTI, SrqcShadowMetric is written on EVERY
// runFormalReceiptPass invocation — the base-rate counterpart to the
// violation log, not a replacement for it.
//
// PURE OBSERVATION: no field here is read by admitUnderSRQC or any other
// admission/control-plane decision; the row is written strictly AFTER the
// pass has already computed its (unaffected) SHADOW-mode admission result.
// Deleting this table changes no runtime behavior.
model SrqcShadowMetric {
  id               String   @id @default(cuid())
  windowSince      DateTime // sinceInclusive of the pass this row summarizes
  windowUntil      DateTime // untilExclusive of the pass this row summarizes
  eventsSeen       Int // total control_event_ledger rows read in the window
  ge2Count         Int // # projected invocations with pendingCountClass === "GE2"
  rejectedUnbound  Int // # projected invocations with hasRejectedFp && !fingerprintBound
  admitWouldRefuse Int // # projected invocations that would REFUSE under ENFORCE-mode isViolation() — computed in SHADOW, never gates admission
  srqcVersion      Int? // soft int reference to SrqcVersion.version active at pass time — NOT a hard FK, same convention as FormalIncident.srqcVersion
  createdAt        DateTime @default(now())

  @@index([windowSince])
  @@map("srqc_shadow_metric")
}

// ============================================================
// CTI-CANDIDATE MINER (M6 — online CTI-candidate miner, detection-only,
// self-refinement input; on top of Track A + Track B + the versioned
// envelope, same branch by owner authorization.)
//
// A CtiCandidate is a proof-relevant abstract state that sits EXACTLY ONE
// modeled abstract step away from a state the Formal Foundry's inductive
// invariant forbids (pendingCountClass GE2, or a rejected fingerprint with no
// bound id — see isIndInvViolation in cti-miner.ts). The miner projects real
// ledger windows via srqc-projection.ts's pure projectWindow, then for each
// projected, NON-violating state s applies the pure abstract-successor
// relation (mirroring AbstractClaimExposure.tla's Next) and records any
// one-step successor that DOES violate. `before` is s, `action` is the modeled
// abstract action, `after` is the forbidden successor.
//
// POSTURE (do not let this drift): DETECTION / MINING ONLY. These rows are
// candidate counterexamples surfaced for a HUMAN or LLM to consider during
// weakest-precondition strengthening of the formal spec — they are NOT
// consumed by any control-plane decision, and the miner NEVER edits any .tla
// file or enforces anything. `admitUnderSRQC` (srqc-projection.ts) remains
// always-ADMIT. Dedup is via a deterministic id (hash of before+action+after)
// inserted `ON CONFLICT (id) DO NOTHING`, so re-running the miner over the
// same or overlapping windows never writes a duplicate.
model CtiCandidate {
  id        String   @id @default(cuid())
  before    Json // the projected abstract state one step from a forbidden state
  action    String // the modeled abstract action taken (StartPending | ...)
  after     Json // the forbidden successor state (isIndInvViolation === true)
  status    String   @default("open") // "open" | "reviewed" | "dismissed"
  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@map("cti_candidate")
}

// ============================================================
// LSRQC KERNEL v1 (closed on-policy self-refinement loop; on top of the
// CTI-candidate miner + the versioned SrqcVersion envelope, same branch by
// owner authorization.)
//
// An IndInvProposal is a HINDSIGHT SKILL minted ON-POLICY from one or more
// open CtiCandidate rows: a proposed STRENGTHENING of the currently-active
// inductive-invariant certificate (SrqcVersion) that would additionally
// forbid the abstract (before, action) pair whose successor a CtiCandidate
// showed is proof-forbidden. A proposal is minted only against a live
// baseline (`activeVersionAtMint` records which one), never in a vacuum —
// it is a strengthening of the CURRENT certificate.
//
// POSTURE (do not let this drift): PROPOSAL / RANKING INPUT ONLY. Minting a
// proposal changes NO control-plane decision and NEVER activates a version.
// The ONLY path that flips an SrqcVersion to active is the explicit
// human/script accept flow (acceptProposalAndActivate → activateSrqcVersion).
// `admitUnderSRQC` (srqc-projection.ts) remains always-ADMIT in SHADOW (its
// default); no ENFORCE path is reachable from production. Idempotency is via
// a UNIQUE (sourceWindowHash, activeVersionAtMint) index + INSERT ... ON
// CONFLICT DO NOTHING, so re-running the emitter mints no duplicate proposal.
model IndInvProposal {
  id                    String   @id @default(cuid())
  ctiCandidateIds       String[] // cti_candidate.id values this proposal was minted from
  predicateKeys         String[] // executable keys, e.g. ["GE2_FORBIDDEN","REJECTED_IMPLIES_BOUND","STRENGTHEN_GENERIC"]
  proposedPredicateText String
  skillKind             String // "workflow" | "failure_avoidance" | "strengthen"
  sourceWindowHash      String
  activeVersionAtMint   Int
  strength              Float    @default(0) // Σ max(0, per-window delta) — RANKING signal only
  support               Int      @default(0) // # windows with delta>0 (Prop2 multi-window guard)
  variance              Float    @default(0) // population variance of per-window deltas
  status                String   @default("open") // open|accepted|rejected
  acceptedSrqcVersion   Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([sourceWindowHash, activeVersionAtMint])
  @@index([status])
  @@index([activeVersionAtMint])
  @@map("ind_inv_proposal")
}

// ============================================================
// A++ GOVERNED RECEIPTS + KEYRING (packages/governed)
//
// Durable persistence for signed GovernedReceipt objects emitted by
// `createGoverned()` (packages/governed/src/governed.ts). `raw` holds the
// full SignedGovernedReceipt JSON (receipt + ed25519 signature) exactly as
// produced — it contains no secrets by construction (no private key
// material, no raw tool args, only `argsDigest`). The scalar columns
// (decision, kid, at, agentId, tool, argsDigest, reasons) are denormalized
// out of `raw` purely for query/filter convenience; `raw` remains the
// source of truth for what was actually signed.
model AgentReceipt {
  id         String   @id @default(cuid())
  raw        Json
  decision   String // "ADMIT" | "REFUSE"
  kid        String
  at         DateTime
  agentId    String
  tool       String
  argsDigest String
  reasons    Json
  receiptId  String   @unique
  createdAt  DateTime @default(now())

  @@index([agentId, at])
  @@index([tool, at])
  @@map("agent_receipt")
}

// ============================================================
// COMMERCIAL OPERATING LAYER — Cash OS (R1)
// (Additive, business-instrumentation only — unrelated to the SRQC/formal
// work above. See apps/web/lib/growth/cash-os.ts.)
// ============================================================

// One append-only row per revenue-relevant event (subscription lifecycle,
// affiliate payout, or a paid pilot invoice). This is the source of truth
// for MRR and the other CashSnapshot figures — never derived from
// Subscription state alone, so historical MRR trend stays intact even as
// subscriptions change tier/cancel.
model RevenueEvent {
  id          String   @id @default(cuid())
  at          DateTime @default(now())
  kind        String // sub_start | sub_renew | sub_cancel | affiliate_cpa | affiliate_revshare | pilot_invoice
  amountCents Int
  currency    String   @default("usd")
  userId      String?
  meta        Json?

  @@index([at, kind])
  @@map("revenue_event")
}

// Daily, per-surface activation counter for a user (board / optimizer /
// tracker / receipt). Upserted by recordActivation — one row per
// (userId, day, surface), incrementing count on repeat visits the same day.
model ProductActivation {
  id      String   @id @default(cuid())
  userId  String
  day     DateTime // date truncated UTC (midnight)
  surface String // board | optimizer | tracker | receipt
  count   Int      @default(1)

  @@unique([userId, day, surface])
  @@map("product_activation")
}

// ─── Compliance Control Monitor (CCM) + ISMS alignment kit ──────────────────
// Additive, independent of SRQC/admitUnderSRQC and of packages/governed.
// These tables back @sports/compliance's continuous control checks: each run
// persists evidence objects (ComplianceEvidence), the aggregated pass/fail
// outcome (ComplianceCheckRun), and — one per failing control — an
// exception to track to closure (ComplianceException). Internal alignment
// tooling only; see docs/compliance/README.md for the non-claims disclaimer.
model ComplianceEvidence {
  id          String   @id @default(cuid())
  controlId   String
  source      String
  collectedAt DateTime @default(now())
  contentHash String
  uri         String?
  meta        Json?

  @@index([controlId, collectedAt])
  @@map("compliance_evidence")
}

model ComplianceCheckRun {
  id      String   @id @default(cuid())
  at      DateTime @default(now())
  ok      Boolean
  results Json

  @@map("compliance_check_run")
}

model ComplianceException {
  id        String    @id @default(cuid())
  controlId String
  detail    String
  status    String    @default("open")
  createdAt DateTime  @default(now())
  closedAt  DateTime?

  @@index([status, controlId])
  @@map("compliance_exception")
}

// ============================================================
// ENTITY GRAPH (ADR 005 — additive, not yet read by any surface)
// Canonical reference for named things + typed, provenanced relations.
// Doctrine: docs/brain/entity-graph.md
// ============================================================

enum EntityType {
  player
  team
  coach
  coordinator
  league
  season
  game
  venue
  injury
  practice_report
  transaction
  article
  reporter
  source
  rumor_cluster
  market
  sportsbook
  line
  prop
  model_output
  pick
  settlement
  public_claim
  fantasy_league
  fantasy_team
  fantasy_roster
  fantasy_player
  fantasy_matchup
  fantasy_recommendation
}

model Entity {
  id              String     @id @default(cuid())
  entity_type     EntityType
  canonical_name  String
  /// Lowercased, punctuation-stripped resolution key ("A.J. Brown" -> "aj brown").
  normalized_name String
  /// "" means not sport-scoped (reporter, article, source). NOT nullable on
  /// purpose: Postgres treats NULLs as distinct in a UNIQUE index, so a nullable
  /// column here would silently permit duplicate canonical rows and defeat the
  /// resolution invariant below.
  sport           String     @default("")
  /// Cross-source identity: { nflverse: "...", espn: "...", oddsApi: "..." }.
  external_ids    Json?
  /// Provenance tier per docs/brain/source-hierarchy.md (1 = most trusted).
  source_tier     Int
  /// Type-specific fields from the entity-graph doctrine tables.
  attributes      Json?
  first_seen_at   DateTime   @default(now())
  last_seen_at    DateTime   @updatedAt

  outgoing_edges EntityEdge[] @relation("EntityEdgeFrom")
  incoming_edges EntityEdge[] @relation("EntityEdgeTo")

  /// Resolution invariant: one canonical row per (type, normalized name, sport).
  @@unique([entity_type, normalized_name, sport], map: "entities_type_name_sport_key")
  @@index([entity_type])
  @@index([sport])
  @@index([last_seen_at])
  @@map("entities")
}

model EntityEdge {
  id             String    @id @default(cuid())
  from_entity_id String
  to_entity_id   String
  /// belongs_to | plays | has | mentions | references | employs | plays_at ...
  /// String rather than enum: the doctrine's relation list is still growing.
  relation       String
  /// Provenance is mandatory — an unsourced relationship is a fabricated one.
  source_tier    Int
  source_ref     String?
  observed_at    DateTime
  /// Temporal validity, so a trade does not delete history.
  valid_from     DateTime?
  valid_to       DateTime?
  confidence     Int       @default(50)
  metadata       Json?
  created_at     DateTime  @default(now())

  from_entity Entity @relation("EntityEdgeFrom", fields: [from_entity_id], references: [id], onDelete: Cascade)
  to_entity   Entity @relation("EntityEdgeTo", fields: [to_entity_id], references: [id], onDelete: Cascade)

  /// Re-ingesting the same observation is idempotent.
  @@unique([from_entity_id, relation, to_entity_id, observed_at], map: "entity_edges_unique_observation")
  @@index([from_entity_id, relation])
  @@index([to_entity_id, relation])
  @@index([observed_at])
  @@map("entity_edges")
}
