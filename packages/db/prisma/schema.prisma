// ============================================================
// AGENT COUNCIL LEDGERS (spec §8–9)
//
// AgentHandoff — every seat-to-seat handoff is logged here.
// SubagentRun  — every subagent run is logged as a draft until
//                the parent seat reviews it (pending_review → accepted/rejected/edited).
//
// JarvisMemoryEvent gains an optional link to SubagentRun so
// memory candidates created during a subagent run carry their
// provenance.
//
// snake_case @@map names per convention.
// ============================================================

enum AgentHandoffStatus {
  pending
  accepted
  rejected
  escalated
}

enum AgentHandoffRiskLevel {
  low
  medium
  high
  critical
}

enum SubagentParentReviewStatus {
  pending_review
  accepted
  rejected
  edited
}

model AgentHandoff {
  id                     String                @id @default(cuid())
  /// Codename of the council seat initiating the handoff.
  source_seat            String
  /// Codename of the council seat receiving the handoff.
  target_seat            String
  /// Human-readable reason for the handoff.
  reason                 String                @db.Text
  /// Task type from the routing rules (e.g. "pick-research", "settlement").
  task_type              String
  /// Supporting evidence text (urls, data references, test ids).
  evidence_text          String                @db.Text
  risk_level             AgentHandoffRiskLevel @default(low)
  /// Authority tier of the initiating seat (0–4).
  authority_tier         Int
  status                 AgentHandoffStatus    @default(pending)
  /// Whether this handoff requires explicit owner approval before proceeding.
  owner_approval_required Boolean             @default(false)
  /// Outcome narrative once the handoff is resolved — null until then.
  outcome                String?               @db.Text
  created_at             DateTime              @default(now())
  updated_at             DateTime              @updatedAt

  @@index([source_seat, created_at])
  @@index([target_seat, created_at])
  @@index([status])
  @@index([created_at])
  @@map("agent_handoffs")
}

model SubagentRun {
  id                       String                     @id @default(cuid())
  /// Id of the subagent template that ran (matches SubagentTemplate.id).
  subagent_id              String
  /// Codename of the parent council seat that spawned this subagent.
  parent_seat              String
  /// Narrow task the subagent was given.
  task                     String                     @db.Text
  /// Context provided as input to the subagent.
  input_context            String                     @db.Text
  /// Reference to the draft artifact the subagent produced (path, id, or url).
  output_artifact_ref      String                     @db.Text
  /// Confidence score 0–100 in the output.
  confidence               Int
  /// Explicit uncertainty statement about the output.
  uncertainty              String                     @db.Text
  /// Supporting evidence for the output.
  evidence                 String[]
  /// True = prohibited-actions check passed; false = violation detected.
  prohibited_actions_checked Boolean                  @default(false)
  /// Parent seat's review status — pending until parent explicitly reviews.
  parent_review_status     SubagentParentReviewStatus @default(pending_review)
  created_at               DateTime                   @default(now())
  updated_at               DateTime                   @updatedAt

  /// Memory events linked to this run (optional, created by linkMemoryToAgentRun).
  memory_events JarvisMemoryEvent[] @relation("MemoryAgentRunLink")

  @@index([subagent_id, created_at])
  @@index([parent_seat, created_at])
  @@index([parent_review_status])
  @@index([created_at])
  @@map("subagent_runs")
}

// ============================================================
// OPERATOR COCKPIT (Phase 2B)
//
// Internal-only models. Power the Jarvis-style operator surface
// that routes sports-research, content drafts, support reviews,
// and engineering tasks through an explicit task queue with an
// allow-listed status machine and an append-only decision log.
//
// Safety rules baked into the data model:
//   - CockpitTask.status transitions are validated in the
//     transitions service (apps/web/lib/cockpit/transitions.ts).
//     The schema permits any string value; the service refuses
//     anything outside the allow-list and writes a CockpitDecision
//     row for every successful transition.
//   - CockpitMediaItem.scheduledFor is metadata only. There is
//     no worker that reads it. Publishing remains out of scope.
//   - No direct relation to NextAuth User. The reviewer field on
//     CockpitDecision is a free-text identifier ("manual:garrett",
//     "system", "agent:tal") so seed data and worker-attributed
//     decisions work without requiring a User row.
// ============================================================

enum OperatorAgent {
  JARVIS   // orchestration / dashboard / next-actions
  SARAH    // support / review queue
  TAL      // engineering / repo / bug tasks
  SCOUT    // sports research, line movement, news intake
  AVA      // sports content / media workflow
  BOBBY    // funnel / subscription / analytics insights
}

enum CockpitTaskStatus {
  NEW
  ROUTED
  DRAFTED
  NEEDS_REVIEW
  APPROVED
  REJECTED
  BLOCKED
  ARCHIVED
}

enum CockpitRiskLevel {
  LOW
  MODERATE
  HIGH
  COMPLIANCE_HOLD
}

enum CockpitComplianceStatus {
  NOT_APPLICABLE
  CLEAR
  REVIEW_REQUIRED
  HOLD
  REJECTED
}

model CockpitTask {
  id               String                  @id @default(cuid())
  title            String
  description      String                  @db.Text
  assignedAgent    OperatorAgent
  status           CockpitTaskStatus       @default(NEW)
  priority         Int                     @default(50)
  riskLevel        CockpitRiskLevel        @default(LOW)
  complianceStatus CockpitComplianceStatus @default(NOT_APPLICABLE)
  source           String
  payload          Json?
  decisionNotes    String?                 @db.Text
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  decisions        CockpitDecision[]

  @@index([assignedAgent])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@map("cockpit_tasks")
}

model CockpitDecision {
  id        String            @id @default(cuid())
  taskId    String
  toStatus  CockpitTaskStatus
  reviewer  String
  note      String?           @db.Text
  evidence  Json?
  createdAt DateTime          @default(now())

  task      CockpitTask       @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("cockpit_decisions")
}

model CockpitMediaItem {
  id               String                  @id @default(cuid())
  briefTitle       String
  briefBody        String                  @db.Text
  channel          String
  draftBody        String?                 @db.Text
  qaStatus         String                  @default("DRAFT")
  complianceStatus CockpitComplianceStatus @default(REVIEW_REQUIRED)
  approved         Boolean                 @default(false)
  scheduledFor     DateTime?
  relatedTaskId    String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([qaStatus])
  @@index([complianceStatus])
  @@map("cockpit_media_items")
}

enum CreatorAssetKind {
  FAN_EXPLAINER
