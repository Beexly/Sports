// Sports Prediction Platform — Prisma Schema
// Generated: 2026-04-07

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// AUTH (NextAuth.js compatible)
// ============================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  subscription  Subscription?
  alerts        Alert[]

  @@index([email])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================
// SUBSCRIPTIONS
// ============================================================

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  stripeCustomerId     String             @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  tier                 SubscriptionTier   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  canceledAt           DateTime?
  trialStart           DateTime?
  trialEnd             DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  webhookEvents    WebhookEvent[]

  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@map("subscriptions")
}

model WebhookEvent {
  id             String   @id @default(cuid())
  stripeEventId  String   @unique
  type           String
  subscriptionId String?
  payload        Json
  processedAt    DateTime @default(now())

  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([stripeEventId])
  @@map("webhook_events")
}

// ============================================================
// SPORTS / LEAGUES / TEAMS
// ============================================================

model Sport {
  id          String   @id @default(cuid())
  key         String   @unique  // e.g. "americanfootball_nfl"
  name        String             // e.g. "NFL"
  displayName String             // e.g. "National Football League"
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  leagues League[]
  games   Game[]

  @@map("sports")
}

model League {
  id          String   @id @default(cuid())
  sportId     String
  key         String   @unique
  name        String
  displayName String
  country     String?
  season      String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  sport   Sport    @relation(fields: [sportId], references: [id])
  games   Game[]
  teams   Team[]

  @@index([sportId])
  @@map("leagues")
}

model Team {
  id           String   @id @default(cuid())
  leagueId     String?
  name         String
  abbreviation String?
  city         String?
  logoUrl      String?
  createdAt    DateTime @default(now())

  league     League? @relation(fields: [leagueId], references: [id])
  homeGames  Game[]  @relation("HomeTeam")
  awayGames  Game[]  @relation("AwayTeam")

  @@index([leagueId])
  @@index([name])
  @@map("teams")
}

// ============================================================
// GAMES AND ODDS
// ============================================================

model Game {
  id             String     @id @default(cuid())
  externalId     String     @unique  // ID from The Odds API
  sportId        String
  leagueId       String?
  homeTeamId     String?
  awayTeamId     String?
  homeTeamName   String               // denormalized for speed
  awayTeamName   String
  commenceTime   DateTime
  status         GameStatus @default(SCHEDULED)
  homeScore      Int?
  awayScore      Int?
  resultFetched  Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // ── Scheduling / fatigue context (computed from game history) ──
  restDaysHome        Int?     // calendar days since home team's prior game
  restDaysAway        Int?     // calendar days since away team's prior game
  isBackToBackHome    Boolean  @default(false)
  isBackToBackAway    Boolean  @default(false)
  scheduleDensityHome Int?     // canonical games in last 7 days (home team)
  scheduleDensityAway Int?     // canonical games in last 7 days (away team)

  // ── Line movement (populated on repeat ingestion) ──
  openingSpread       Float?   // spread at first ingestion
  openingTotal        Float?   // total at first ingestion
  lineMovementSpread  Float?   // current avg spread − opening (negative = home favored more)
  lineMovementTotal   Float?   // current avg total − opening

  // ── Data quality ──
  bookmakerCoverageMax Int      @default(0)  // highest bookmaker count seen for this game
  dataQualityScore     Float    @default(0)  // 0–100 composite at last computation
  contextComputedAt    DateTime?              // when scheduling context was last computed

  sport    Sport   @relation(fields: [sportId], references: [id])
  league   League? @relation(fields: [leagueId], references: [id])
  homeTeam Team?   @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam Team?   @relation("AwayTeam", fields: [awayTeamId], references: [id])
  odds                Odds[]
  picks               Pick[]
  openingLines        OpeningLine[]
  teamGameLogs        TeamGameLog[]
  gameSignals         GameSignal[]
  pickSignalSnapshots PickSignalSnapshot[]

  @@index([sportId])
  @@index([commenceTime])
  @@index([status])
  @@map("games")
}

// Stores the first-seen odds snapshot per game+market for line movement tracking
model OpeningLine {
  id          String     @id @default(cuid())
  gameId      String
  market      OddsMarket
  spread      Float?     // opening spread (home perspective)
  total       Float?     // opening total
  homePrice   Float?     // opening moneyline home
  awayPrice   Float?     // opening moneyline away
  firstSeenAt DateTime   @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, market])
  @@index([gameId])
  @@map("opening_lines")
}

// Stores each team's game log for form computation (populated when games settle)
model TeamGameLog {
  id            String         @id @default(cuid())
  teamName      String         // denormalized team identifier (homeTeamName / awayTeamName)
  sport         String
  gameId        String
  opponentName  String
  isHome        Boolean
  gameDate      DateTime       // commenceTime of the game
  teamScore     Int?
  opponentScore Int?
  result        GameLogResult  @default(TBD)
  // ATS tracking
  spread        Float?         // spread from team perspective (negative = team was favored)
  atsResult     AtsResult      @default(TBD)  // did team cover?
  createdAt     DateTime       @default(now())

  // Bootstrap safety — true for all logs written before CANONICAL_HISTORY_ENABLED=true.
  // Bootstrap logs are stored for reference but excluded from ATS/H2H scoring.
  // Set to false only when canonical history mode is explicitly active at write time.
  isBootstrap   Boolean        @default(true)

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, teamName])
  @@index([teamName, sport, gameDate])
  @@index([gameId])
  @@map("team_game_logs")
}

model Odds {
  id              String      @id @default(cuid())
  gameId          String
  ingestionRunId  String
  bookmaker       String
  market          OddsMarket
  homePrice       Float?
  awayPrice       Float?
  drawPrice       Float?
  spread          Float?
  homeSpreadPrice Float?
  awaySpreadPrice Float?
  total           Float?
  overPrice       Float?
  underPrice      Float?
  fetchedAt       DateTime
  createdAt       DateTime    @default(now())

  game         Game         @relation(fields: [gameId], references: [id])
  ingestionRun IngestionRun @relation(fields: [ingestionRunId], references: [id])

  @@index([gameId])
  @@index([ingestionRunId])
  @@index([fetchedAt])
  @@map("odds")
}

// ============================================================
// INGESTION
// ============================================================

model IngestionRun {
  id            String            @id @default(cuid())
  sport         String?
  status        IngestionStatus   @default(RUNNING)
  gamesUpserted Int               @default(0)
  oddsInserted  Int               @default(0)
  errorMessage  String?
  startedAt     DateTime          @default(now())
  completedAt   DateTime?

  odds            Odds[]
  sourceSnapshots SourceSnapshot[]

  @@index([status])
  @@index([startedAt])
  @@map("ingestion_runs")
}

// ============================================================
// PICKS
// ============================================================

model Pick {
  id             String    @id @default(cuid())
  gameId         String
  ingestionRunId String?

  // Core pick fields
  pickType       PickType
  selection      String    // e.g. "Chiefs -3.5" or "OVER 48.5"
  line           Float

  // Scoring precision fields
  confidence     Int       // 0–100 overall score
  edgeScore      Float     @default(0)  // net bookmaker edge (0–100)
  consensusPct   Float     @default(0)  // bookmaker consensus 0.0–1.0
  bookmakerCount Int       @default(0)  // number of sources used

  // Classification
  tier           PickTier   @default(FREE)
  pickGrade      PickGrade  @default(LEAN)    // A+/A/B/C label
  riskLevel      RiskLevel  @default(MODERATE) // volatility classification

  // Explainability
  reasoning         String @db.Text          // short plain-English summary
  reasoningShort    String @default("")       // 1-sentence teaser (free users)
  factorBreakdown   Json?                     // structured scoring factors

  // Metadata
  modelVersion   String
  generatedAt    DateTime   @default(now())
  dataFreshnessAt DateTime? // when the underlying odds data was fetched

  // Outcome
  result         PickResult @default(PENDING)
  settledAt      DateTime?
  isPublished    Boolean    @default(true)
  isFeatured     Boolean    @default(false)

  // Bootstrap safety — true for all picks written before CANONICAL_HISTORY_ENABLED=true.
  // Bootstrap picks are stored for admin review and settlement but excluded from
  // canonical performance metrics and public performance stats.
  isBootstrap    Boolean    @default(true)

  game           Game @relation(fields: [gameId], references: [id])
  signalSnapshot PickSignalSnapshot?
  lossAutopsy    LossAutopsy?

  // One active pick per game per pick type — enforced at DB level to prevent
  // duplicate inserts from concurrent worker runs (TOCTOU race prevention).
  @@unique([gameId, pickType])
  @@index([tier])
  @@index([pickGrade])
  @@index([generatedAt])
  @@index([result])
  @@index([isFeatured])
  @@map("picks")
}

model LossAutopsy {
  id             String            @id @default(cuid())
  pickId         String            @unique
  pick           Pick              @relation(fields: [pickId], references: [id])

  authorEmail    String
  authoredAt     DateTime          @default(now())
  status         LossAutopsyStatus @default(DRAFT)

  headline       String            @db.VarChar(140)
  whatWeSaw      String            @db.Text
  whatHappened   String            @db.Text
  whatWeLearned  String            @db.Text

  rootCause      LossRootCause
  lessonTags     String[]
  modelVersion   String?
  isPublic       Boolean           @default(false)

  evidenceRefs   Json?

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([authoredAt])
  @@index([status])
  @@index([rootCause])
  @@map("loss_autopsies")
}

enum LossAutopsyStatus {
  DRAFT
  PEER_REVIEW
  PUBLISHED
  RETRACTED
}

enum LossRootCause {
  DATA_GAP
  STALE_LINE
  INJURY_SHOCK
  WEATHER
  OFFICIATING
  VARIANCE
  MODEL_DRIFT
  HUMAN_OVERRIDE
  OTHER
}

// ============================================================
// SIGNAL ARCHITECTURE
// ============================================================

// SourceSnapshot stores the raw provider response before any normalization.
// This is the forensic root for the Evidence Engine: every derived signal
// should be traceable to a payload that existed at ingestion time.
model SourceSnapshot {
  id             String             @id @default(cuid())
  provider       String
  sourceKind     SourceSnapshotKind
  sport          String?
  externalId     String?
  ingestionRunId String?
  fetchedAt      DateTime
  payload         Json
  payloadHash    String
  payloadBytes   Int                @default(0)
  createdAt      DateTime           @default(now())

  ingestionRun IngestionRun? @relation(fields: [ingestionRunId], references: [id], onDelete: SetNull)

  @@index([provider, sourceKind])
  @@index([sport])
  @@index([externalId])
  @@index([fetchedAt])
  @@index([payloadHash])
  @@map("source_snapshots")
}

// GameSignal — source-aware signal store for any external or derived input.
// Every signal carries: source identity, category, trust level, freshness,
// and bootstrap provenance. This enables future multi-source intelligence
// without schema sprawl and makes source trust explicit and queryable.
// Current signals: SCHEDULE density (from TeamGameLog).
// Future: WEATHER, INJURIES, RATINGS, MARKET_SENTIMENT.
// @@unique([gameId, sourceName, signalKey]) — one current value per (source, signal) per game.
model GameSignal {
  id             String        @id @default(cuid())
  gameId         String
  sourceCategory SignalCategory
  sourceName     String        // provider key e.g. "schedule-internal", "openweather"
  signalKey      String        // e.g. "schedule_density_7d_home", "wind_mph"
  signalValue    Json          // number | string | object — flexible for all signal types
  fetchedAt      DateTime
  expiresAt      DateTime?     // null = valid until game commences
  trustLevel     Float         @default(1.0)   // 0.0–1.0: source reliability weight
  isBootstrap    Boolean       @default(true)
  createdAt      DateTime      @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, sourceName, signalKey])
  @@index([gameId, sourceCategory])
  @@index([fetchedAt])
  @@map("game_signals")
}

// PickSignalSnapshot — immutable record of which signals were active when a pick was scored.
// Foundation for outcome-anchored learning and calibration.
// Created ONCE at pick time (update is always empty).
// settlementResult/settledAt filled when pick settles.
// eligibleForLearning set only when: canLearnFromOutcomes=true, isBootstrap=false, settled.
model PickSignalSnapshot {
  id         String   @id @default(cuid())
  pickId     String   @unique
  gameId     String
  capturedAt DateTime @default(now())

  // Active signal categories at prediction time (all boolean flags)
  hadOddsSignal         Boolean @default(false)  // always true — primary input
  hadLineMovementSignal Boolean @default(false)  // opening line existed
  hadRestSignal         Boolean @default(false)  // restDays or B2B data present
  hadScheduleSignal     Boolean @default(false)  // scheduleDensity data present
  hadAtsFormSignal      Boolean @default(false)  // canonical ATS form used
  hadH2HSignal          Boolean @default(false)  // canonical H2H form used
  hadVenueSignal        Boolean @default(false)  // venue-specific ATS form used
  hadWeatherSignal      Boolean @default(false)  // weather data present (future)
  hadInjurySignal       Boolean @default(false)  // injury data present (future)
  hadRatingsSignal      Boolean @default(false)  // team ratings present (future)
  hadPlayerSignal       Boolean @default(false)  // player availability/lineup data present (future)
  hadOfficialsSignal    Boolean @default(false)  // referee/umpire data present (future)
  hadVenueEnvironmentSignal Boolean @default(false) // venue/park/dome/weather context present (future)
  hadPaceSignal         Boolean @default(false)  // pace/team-rate context present (future)
  hadMilestoneSignal    Boolean @default(false)  // team/player milestone context present (future)

  // Key quantitative values at prediction time (queryable for calibration regression)
  bookmakerCount         Int    @default(0)
  dataQualityScore       Float  @default(0)
  confidenceAtPrediction Int    @default(0)  // raw confidence at creation — immutable
  lineMovementDelta      Float?              // current_spread − opening_spread at pick time
  restAdvantageNet       Int?               // restDaysHome − restDaysAway (positive = home more rested)
  atsFormSampleSize      Int?               // largest canonical ATS sample used (0 if none)
  h2hSampleSize          Int?               // H2H matchup sample size (null if not used)
  scheduleDensityHome    Int?               // home team games in last 7 days
  scheduleDensityAway    Int?               // away team games in last 7 days

  // Provenance — immutable creation-era flags
  isBootstrap          Boolean @default(true)   // mirrors pick.isBootstrap at creation
  usedDerivedHistory   Boolean @default(false)  // ATS/H2H signals were active
  usedScheduleSignal   Boolean @default(false)  // schedule density signal was active
  modelVersion         String  @default("")     // prediction engine version at prediction time

  // Outcome — filled in when the underlying pick settles (never before)
  // settlementResult: "WIN" | "LOSS" | "PUSH" — mirrors pick.result
  settlementResult     String?
  settledAt            DateTime?

  // Learning eligibility — set by settlement flow when all eligibility conditions met:
  // (1) canLearnFromOutcomes=true, (2) isBootstrap=false, (3) settlement recorded
  eligibleForLearning  Boolean   @default(false)
  learningEligibleAt   DateTime?

  pick Pick @relation(fields: [pickId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
  @@index([capturedAt])
  @@index([eligibleForLearning])
  @@index([isBootstrap])
  @@map("pick_signal_snapshots")
}

// ============================================================
// BLOG / CONTENT
// ============================================================

model BlogPost {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  excerpt        String        @db.Text  // free preview
  content        String        @db.Text  // full content (premium)
  sport          String?
  tags           String[]
  seoTitle       String?
  seoDescription String?
  isFeatured     Boolean       @default(false)
  status         ContentStatus @default(DRAFT)
  relatedPickIds String[]
  generatedBy    String        @default("system")
  modelVersion   String?
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
  @@index([publishedAt])
  @@index([sport])
  @@map("blog_posts")
}

// ============================================================
// ALERTS
// ============================================================

model Alert {
  id        String      @id @default(cuid())
  userId    String
  sport     String?
  league    String?
  threshold Int         @default(70) // min confidence
  channel   AlertChannel @default(EMAIL)
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("alerts")
}

// ============================================================
// PERFORMANCE TRACKING
// ============================================================

model PerformanceSummary {
  id           String   @id @default(cuid())
  sport        String
  league       String?
  pickType     PickType?
  tier         PickTier?
  modelVersion String
  totalPicks   Int      @default(0)
  wins         Int      @default(0)
  losses       Int      @default(0)
  pushes       Int      @default(0)
  winRate      Float    @default(0)
  period       String   // e.g. "2026-04", "2026-Q1", "all-time"
  computedAt   DateTime @default(now())

  @@unique([sport, pickType, tier, modelVersion, period])
  @@index([sport])
  @@map("performance_summaries")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  USER
  ADMIN
}

enum SubscriptionTier {
  FREE
  PRO
  ELITE
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
  PAUSED
}

enum GameStatus {
  SCHEDULED
  LIVE
  FINAL
  POSTPONED
  CANCELED
}

enum OddsMarket {
  H2H
  SPREADS
  TOTALS
}

enum PickType {
  SPREAD
  MONEYLINE
  TOTAL
}

enum PickTier {
  FREE
  PREMIUM
}

// Pick quality grade — visible on card
enum PickGrade {
  ELITE_PLAY  // confidence 85+, edge 80+
  STRONG_PLAY // confidence 75+, edge 65+
  SOLID_PLAY  // confidence 65+, edge 50+
  LEAN        // confidence 50+
}

// Risk classification based on volatility factors
enum RiskLevel {
  LOW_RISK       // High bookmaker consensus, deep market
  MODERATE       // Decent consensus, normal market
  HIGH_VARIANCE  // Low consensus or thin market
  INJURY_RISK    // Game-time decision or key injury impact
  LINE_STEAM     // Fast-moving line (high movement detected)
}

enum PickResult {
  PENDING
  WIN
  LOSS
  PUSH
  VOID
}

enum IngestionStatus {
  RUNNING
  SUCCESS
  FAILED
  PARTIAL
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AlertChannel {
  EMAIL
  PUSH
}

enum GameLogResult {
  WIN
  LOSS
  TBD
}

enum SignalCategory {
  ODDS
  SCHEDULE
  WEATHER
  INJURIES
  RATINGS
  MARKET_SENTIMENT
  PLAYER_AVAILABILITY
  OFFICIALS
  VENUE_ENVIRONMENT
  TEAM_RATES
  STANDINGS
  DIVISION_CONTEXT
  MILESTONES
  PACE
}

enum SourceSnapshotKind {
  ODDS_EVENTS
  ODDS_SCORES
  CONTEXT_FIXTURES
  CONTEXT_TEAM_STATS
  CONTEXT_PLAYER_AVAILABILITY
  CONTEXT_OFFICIALS
  CONTEXT_VENUE
  CONTEXT_WEATHER
  CONTEXT_STANDINGS
  CONTEXT_MILESTONES
}

enum AtsResult {
  WIN
  LOSS
  PUSH
  TBD
}

// ============================================================
// OPERATOR COCKPIT (Phase 2B)
//
// Internal-only models. Power the Jarvis-style operator surface
// that routes sports-research, content drafts, support reviews,
// and engineering tasks through an explicit task queue with an
// allow-listed status machine and an append-only decision log.
//
// Safety rules baked into the data model:
//   - CockpitTask.status transitions are validated in the
//     transitions service (apps/web/lib/cockpit/transitions.ts).
//     The schema permits any string value; the service refuses
//     anything outside the allow-list and writes a CockpitDecision
//     row for every successful transition.
//   - CockpitMediaItem.scheduledFor is metadata only. There is
//     no worker that reads it. Publishing remains out of scope.
//   - No direct relation to NextAuth User. The reviewer field on
//     CockpitDecision is a free-text identifier ("manual:garrett",
//     "system", "agent:tal") so seed data and worker-attributed
//     decisions work without requiring a User row.
// ============================================================

enum OperatorAgent {
  JARVIS   // orchestration / dashboard / next-actions
  SARAH    // support / review queue
  TAL      // engineering / repo / bug tasks
  SCOUT    // sports research, line movement, news intake
  AVA      // sports content / media workflow
  BOBBY    // funnel / subscription / analytics insights
}

enum CockpitTaskStatus {
  NEW
  ROUTED
  DRAFTED
  NEEDS_REVIEW
  APPROVED
  REJECTED
  BLOCKED
  ARCHIVED
}

enum CockpitRiskLevel {
  LOW
  MODERATE
  HIGH
  COMPLIANCE_HOLD
}

enum CockpitComplianceStatus {
  NOT_APPLICABLE
  CLEAR
  REVIEW_REQUIRED
  HOLD
  REJECTED
}

model CockpitTask {
  id               String                  @id @default(cuid())
  title            String
  description      String                  @db.Text
  assignedAgent    OperatorAgent
  status           CockpitTaskStatus       @default(NEW)
  priority         Int                     @default(50)
  riskLevel        CockpitRiskLevel        @default(LOW)
  complianceStatus CockpitComplianceStatus @default(NOT_APPLICABLE)
  source           String
  payload          Json?
  decisionNotes    String?                 @db.Text
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  decisions        CockpitDecision[]

  @@index([assignedAgent])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@map("cockpit_tasks")
}

model CockpitDecision {
  id        String            @id @default(cuid())
  taskId    String
  toStatus  CockpitTaskStatus
  reviewer  String
  note      String?           @db.Text
  evidence  Json?
  createdAt DateTime          @default(now())

  task      CockpitTask       @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("cockpit_decisions")
}

model CockpitMediaItem {
  id               String                  @id @default(cuid())
  briefTitle       String
  briefBody        String                  @db.Text
  channel          String
  draftBody        String?                 @db.Text
  qaStatus         String                  @default("DRAFT")
  complianceStatus CockpitComplianceStatus @default(REVIEW_REQUIRED)
  approved         Boolean                 @default(false)
  scheduledFor     DateTime?
  relatedTaskId    String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([qaStatus])
  @@index([complianceStatus])
  @@map("cockpit_media_items")
}

// ============================================================
// PROMOTIONS / AFFILIATE MARKETPLACE (Phase 4)
//
// Sportsbook promotions surfaced as a regulated, compliance-gated
// marketplace. Every promotion that renders publicly must:
//   - have a non-empty `disclosureText`
//   - have a `termsUrl`
//   - be `status=ACTIVE` AND `complianceStatus=APPROVED`
//   - not be past `expiresAt`
//
// The public payload helpers in apps/web/lib/promotions/* enforce
// these rules. The schema accepts any combination — runtime validation
// keeps the data model permissive for editorial workflow while the
// service layer refuses to publish anything noncompliant.
//
// State gating: `eligibleStates` is the authoritative allow-list.
// `restrictedStates` is a redundant deny-list for hard blocks. The
// public selector reads both and renders an honest "not available in
// your state" message rather than fabricating availability.
// ============================================================

enum PromotionStatus {
  DRAFT
  NEEDS_REVIEW
  ACTIVE
  PAUSED
  EXPIRED
  ARCHIVED
  BLOCKED
}

enum PromotionComplianceStatus {
  UNREVIEWED
  APPROVED
  NEEDS_TERMS
  NEEDS_STATE_REVIEW
  NEEDS_DISCLOSURE
  BLOCKED
}

enum PromotionOfferCategory {
  DEPOSIT_MATCH
  RISK_FREE_BET    // legacy industry term — display copy must NOT use "risk free"
  ODDS_BOOST
  BONUS_BET
  SIGNUP_BONUS
  REFERRAL
  OTHER
}

enum PromotionAffiliateType {
  CPA           // cost-per-acquisition
  REVSHARE      // revenue share
  HYBRID
  NONE          // editorial-only listing
}

model Promotion {
  id                 String                    @id @default(cuid())
  slug               String                    @unique
  sportsbookKey      String                    // e.g. "draftkings", "fanduel"
  operatorName       String                    // e.g. "DraftKings Sportsbook"
  headline           String                    // short marketing line (auditable)
  offerSummary       String                    @db.Text
  offerCategory      PromotionOfferCategory
  affiliateType      PromotionAffiliateType    @default(NONE)
  affiliateUrl       String?
  termsUrl           String?
  promoCode          String?

  // Geo gating — store JSON arrays of US state codes (e.g. ["NY","NJ"]).
  // Stored as Json (not String[]) so older Postgres dialects without array
  // support still work and so we can extend to country-state pairs later.
  eligibleStates     Json                      @default("[]")
  restrictedStates   Json                      @default("[]")
  country            String                    @default("US")
  minimumAge         Int                       @default(21)

  status             PromotionStatus           @default(DRAFT)
  complianceStatus   PromotionComplianceStatus @default(UNREVIEWED)

  // Required for public render — both must be non-empty or the public
  // selector refuses to surface the promo.
  disclosureText        String?                @db.Text
  responsibleGamingText String?                @db.Text

  lastReviewedAt     DateTime?
  reviewedBy         String?                   // free-text reviewer id (matches cockpit pattern)
  expiresAt          DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@index([status])
  @@index([complianceStatus])
  @@index([sportsbookKey])
  @@index([expiresAt])
  @@map("promotions")
}

// ============================================================
// SOURCE INTELLIGENCE (Phase 5)
//
// SourceCoverageReport captures the evidence backing a publishable
// artifact (pick, promotion, brief, content draft). The reports are
// computed by services in apps/web/lib/source-intelligence/* and the
// row exists primarily as an audit log — runtime "is this publish
// ready?" decisions are made by recomputing the report against live
// data so a stale row never gates a fresh decision.
// ============================================================

enum SourceArtifactKind {
  PICK
  PROMOTION
  BRIEF
  CONTENT_DRAFT
}

enum SourceFreshnessStatus {
  FRESH       // within the per-category freshness budget
  AGING       // exceeded soft TTL but within hard TTL
  STALE       // exceeded hard TTL — blocks publish-ready
  MISSING     // source category required but no evidence exists
  CONTRADICTORY
}

enum PublishReadinessStatus {
  PUBLISH_READY
  HOLD          // recoverable — needs fresher data
  REVIEW        // requires manual judgement
  BLOCKED       // hard-failed a compliance gate
}

model SourceCoverageReport {
  id              String                  @id @default(cuid())
  artifactKind    SourceArtifactKind
  artifactId      String                  // matches Pick.id / Promotion.id / etc.
  readiness       PublishReadinessStatus
  qualityScore    Int                     // 0..100
  generatedAt     DateTime                @default(now())
  /// Snapshot of per-category status: { ODDS: "FRESH", INJURIES: "AGING", ... }
  /// Stored as JSON so categories can evolve without a migration.
  categories      Json
  /// Free-text rationale: which sources backed the readiness decision,
  /// what is missing, and what the operator should do next.
  rationale       String                  @db.Text
  blockers        Json                    @default("[]")

  @@index([artifactKind, artifactId])
  @@index([readiness])
  @@index([generatedAt])
  @@map("source_coverage_reports")
}

// ============================================================
// MODEL CALIBRATION (Phase 4)
//
// Calibration proposals from the calibration dashboard. Recording a
// proposal NEVER mutates scoring weights. A human operator must
// review the proposal, bump the engine's MODEL_VERSION constant, and
// land a code change for any weight adjustment to take effect.
// ============================================================

enum CalibrationProposalKind {
  CONFIDENCE_BUCKET_DRIFT
  GRADE_DRIFT
  PICK_TYPE_DRIFT
  SPORT_DRIFT
  DATA_QUALITY_DRIFT
  RISK_LEVEL_DRIFT
}

enum CalibrationProposalStatus {
  OPEN
  ACKNOWLEDGED
  IMPLEMENTED
  REJECTED
}

// ============================================================
// DAILY BRIEF (Phase 5)
//
// The daily brief is composed at request time from live tables in
// `apps/web/lib/brief/compose.ts`. These persistence models exist so
// reviewers can:
//   - snapshot the brief that was published for a given day (audit log)
//   - park a review draft with section-level notes
//   - track which sections required manual judgement before publish
// ============================================================

enum BriefStatus {
  DRAFT
  NEEDS_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
  BLOCKED
}

enum BriefVisibility {
  INTERNAL
  PUBLIC
  PREMIUM
}

enum BriefSectionType {
  SLATE_OVERVIEW
  TOP_PICKS
  DATA_QUALITY
  LINE_MOVEMENT
  SCHEDULE_REST
  PERFORMANCE_CONTEXT
  PROMOTIONS
  MANUAL_REVIEW
  CONTENT_IDEAS
  RESPONSIBLE_GAMING
  WHAT_CHANGED
}

model DailyBrief {
  id                    String          @id @default(cuid())
  briefDate             DateTime        // UTC date snapshot (00:00:00Z)
  status                BriefStatus     @default(DRAFT)
  visibility            BriefVisibility @default(INTERNAL)
  title                 String
  summary               String          @db.Text
  slateSummary          String          @db.Text
  dataQualitySummary    String?         @db.Text
  manualReviewNotes     String?         @db.Text
  responsibleGamingText String          @db.Text
  generatedBy           String          // free-text id, matches cockpit pattern
  reviewedBy            String?
  reviewedAt            DateTime?
  publishedAt           DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  sections DailyBriefSection[]
  items    DailyBriefItem[]

  @@unique([briefDate])
  @@index([status])
  @@index([visibility])
  @@map("daily_briefs")
}

model DailyBriefSection {
  id              String           @id @default(cuid())
  briefId         String
  sectionType     BriefSectionType
  title           String
  content         String           @db.Text
  sortOrder       Int              @default(0)
  visibility      BriefVisibility  @default(INTERNAL)
  sourceStatus    String           @default("PENDING") // FRESH | AGING | STALE | MISSING | PENDING
  requiresReview  Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  brief DailyBrief @relation(fields: [briefId], references: [id], onDelete: Cascade)

  @@index([briefId, sortOrder])
  @@map("daily_brief_sections")
}

model DailyBriefItem {
  id          String           @id @default(cuid())
  briefId     String
  itemType    String           // GAME | PICK | PROMOTION | WATCH | TASK
  label       String
  value       String           @db.Text
  metadata    Json?
  sourceId    String?
  riskLevel   String           @default("LOW")
  visibility  BriefVisibility  @default(INTERNAL)
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  brief DailyBrief @relation(fields: [briefId], references: [id], onDelete: Cascade)

  @@index([briefId, sortOrder])
  @@map("daily_brief_items")
}

model CalibrationProposal {
  id            String                    @id @default(cuid())
  modelVersion  String                    // version observed when the proposal was generated
  kind          CalibrationProposalKind
  observation   String                    @db.Text
  proposedChange String                   @db.Text
  evidence      Json                      // bucket stats, sample size, etc.
  status        CalibrationProposalStatus @default(OPEN)
  createdAt     DateTime                  @default(now())
  acknowledgedBy String?
  acknowledgedAt DateTime?

  @@index([modelVersion])
  @@index([status])
  @@index([createdAt])
  @@map("calibration_proposals")
}

// ============================================================
// CONTENT ENGINE (Phase 8) — DRAFT-ONLY
//
// Source-backed, draft-only sports content. Every row is an
// internal artifact. There is no publish endpoint, no scheduler,
// and no automation that turns a row into a live page. Approval
// in the cockpit only means a human reviewer signed off on the
// draft; surfacing it on the public blog still requires a
// deliberate code/data change outside this surface.
//
// Coupling notes:
//   - ContentDraft loosely references existing Pick / Promotion /
//     DailyBrief rows via id arrays stored as Json. The schema
//     does NOT cascade — content rows are evidence, not source of
//     truth, and the referenced data is allowed to evolve.
//   - ContentSource captures the per-source coverage that the
//     `evaluateContentSourceCoverage` service needs at review
//     time. The same service can be run live without DB rows.
//   - ContentReview is an append-only audit log of operator
//     decisions, identical pattern to CockpitDecision.
// ============================================================

enum ContentDraftStatus {
  DRAFT
  NEEDS_SOURCE
  NEEDS_REVIEW
  NEEDS_COMPLIANCE
  APPROVED
  REJECTED
  ARCHIVED
  BLOCKED
}

enum ContentDraftVisibility {
  INTERNAL
  PUBLIC
  PREMIUM
}

enum ContentDraftType {
  DAILY_BRIEF
  MATCHUP_PREVIEW
  METHODOLOGY_EDUCATION
  PROMOTION_ROUNDUP
  WEEKLY_RECAP
  PERFORMANCE_TRANSPARENCY
  RESPONSIBLE_BETTING_EDUCATION
  MODEL_ACCOUNTABILITY_NOTE
  LINE_MOVEMENT_WATCH
  BLOG_POST
  SOCIAL_DRAFT
  NEWSLETTER_DRAFT
}

enum ContentSourceType {
  ODDS
  PICK
  PERFORMANCE
  PROMOTION_TERMS
  RESPONSIBLE_GAMING
  METHODOLOGY
  CALIBRATION
  DAILY_BRIEF
  INTERNAL_REVIEW
}

enum ContentSourceTrustLevel {
  AUTHORITATIVE   // first-party / regulator / sportsbook official terms
  PLATFORM        // generated by our own engine / policy
  REVIEWED        // third-party but reviewed by an operator
  UNVERIFIED      // pending verification — cannot back a regulated claim
  BLOCKED         // operator has explicitly rejected this source
}

enum ContentSourceStatus {
  FRESH
  AGING
  STALE
  MISSING
  PENDING
}

enum ContentSourceCoverageStatus {
  COVERED
  PARTIAL
  NEEDS_SOURCE
  BLOCKED
}

enum ContentComplianceStatus {
  NOT_APPLICABLE
  CLEAR
  REVIEW_REQUIRED
  NEEDS_DISCLOSURE
  NEEDS_RG_LANGUAGE
  BLOCKED
}

enum ContentPerformanceGateStatus {
  NOT_APPLICABLE
  GATE_ON
  GATE_OFF_REQUIRED
  GATE_OFF_BLOCKED
}

enum ContentReviewDecision {
  APPROVED
  CHANGES_REQUESTED
  REJECTED
  ESCALATED
  INTERNAL_ONLY
}

model ContentDraft {
  id                          String                       @id @default(cuid())
  title                       String
  slug                        String                       @unique
  contentType                 ContentDraftType
  status                      ContentDraftStatus           @default(DRAFT)
  visibility                  ContentDraftVisibility       @default(INTERNAL)

  sport                       String?
  league                      String?

  // Loose JSON references (no FK cascade — content is evidence, not source).
  relatedPickIds              Json                         @default("[]")
  relatedPromotionIds         Json                         @default("[]")
  relatedBriefIds             Json                         @default("[]")

  sourceCoverageStatus        ContentSourceCoverageStatus  @default(NEEDS_SOURCE)
  complianceStatus            ContentComplianceStatus      @default(REVIEW_REQUIRED)
  responsibleGamingIncluded   Boolean                      @default(false)
  affiliateDisclosureIncluded Boolean                      @default(false)
  performanceGateStatus       ContentPerformanceGateStatus @default(NOT_APPLICABLE)
  bannedPhraseScanClean       Boolean                      @default(false)

  draftBody                   String                       @db.Text
  excerpt                     String?                      @db.Text
  metadata                    Json?

  generatedBy                 String                       // free-text agent or operator id
  reviewedBy                  String?
  reviewedAt                  DateTime?
  publishedAt                 DateTime?                    // never set by the engine — operator-only
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt

  sources                     ContentSource[]
  reviews                     ContentReview[]

  @@index([status])
  @@index([contentType])
  @@index([visibility])
  @@index([sourceCoverageStatus])
  @@index([complianceStatus])
  @@index([createdAt])
  @@map("content_drafts")
}

model ContentSource {
  id           String                  @id @default(cuid())
  draftId      String
  sourceType   ContentSourceType
  sourceLabel  String
  sourceUrl    String?
  sourceStatus ContentSourceStatus     @default(PENDING)
  trustLevel   ContentSourceTrustLevel @default(UNVERIFIED)
  fetchedAt    DateTime?
  notes        String?                 @db.Text
  createdAt    DateTime                @default(now())

  draft        ContentDraft            @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId])
  @@index([sourceType])
  @@index([trustLevel])
  @@map("content_sources")
}

model ContentReview {
  id        String                 @id @default(cuid())
  draftId   String
  reviewer  String                 // free-text id, matches cockpit pattern
  decision  ContentReviewDecision
  notes     String?                @db.Text
  evidence  Json?
  createdAt DateTime               @default(now())

  draft     ContentDraft           @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId, createdAt])
  @@map("content_reviews")
}
