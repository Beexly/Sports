// ============================================================
// JARVIS MEMORY PROTOCOL (Stage 1)
// ============================================================

enum MemoryType {
  episodic
  semantic
  procedural
  preference
  decision
  failure
  source
  agent_performance
  escalation_rule
  public_claim_rule
}

enum MemoryState {
  candidate
  confirmed
  repeated_pattern
  conflicted
  stale
  superseded
  rejected
  expired
}

model JarvisMemoryEvent {
  id                  String      @id @default(cuid())
  memory_type         MemoryType
  memory_state        MemoryState @default(candidate)
  scope               String
  title               String
  summary             String      @db.Text
  full_text           String?     @db.Text
  source_type         String
  source_ref          String?
  source_timestamp    DateTime?
  actor               String
  owner               String
  confidence          Int         // 0–100
  sensitivity         String      @default("normal") // normal | high | legal | hr | spend
