// Sports Prediction Platform — Prisma Schema
// Generated: 2026-04-07

generator client {
  provider        = "prisma-client-js"
  // driverAdapters unlocks the Neon serverless HTTP driver (see
  // src/neon-serverless-adapter.ts): serverless-friendly connections that
  // survive the cold-start flakiness of raw TCP to Neon. Inert unless
  // NEON_SERVERLESS_DRIVER=true at runtime.
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// AUTH (NextAuth.js compatible)
// ============================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  subscription      Subscription?
  alerts            Alert[]
  claudeApiCalls    ClaudeApiCallRecord[]
  watchlistEntries  Watchlist[]
  checkoutAttempts  CheckoutAttempt[]
  pushSubscriptions PushSubscription[]

  @@index([email])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================
// SUBSCRIPTIONS
// ============================================================

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  stripeCustomerId     String             @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  tier                 SubscriptionTier   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  canceledAt           DateTime?
  // First failed-payment timestamp; anchors the PAST_DUE grace window.
  // Stamped once on the first invoice.payment_failed, cleared on recovery.
  pastDueSince         DateTime?
  trialStart           DateTime?
  trialEnd             DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  webhookEvents WebhookEvent[]

  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@map("subscriptions")
}

model WebhookEvent {
  id             String   @id @default(cuid())
  stripeEventId  String   @unique
  type           String
  subscriptionId String?
  payload        Json
  processedAt    DateTime @default(now())

  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([stripeEventId])
  @@map("webhook_events")
}

// Lifecycle of a durable checkout attempt (see CheckoutAttempt).
enum CheckoutAttemptStatus {
  CREATED // attempt row exists; no Stripe request dispatched yet
  REQUEST_IN_FLIGHT // ONE request holds the claim and is talking to Stripe right now
  SESSION_CREATED // a Stripe Checkout Session was created for this attempt
  AMBIGUOUS // Stripe outcome unknown (network/5xx) — key retained; reconciliation resolves
  COMPLETED // checkout.session.completed reconciled by the webhook/repair
  FAILED // definitive rejection or configuration failure; a retry mints a FRESH attempt
  EXPIRED // past expiresAt / checkout.session.expired; never reused
  CANCELED // operator/owner-cancelled attempt; never reused
}

// Classification of the last Stripe session-create error (see
// apps/web/lib/billing/stripe-outcome.ts). AMBIGUOUS outcomes retain the
// attempt AND its idempotency key; only reconciliation may release them.
enum CheckoutOutcomeClass {
  DEFINITIVE_REJECTION // Stripe processed the request and definitively refused
  AMBIGUOUS_NETWORK_OUTCOME // request may or may not have committed at Stripe
  RETRIABLE_NO_REQUEST_SENT // provably no state change at Stripe; same key retriable
  CONFIGURATION_FAILURE // our credentials/params are wrong; retrying cannot help
}

// Durable checkout attempt — the server-side source of truth for checkout
// idempotency. A client may send a clientIntentId (a per-visit UUID hint);
// the SERVER owns the attempt id, binds it to an immutable request
// fingerprint (the FULL canonical commercial request — see
// apps/web/lib/billing/checkout-attempt.ts), persists the Stripe idempotency
// key, and stamps the attempt id into Checkout Session + subscription
// metadata so webhooks and the repair job can reconcile.
// Component lifetime is NEVER the source of truth: reload, another device,
// or an unknown-network-outcome retry all converge on this row.
//
// AUDIT IDENTITY (immutable): `originalClientIntentId` is written once at
// creation and NEVER cleared. `activeClientIntentId` is the separate
// active-key column: it either equals the original intent id (attempt holds
// the intent) or is NULL (a terminal attempt released the intent so a fresh
// generation can claim it). History is never erased. Both invariants are
// DB-enforced via CHECK constraints in the migration
// (packages/db/prisma/migrations/20260722130000_add_checkout_attempt).
//
// RETENTION (financial audit record): the User FK is NULLABLE with
// ON DELETE SET NULL, and subjectUserId/subjectEmail are immutable snapshots
// taken at creation — deleting a user account never deletes the payment
// audit trail, and the subject stays identifiable for audit/tax purposes.
model CheckoutAttempt {
  id                     String                @id @default(cuid())
  // Immutable audit copy of the client-supplied intent hint (UUID), or null
  // for a token-less request (each such request is its own intent).
  originalClientIntentId String?
  // Active-key column for the create-or-retrieve race. Equals
  // originalClientIntentId while this attempt owns the intent; set to NULL
  // when a terminal (FAILED/EXPIRED/CANCELED) attempt releases it.
  // Postgres treats NULLs as distinct, so the compound unique below only
  // bites while an attempt actually holds an intent.
  activeClientIntentId   String?
  // Nullable FK: user deletion detaches the row (SET NULL), never cascades.
  userId                 String?
  // Immutable subject snapshot for retention — survives user deletion.
  subjectUserId          String
  subjectEmail           String?
  customerId             String?
  tier                   SubscriptionTier
  // Billing interval: "month" | "year" (matches BillingInterval in the app).
  interval               String
  priceId                String
  currency               String                @default("usd")
  quantity               Int                   @default(1)
  // sha256 over the canonical-JSON commercial request (user, tier, interval,
  // priceId, currency, quantity, trial terms, promotion policy, tax
  // behavior, commercial-terms version, consent requirement, origin class,
  // metadata version). Same intent id + different fingerprint is a hard
  // 409 — an idempotency key may never be reused with changed parameters.
  requestFingerprint     String
  fingerprintVersion     String                @default("v2")
  status                 CheckoutAttemptStatus @default(CREATED)
  // Classification of the last Stripe session-create error, if any.
  lastOutcomeClass       CheckoutOutcomeClass?
  // The exact Stripe idempotency key minted for this attempt, persisted so
  // ambiguous retries and the repair job always reuse/see the same key.
  stripeIdempotencyKey   String                @unique
  stripeSessionId        String?
  // Filled by the checkout.session.completed webhook on reconciliation.
  stripeSubscriptionId   String?
  // Machine-readable kind of the last failure (e.g. "stripe_session_create_failed").
  lastErrorKind          String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  completedAt            DateTime?
  // ~24h from creation, matching Stripe's idempotency-key retention window.
  expiresAt              DateTime

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Race safety: two concurrent requests with the same (userId, intent)
  // converge on ONE row via this constraint (create + catch-P2002-then-fetch),
  // never check-then-insert. Keyed on the ACTIVE key so terminal attempts
  // keep their original intent id in originalClientIntentId forever.
  @@unique([userId, activeClientIntentId])
  // Webhook reconciliation lookup.
  @@index([stripeSessionId])
  @@index([userId])
  @@index([subjectUserId])
  // Repair-job scan: unresolved (REQUEST_IN_FLIGHT/AMBIGUOUS) attempts by age.
  @@index([status, expiresAt])
  @@map("checkout_attempts")
}

// ============================================================
// SPORTS / LEAGUES / TEAMS
// ============================================================

model Sport {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "americanfootball_nfl"
  name        String // e.g. "NFL"
  displayName String // e.g. "National Football League"
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  leagues League[]
  games   Game[]

  @@map("sports")
}

model League {
  id          String   @id @default(cuid())
  sportId     String
  key         String   @unique
  name        String
  displayName String
  country     String?
  season      String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  sport Sport  @relation(fields: [sportId], references: [id])
  games Game[]
  teams Team[]

  @@index([sportId])
  @@map("leagues")
}

model Team {
  id           String   @id @default(cuid())
  leagueId     String?
  name         String
  abbreviation String?
  city         String?
  logoUrl      String?
  createdAt    DateTime @default(now())

  league    League? @relation(fields: [leagueId], references: [id])
  homeGames Game[]  @relation("HomeTeam")
  awayGames Game[]  @relation("AwayTeam")

  @@index([leagueId])
  @@index([name])
  @@map("teams")
}

// ============================================================
// GAMES AND ODDS
// ============================================================

model Game {
  id            String     @id @default(cuid())
  externalId    String     @unique // ID from The Odds API
  sportId       String
  leagueId      String?
  homeTeamId    String?
  awayTeamId    String?
  homeTeamName  String // denormalized for speed
  awayTeamName  String
  commenceTime  DateTime
  status        GameStatus @default(SCHEDULED)
  homeScore     Int?
  awayScore     Int?
  resultFetched Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // ── Scheduling / fatigue context (computed from game history) ──
  restDaysHome        Int? // calendar days since home team's prior game
  restDaysAway        Int? // calendar days since away team's prior game
  isBackToBackHome    Boolean @default(false)
  isBackToBackAway    Boolean @default(false)
  scheduleDensityHome Int? // canonical games in last 7 days (home team)
  scheduleDensityAway Int? // canonical games in last 7 days (away team)

  // ── Line movement (populated on repeat ingestion) ──
  openingSpread      Float? // spread at first ingestion
  openingTotal       Float? // total at first ingestion
  lineMovementSpread Float? // current avg spread − opening (negative = home favored more)
  lineMovementTotal  Float? // current avg total − opening

  // ── Data quality ──
  bookmakerCoverageMax Int       @default(0) // highest bookmaker count seen for this game
  dataQualityScore     Float     @default(0) // 0–100 composite at last computation
  currentEdgeIndex     Float? // public 0-100 readout for every tracked game
  contextComputedAt    DateTime? // when scheduling context was last computed

  sport                  Sport                   @relation(fields: [sportId], references: [id])
  league                 League?                 @relation(fields: [leagueId], references: [id])
  homeTeam               Team?                   @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam               Team?                   @relation("AwayTeam", fields: [awayTeamId], references: [id])
  odds                   Odds[]
  picks                  Pick[]
  openingLines           OpeningLine[]
  teamGameLogs           TeamGameLog[]
  gameSignals            GameSignal[]
  pickSignalSnapshots    PickSignalSnapshot[]
  gateDecisions          GateDecision[]
  creatorAssets          CreatorAsset[]
  claudeApiCalls         ClaudeApiCallRecord[]
  oddsLineSnapshots      OddsLineSnapshot[]
  settlementObservations SettlementObservation[]
  settlementAnomalies    SettlementAnomaly[]
  pickSettlementEvents   PickSettlementEvent[]

  @@index([sportId])
  @@index([commenceTime])
  @@index([status])
  @@map("games")
}

// Stores the first-seen odds snapshot per game+market for line movement tracking
model OpeningLine {
  id          String     @id @default(cuid())
  gameId      String
  market      OddsMarket
  spread      Float? // opening spread (home perspective)
  total       Float? // opening total
  homePrice   Float? // opening moneyline home
  awayPrice   Float? // opening moneyline away
  firstSeenAt DateTime   @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, market])
  @@index([gameId])
  @@map("opening_lines")
}

// Stores each team's game log for form computation (populated when games settle)
model TeamGameLog {
  id            String        @id @default(cuid())
  teamName      String // denormalized team identifier (homeTeamName / awayTeamName)
  sport         String
  gameId        String
  opponentName  String
  isHome        Boolean
  gameDate      DateTime // commenceTime of the game
  teamScore     Int?
  opponentScore Int?
  result        GameLogResult @default(TBD)
  // ATS tracking
  spread        Float? // spread from team perspective (negative = team was favored)
  atsResult     AtsResult     @default(TBD) // did team cover?
  createdAt     DateTime      @default(now())

  // Bootstrap safety — true for all logs written before CANONICAL_HISTORY_ENABLED=true.
  // Bootstrap logs are stored for reference but excluded from ATS/H2H scoring.
  // Set to false only when canonical history mode is explicitly active at write time.
  isBootstrap Boolean @default(true)

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, teamName])
  @@index([teamName, sport, gameDate])
  @@index([gameId])
  @@map("team_game_logs")
}

model Odds {
  id              String     @id @default(cuid())
  gameId          String
  ingestionRunId  String
  bookmaker       String
  market          OddsMarket
  homePrice       Float?
  awayPrice       Float?
  drawPrice       Float?
  spread          Float?
  homeSpreadPrice Float?
  awaySpreadPrice Float?
  total           Float?
  overPrice       Float?
  underPrice      Float?
  fetchedAt       DateTime
  createdAt       DateTime   @default(now())

  game         Game         @relation(fields: [gameId], references: [id])
  ingestionRun IngestionRun @relation(fields: [ingestionRunId], references: [id])

  @@index([gameId])
  @@index([ingestionRunId])
  @@index([fetchedAt])
  // Closing-line lookups filter gameId + range/order on fetchedAt (settle-sport,
  // audit route). Per-game odds grow every cycle × book × market, so the composite
  // avoids sorting the whole per-game partition.
  @@index([gameId, fetchedAt])
  @@map("odds")
}

// OddsLineSnapshot — forward line archive for the Glass Ledger (handoff §2 P0):
// timestamped OPENING / INTERIM / CLOSING odds snapshots, one row per
// (game, market, book, side) capture. Purely additive and INERT by default —
// gated by LINE_ARCHIVE_ENABLED (see
// packages/ingestion-pipeline/src/line-archive.ts). Persists odds the existing
// refresh cycle already fetched from The Odds API; adds no new upstream calls.
//
// Phase is stamped at write time:
//   - "OPEN"     the first snapshot ever persisted for (gameId, market)
//   - "INTERIM"  every later mid-cycle capture before kickoff
//   - "CLOSE"    re-tagged onto the last pre-kickoff row per (market, book,
//                side) by the settle-time pass (markClosingSnapshots) — that
//                pass exists but is NOT wired into settle-sport.ts yet.
model OddsLineSnapshot {
  id         String   @id @default(cuid())
  gameId     String
  capturedAt DateTime
  phase      String // "OPEN" | "INTERIM" | "CLOSE"
  book       String
  market     String // "SPREAD" | "MONEYLINE" | "TOTAL"
  side       String
  price      Float // price at capture, in the source's native odds format
  line       Float? // points line at capture (spread/total); null for moneyline
  source     String
  createdAt  DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId, market, capturedAt])
  @@index([phase, capturedAt])
  @@map("odds_line_snapshots")
}

// ============================================================
// INGESTION
// ============================================================

model IngestionRun {
  id            String          @id @default(cuid())
  sport         String?
  status        IngestionStatus @default(RUNNING)
  gamesUpserted Int             @default(0)
  oddsInserted  Int             @default(0)
  errorMessage  String?
  startedAt     DateTime        @default(now())
  completedAt   DateTime?

  odds            Odds[]
  sourceSnapshots SourceSnapshot[]

  @@index([status])
  @@index([startedAt])
  // "Latest successful run" (health, public freshness gate, admin dashboard) filters
  // status="SUCCESS" and orders by completedAt desc; this composite serves it directly.
  @@index([status, completedAt])
  @@map("ingestion_runs")
}

// ============================================================
// PICKS
// ============================================================

model Pick {
  id             String  @id @default(cuid())
  gameId         String
  ingestionRunId String?

  // Core pick fields
  pickType  PickType
  selection String // e.g. "Chiefs -3.5" or "OVER 48.5"
  line      Float

  // Scoring precision fields
  confidence     Int // 0–100 overall score
  edgeScore      Float @default(0) // net bookmaker edge (0–100)
  consensusPct   Float @default(0) // bookmaker consensus 0.0–1.0
  bookmakerCount Int   @default(0) // number of sources used

  // Classification
  tier      PickTier  @default(FREE)
  pickGrade PickGrade @default(LEAN) // A+/A/B/C label
  riskLevel RiskLevel @default(MODERATE) // volatility classification

  // Explainability
  reasoning       String @db.Text // short plain-English summary
  reasoningShort  String @default("") // 1-sentence teaser (free users)
  factorBreakdown Json? // structured scoring factors

  // Metadata
  modelVersion    String
  generatedAt     DateTime  @default(now())
  dataFreshnessAt DateTime? // when the underlying odds data was fetched

  // Outcome
  result      PickResult @default(PENDING)
  settledAt   DateTime?
  isPublished Boolean    @default(true)
  isFeatured  Boolean    @default(false)

  // Closing-Line Value (CLV) — beat-the-close, the sharp credibility metric.
  // Lock fields are captured ONCE at creation (absent from the refresh `update`,
  // so they are immutable) and record the line/price we actually published at.
  // Close + graded fields are filled at settlement by grading the lock against
  // the closing line derived from the odds history. See clv-capture.ts.
  clvLockLine   Float? // points line at publish (spread/total); null for ML
  clvLockPrice  Int? // American price at publish (moneyline); null otherwise
  clvCloseLine  Float? // closing points line compared against (spread/total)
  clvClosePrice Int? // closing American price for the chosen side (moneyline)
  clvKind       String? // "POINTS" | "PROBABILITY"
  clvValue      Float? // graded CLV — positive = beat the close
  clvVerdict    String? // "BEAT_CLOSE" | "MATCHED_CLOSE" | "LOST_TO_CLOSE"
  clvCapturedAt DateTime? // fetchedAt of the closing snapshot used
  clvGradedAt   DateTime? // when CLV was graded at settlement

  // Book-line dispersion (max−min across books) at lock, in the pick kind's unit
  // (points for SPREAD/TOTAL, implied-prob for MONEYLINE). The CLV decomposition's
  // liquidity regressor (clv-decomposition.ts bookDisagreementAtLock). Captured
  // write-once at publish (per-book lines only in hand then); null when <2 books.
  bookDisagreementAtLock Float?

  // Bootstrap safety — true for all picks written before CANONICAL_HISTORY_ENABLED=true.
  // Bootstrap picks are stored for admin review and settlement but excluded from
  // canonical performance metrics and public performance stats.
  isBootstrap Boolean @default(true)

  game            Game                 @relation(fields: [gameId], references: [id])
  signalSnapshot  PickSignalSnapshot?
  lossAutopsy     LossAutopsy?
  gateDecisions   GateDecision[]
  creatorAssets   CreatorAsset[]
  proofReceipt    PickProofReceipt?
  settlementEvent PickSettlementEvent?

  // One active pick per game per pick type — enforced at DB level to prevent
  // duplicate inserts from concurrent worker runs (TOCTOU race prevention).
  @@unique([gameId, pickType])
  @@index([tier])
  @@index([pickGrade])
  @@index([generatedAt])
  @@index([result])
  @@index([isFeatured])
  @@index([clvVerdict])
  // Dashboard orders/ranges settled history by settledAt; unindexed it full-scans as
  // the settled set grows.
  @@index([settledAt])
  @@map("picks")
}

// Pre-result proof receipt — the tamper-evident, pre-kickoff commitment to exactly
// what we claimed for a pick (side, line/price, model prob, market fair prob, edge),
// stamped with a content hash so a skeptic can confirm nothing was edited or
// back-dated after the result was known. One immutable receipt per pick, frozen at
// publish time. `payload` is the canonical serialization the `contentHash` covers —
// see packages/prediction-engine/src/pick-proof-receipt.ts (build + verify).
model PickProofReceipt {
  id             String   @id @default(cuid())
  pickId         String   @unique
  payload        String   @db.Text // canonical committed serialization (source of truth)
  contentHash    String // hash over the committed leaf (id + payload)
  marketFairProb Float // de-vigged market fair prob for the side, 0–1 (real)
  confidence     Int // published 0–100 confidence score (heuristic, NOT a prob)
  edgeScore      Float // published 0–100 net edge score
  modelProb      Float? // calibrated win prob 0–1 — null until one genuinely exists
  entryOdds      Int // American price we entered at
  line           Float // spread/total line (or price for ML)
  modelVersion   String
  asOf           DateTime // when the pick + odds were frozen (pre-kickoff)
  frozenAt       DateTime @default(now())
  slateKey       String? // the slate commitment that pre-registered this pick

  pick  Pick             @relation(fields: [pickId], references: [id])
  slate SlateCommitment? @relation(fields: [slateKey], references: [slateKey])

  @@index([contentHash])
  @@index([slateKey])
  @@map("pick_proof_receipts")
}

// Commit-reveal slate commitment — a single immutable Merkle root over the WHOLE slate
// of a sport's game-day, PUBLISHED before the first kickoff. Pre-registers the exact
// population and its size (the fixed denominator), so picks can't be cherry-picked
// after the fact: you cannot add a winner or drop a loser without changing this root.
// See packages/prediction-engine/src/slate-commitment.ts (build + planSlateCommitment).
model SlateCommitment {
  id          String   @id @default(cuid())
  slateKey    String   @unique // e.g. "NFL:2026-09-14" — one frozen commitment per sport + UTC day
  root        String // published Merkle root over the slate's receipts
  count       Int // pre-registered population size (the fixed denominator)
  committedAt DateTime // published BEFORE the first kickoff

  // Pedersen aggregate over the slate's published edge scores (additive layer on
  // the Merkle root; see docs/ops/ZK_PROOF_EVOLUTION_ROADMAP.md Phase 0.5).
  // Hex is PUBLIC (the sealed aggregate commitment). Value + blindingSum are the
  // OPENER — server-side secrets until a deliberate post-slate open; they must
  // never appear in a public route's select. Nullable: minted at freeze going
  // forward; a mint failure never blocks the Merkle commitment.
  pedersenAggregateHex   String?
  pedersenAggregateValue String? // decimal-string bigint (fixed-point encoded sum)
  pedersenBlindingSum    String? // decimal-string bigint — SECRET until open

  createdAt DateTime @default(now())

  receipts PickProofReceipt[]

  @@index([committedAt])
  @@map("slate_commitments")
}

// Glass Ledger — durable append-only hash chain (F-9 / B-6a).
// PURE math lives in packages/prediction-engine/src/edge-lab/ledger-chain.ts;
// this table is the serverless-safe persistence the in-memory store could not
// be. One public chain (`chainId = glass-v1`). Hashed payload is EXACTLY the
// committed fields of a pick or settlement entry (never entryType/chainId/
// canonVersion — those are projections). No FK to Pick: deleting a pick must
// not delete history. No native enum: TEXT + CHECK so the migration is
// IF NOT EXISTS re-appliable (watchlist doctrine). Application code never
// UPDATE/DELETE these rows. Gated at runtime by LEDGER_CHAIN_ENABLED
// (default OFF). Founder applies the migration; code fails open if the
// table is absent. See docs/ops/edge/2026-08-20-f9-ledger-chain-entry-ruling.md.
model LedgerChainEntry {
  id           String   @id @default(cuid())
  chainId      String   @default("glass-v1") @db.VarChar(32)
  seq          Int
  prevHash     String   @db.VarChar(64)
  entryHash    String   @db.VarChar(64)
  entryType    String // "PICK" | "SETTLEMENT"
  pickId       String
  payload      String   @db.Text // canonical JSON of committed fields (no entryHash)
  hashAlg      String   @default("sha256") @db.VarChar(16)
  canonVersion Int      @default(1)
  modelVersion String?
  occurredAt   DateTime
  createdAt    DateTime @default(now())

  @@unique([chainId, seq])
  @@unique([chainId, entryHash])
  @@unique([chainId, entryType, pickId])
  @@index([pickId])
  @@index([occurredAt])
  @@index([createdAt])
  @@map("ledger_chain_entries")
}

model GateDecision {
  id           String             @id @default(cuid())
  gameId       String
  pickId       String?
  status       GateDecisionStatus
  reason       String             @db.VarChar(240)
  reasonCode   String             @db.VarChar(80)
  edgeIndex    Float?
  confidence   Int?
  modelVersion String
  isBootstrap  Boolean            @default(true)
  evaluatedAt  DateTime           @default(now())
  evidenceRefs Json?

  game Game  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  pick Pick? @relation(fields: [pickId], references: [id], onDelete: SetNull)

  @@index([gameId])
  @@index([pickId])
  @@index([status, evaluatedAt])
  @@index([isBootstrap])
  @@map("gate_decisions")
}

model LossAutopsy {
  id     String @id @default(cuid())
  pickId String @unique
  pick   Pick   @relation(fields: [pickId], references: [id])

  authorEmail String
  authoredAt  DateTime          @default(now())
  status      LossAutopsyStatus @default(DRAFT)

  headline      String @db.VarChar(140)
  whatWeSaw     String @db.Text
  whatHappened  String @db.Text
  whatWeLearned String @db.Text

  rootCause    LossRootCause
  lessonTags   String[]
  modelVersion String?
  isPublic     Boolean       @default(false)

  evidenceRefs Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authoredAt])
  @@index([status])
  @@index([rootCause])
  @@map("loss_autopsies")
}

enum LossAutopsyStatus {
  DRAFT
  PEER_REVIEW
  PUBLISHED
  RETRACTED
}

enum LossRootCause {
  DATA_GAP
  STALE_LINE
  INJURY_SHOCK
  WEATHER
  OFFICIATING
  VARIANCE
  MODEL_DRIFT
  HUMAN_OVERRIDE
  OTHER
}

// ============================================================
// SIGNAL ARCHITECTURE
// ============================================================

// SourceSnapshot stores the raw provider response before any normalization.
// This is the forensic root for the Evidence Engine: every derived signal
// should be traceable to a payload that existed at ingestion time.
model SourceSnapshot {
  id             String             @id @default(cuid())
  provider       String
  sourceKind     SourceSnapshotKind
  sport          String?
  externalId     String?
  ingestionRunId String?
  fetchedAt      DateTime
  payload        Json
  payloadHash    String
  payloadBytes   Int                @default(0)
  createdAt      DateTime           @default(now())

  ingestionRun IngestionRun? @relation(fields: [ingestionRunId], references: [id], onDelete: SetNull)

  @@index([provider, sourceKind])
  @@index([sport])
  @@index([externalId])
  @@index([fetchedAt])
  @@index([payloadHash])
  @@map("source_snapshots")
}

// GameSignal — source-aware signal store for any external or derived input.
// Every signal carries: source identity, category, trust level, freshness,
// and bootstrap provenance. This enables future multi-source intelligence
// without schema sprawl and makes source trust explicit and queryable.
// Current signals: SCHEDULE density (from TeamGameLog).
// Future: WEATHER, INJURIES, RATINGS, MARKET_SENTIMENT.
// @@unique([gameId, sourceName, signalKey]) — one current value per (source, signal) per game.
model GameSignal {
  id             String         @id @default(cuid())
  gameId         String
  sourceCategory SignalCategory
  sourceName     String // provider key e.g. "schedule-internal", "openweather"
  signalKey      String // e.g. "schedule_density_7d_home", "wind_mph"
  signalValue    Json // number | string | object — flexible for all signal types
  fetchedAt      DateTime
  expiresAt      DateTime? // null = valid until game commences
  trustLevel     Float          @default(1.0) // 0.0–1.0: source reliability weight
  isBootstrap    Boolean        @default(true)
  createdAt      DateTime       @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, sourceName, signalKey])
  @@index([gameId, sourceCategory])
  @@index([fetchedAt])
  @@map("game_signals")
}

// PickSignalSnapshot — immutable record of which signals were active when a pick was scored.
// Foundation for outcome-anchored learning and calibration.
// Created ONCE at pick time (update is always empty).
// settlementResult/settledAt filled when pick settles.
// eligibleForLearning set only when: canLearnFromOutcomes=true, isBootstrap=false, settled.
model PickSignalSnapshot {
  id         String   @id @default(cuid())
  pickId     String   @unique
  gameId     String
  capturedAt DateTime @default(now())

  // Active signal categories at prediction time (all boolean flags)
  hadOddsSignal             Boolean @default(false) // always true — primary input
  hadLineMovementSignal     Boolean @default(false) // opening line existed
  hadRestSignal             Boolean @default(false) // restDays or B2B data present
  hadScheduleSignal         Boolean @default(false) // scheduleDensity data present
  hadAtsFormSignal          Boolean @default(false) // canonical ATS form used
  hadH2HSignal              Boolean @default(false) // canonical H2H form used
  hadVenueSignal            Boolean @default(false) // venue-specific ATS form used
  hadWeatherSignal          Boolean @default(false) // weather data present (future)
  hadInjurySignal           Boolean @default(false) // injury data present (future)
  hadRatingsSignal          Boolean @default(false) // team ratings present (future)
  hadPlayerSignal           Boolean @default(false) // player availability/lineup data present (future)
  hadOfficialsSignal        Boolean @default(false) // referee/umpire data present (future)
  hadVenueEnvironmentSignal Boolean @default(false) // venue/park/dome/weather context present (future)
  hadPaceSignal             Boolean @default(false) // pace/team-rate context present (future)
  hadMilestoneSignal        Boolean @default(false) // team/player milestone context present (future)

  // Key quantitative values at prediction time (queryable for calibration regression)
  bookmakerCount         Int    @default(0)
  dataQualityScore       Float  @default(0)
  confidenceAtPrediction Int    @default(0) // raw confidence at creation — immutable
  lineMovementDelta      Float? // current_spread − opening_spread at pick time
  restAdvantageNet       Int? // restDaysHome − restDaysAway (positive = home more rested)
  atsFormSampleSize      Int? // largest canonical ATS sample used (0 if none)
  h2hSampleSize          Int? // H2H matchup sample size (null if not used)
  scheduleDensityHome    Int? // home team games in last 7 days
  scheduleDensityAway    Int? // away team games in last 7 days

  // Provenance — immutable creation-era flags
  isBootstrap        Boolean @default(true) // mirrors pick.isBootstrap at creation
  usedDerivedHistory Boolean @default(false) // ATS/H2H signals were active
  usedScheduleSignal Boolean @default(false) // schedule density signal was active
  modelVersion       String  @default("") // prediction engine version at prediction time

  // Outcome — filled in when the underlying pick settles (never before)
  // settlementResult: "WIN" | "LOSS" | "PUSH" — mirrors pick.result
  settlementResult String?
  settledAt        DateTime?

  // Learning eligibility — set by settlement flow when all eligibility conditions met:
  // (1) canLearnFromOutcomes=true, (2) isBootstrap=false, (3) settlement recorded
  eligibleForLearning Boolean   @default(false)
  learningEligibleAt  DateTime?

  pick Pick @relation(fields: [pickId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
  @@index([capturedAt])
  @@index([eligibleForLearning])
  @@index([isBootstrap])
  @@map("pick_signal_snapshots")
}

// ============================================================
// BLOG / CONTENT
// ============================================================

model BlogPost {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  excerpt        String        @db.Text // free preview
  content        String        @db.Text // full content (premium)
  sport          String?
  tags           String[]
  seoTitle       String?
  seoDescription String?
  isFeatured     Boolean       @default(false)
  status         ContentStatus @default(DRAFT)
  relatedPickIds String[]
  generatedBy    String        @default("system")
  modelVersion   String?
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
  @@index([publishedAt])
  @@index([sport])
  @@map("blog_posts")
}

// ============================================================
// ALERTS
// ============================================================

model Alert {
  id        String       @id @default(cuid())
  userId    String
  sport     String?
  league    String?
  threshold Int          @default(70) // min confidence
  channel   AlertChannel @default(EMAIL)
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("alerts")
}

// ============================================================
// WATCHLIST
// ============================================================

// User-owned follow list: a team or player the user wants to track. This is
// the retention primitive — the per-entity subscribe/follow loop — that
// gates the GRADED-only alert layer (never an ungraded tip; see
// apps/web/lib/watchlist/alert-eligibility.ts). Following itself is not
// FK-constrained to Team/Player: entityType selects which table entityId
// refers to (polymorphic reference), matching this schema's existing
// denormalized-reference convention (e.g. TeamGameLog.teamName) rather than
// a dual-FK union. entityType is a plain String (not a native Postgres
// enum) guarded by a CHECK constraint in the migration — Postgres has no
// `CREATE TYPE ... IF NOT EXISTS`, so a brand-new native enum type would not
// be safely re-appliable; this mirrors the existing convention of
// OddsLineSnapshot.phase / Pick.clvVerdict, which are also String columns
// for small fixed value sets rather than native enums.
//
// Founder-applied migration — see
// packages/db/prisma/migrations/20260717120000_add_watchlist. Application
// code (apps/web/lib/watchlist/db.ts) fails gracefully (503, not 500) when
// this table is absent, exactly like OddsLineSnapshot.
model Watchlist {
  id         String   @id @default(cuid())
  userId     String
  entityType String // "TEAM" | "PLAYER"
  entityId   String // Team.id or Player.id, depending on entityType
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId])
  @@index([userId])
  @@map("watchlist_entries")
}

// One browser/device Web Push subscription for a user — the free, no-vendor
// channel half of the Elite "real-time email & push alerts" feature (see
// apps/web/lib/watchlist/channels/web-push-channel.ts). `endpoint` is
// globally unique (it IS the push service's per-device subscription URL),
// so it doubles as the natural upsert/delete key; `p256dh`/`auth` are the
// two keys the browser's PushSubscription.toJSON() returns, required to
// encrypt a payload for that endpoint. A user may have many rows (one per
// device/browser they've granted permission on).
//
// Founder-applied migration — see
// packages/db/prisma/migrations/20260719120000_add_push_subscriptions,
// following the exact Watchlist precedent above. Application code
// (apps/web/lib/push/subscription-db.ts) fails gracefully when this table
// is absent, exactly like Watchlist/OddsLineSnapshot.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// ============================================================
// SETTLEMENT EVIDENCE + TRANSACTIONAL OUTBOX (Phase 1E)
// ============================================================
// Converges the two rejected designs: #157's in-place sighting counter
// (not atomic, retries counted as corroboration, score arrival destroyed
// history) and #144's in-loop settlement notification hook (fail-isolated
// but not durable). Evidence is APPEND-ONLY: observations are never
// deleted or reset; anomalies are RESOLVED, never erased; decisions are
// immutable receipts. State-machine columns are plain Strings (not native
// Postgres enums) per this schema's established convention for new value
// sets (see Watchlist.entityType / OddsLineSnapshot.phase rationale above):
// founder-applied migrations must be safely re-appliable and Postgres has
// no `CREATE TYPE ... IF NOT EXISTS`.

// One deduplicated sighting of a settlement-relevant source row. The
// compound unique (gameId, settlementRunId, payloadFingerprint) is the
// retry firewall: re-processing the same run/payload is a no-op insert
// (createMany skipDuplicates → INSERT ON CONFLICT DO NOTHING), so a retry
// can NEVER count as fresh corroboration. Corroboration is always derived
// by COUNT(DISTINCT settlementRunId) over these rows — never an in-place
// counter (that was #157's atomicity bug). Append-only: no code path may
// delete or mutate these rows.
// Durable settlement-run identity (hardening 6.1). settleSport() previously
// minted `randomUUID()` per call, so a scheduler retry / process restart /
// duplicate invocation got a fresh run id and counted as fresh corroboration.
// The run is now created-or-retrieved (upsert on the externally derivable
// idempotencyKey = source + sport + scheduledWindow + sourceSnapshotFingerprint)
// BEFORE any evidence write — retries of the same scheduled invocation over
// the same source snapshot reuse the SAME run id and corroborate nothing.
model SettlementRun {
  id                        String    @id @default(cuid())
  idempotencyKey            String    @unique // source:sport:scheduledWindow:sourceSnapshotFingerprint
  source                    String
  sport                     String
  scheduledWindow           String // e.g. "2026-07-22T18Z" (UTC hour bucket from the scheduler)
  sourceSnapshotFingerprint String // sha256 over the normalized source response for this run
  startedAt                 DateTime  @default(now())
  lastReusedAt              DateTime?

  @@index([sport, scheduledWindow])
  @@map("settlement_runs")
}

model SettlementObservation {
  id                        String    @id @default(cuid())
  gameId                    String
  source                    String // upstream feed, e.g. "the-odds-api"
  settlementRunId           String // durable SettlementRun.id (stable across scheduler retries)
  payloadFingerprint        String // sha256 over the normalized source row content
  // sha256 over the WHOLE normalized source snapshot for the run (6.1):
  // corroboration requires distinct snapshots or minimum temporal separation,
  // so rapid same-snapshot retries can never promote an anomaly. Nullable for
  // pre-hardening rows only.
  sourceSnapshotFingerprint String?
  observedSourceStatus      String // e.g. "completed-scoreless"
  homeScorePresent          Boolean
  awayScorePresent          Boolean
  mappingStatus             String // "matched" — game resolved by externalId
  freshnessState            String // e.g. "within-settlement-window" (daysFrom=2 fetch)
  observedAt                DateTime // when the sighting happened (feed read time)
  // Source-provided event timestamp, retained verbatim when the feed sends
  // one (6.1). Distinct from observedAt (our read time) and recordedAt (row
  // insert time).
  sourceObservedAt          DateTime?
  recordedAt                DateTime  @default(now())

  // RESTRICT (6.2): append-only evidence must not silently vanish because a
  // parent game row was deleted. Deleting a game with evidence is an owner-
  // level operation that must first resolve the evidence trail explicitly.
  game Game @relation(fields: [gameId], references: [id], onDelete: Restrict)

  @@unique([gameId, settlementRunId, payloadFingerprint])
  @@index([gameId])
  @@map("settlement_observations")
}

// At most ONE anomaly row per (gameId, anomalyType) — the compound unique
// enforces the single-open-anomaly invariant at the constraint level (at
// most one row total, hence at most one OPEN), and makes the race-safe
// upsert-by-unique pattern possible (Prisma compiles it to INSERT ... ON
// CONFLICT). state: OPEN | OWNER_REVIEW | RESOLVED | DISMISSED. Resolution
// (e.g. scores arriving later) marks the row RESOLVED with an actor +
// reason — it never deletes the row, the observations, or the decision
// receipt (that was #157's history-destruction bug). A RESOLVED/DISMISSED
// anomaly whose condition RECURS is REOPENED (state back to OPEN, SYSTEM
// REOPENED decision event appended); resolvedAt is deliberately KEPT on the
// reopened row as the corroboration boundary — only observations recorded
// after the last resolution can drive a re-promotion.
model SettlementAnomaly {
  id               String    @id @default(cuid())
  gameId           String
  anomalyType      String // e.g. "SCORELESS_COMPLETED"
  state            String    @default("OPEN") // OPEN | OWNER_REVIEW | RESOLVED | DISMISSED
  firstSeenAt      DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())
  // Derived from COUNT(DISTINCT settlementRunId) over SettlementObservation
  // at last evidence write — stored for query convenience only, never the
  // source of truth for threshold decisions.
  distinctRunCount Int       @default(1)
  resolutionActor  String? // e.g. "settlement-pipeline" | an owner user id
  resolvedAt       DateTime?
  resolutionReason String? // e.g. "scores-arrived"

  // RESTRICT (6.2): anomaly history is evidence — never cascade-erased.
  game           Game                      @relation(fields: [gameId], references: [id], onDelete: Restrict)
  decision       SettlementDecision?
  reviewRequest  OwnerDecisionRequest?
  decisionEvents SettlementDecisionEvent[]

  @@unique([gameId, anomalyType])
  @@index([state])
  @@map("settlement_anomalies")
}

// The idempotent owner-review QUEUE REQUEST (hardening 6.3). Previously the
// promotion consumed the single SettlementDecision row with a synthetic
// "REVIEW_REQUESTED" kind, leaving nowhere for the ACTUAL owner decision to
// live. The request is exactly-once per anomaly (unique anomalyId); real
// decisions are append-only SettlementDecisionEvent rows.
model OwnerDecisionRequest {
  id          String   @id @default(cuid())
  anomalyId   String   @unique
  requestKind String // e.g. "SCORELESS_COMPLETED_REVIEW"
  context     Json // game, sightings, corroborating runs at promotion time
  createdAt   DateTime @default(now())

  anomaly SettlementAnomaly @relation(fields: [anomalyId], references: [id], onDelete: Restrict)

  @@map("owner_decision_requests")
}

// Append-only decision history (hardening 6.3). Every state-affecting act on
// an anomaly — the SYSTEM promotion, SYSTEM score-arrival resolution, and
// every real OWNER decision (ACKNOWLEDGED, WAIT_FOR_SOURCE, MARK_POSTPONED,
// VOID_PICKS, DISMISS_ANOMALY, RESOLVE_SCORES_ARRIVED) — appends one event
// carrying the actor receipt and the prior/next state. Rows are NEVER
// updated or deleted. A SYSTEM event may never impersonate an owner: the
// actorType is part of the receipt.
model SettlementDecisionEvent {
  id           String   @id @default(cuid())
  anomalyId    String
  decisionKind String // REVIEW_REQUESTED | ACKNOWLEDGED | WAIT_FOR_SOURCE | MARK_POSTPONED | VOID_PICKS | DISMISS_ANOMALY | RESOLVE_SCORES_ARRIVED
  actorType    String // OWNER | SYSTEM
  actorReceipt Json // {actorType, subjectId, requestId?/runId?, observedAt}
  priorState   String // anomaly state before this event
  nextState    String // anomaly state after this event
  reason       String?
  evidence     Json?
  createdAt    DateTime @default(now())

  anomaly SettlementAnomaly @relation(fields: [anomalyId], references: [id], onDelete: Restrict)

  @@index([anomalyId, createdAt])
  @@map("settlement_decision_events")
}

// Durable owner-decision receipt, created EXACTLY ONCE when an anomaly is
// promoted to OWNER_REVIEW. The unique FK on anomalyId IS the exactly-once
// guarantee: under a double-promotion race the second transaction cannot
// create a second receipt (unique violation aborts it), and the
// state-guarded promotion (updateMany where state=OPEN) means it never
// tries. Immutable: never updated or deleted by pipeline code.
model SettlementDecision {
  id           String   @id @default(cuid())
  anomalyId    String   @unique
  decisionKind String // e.g. "REVIEW_REQUESTED"
  context      Json // game, sightings, distinct runs at promotion time
  createdAt    DateTime @default(now())

  // RESTRICT (6.2): a decision receipt is evidence and must survive.
  anomaly SettlementAnomaly @relation(fields: [anomalyId], references: [id], onDelete: Restrict)

  @@map("settlement_decisions")
}

// Transactional outbox for pick-settlement notifications. A row is
// appended in the SAME database transaction as the pick's PENDING→result
// update, so a settlement can never commit without its event (and an event
// can never exist for an uncommitted settlement) — this replaces #144's
// in-loop onPickGraded hook, which was fail-isolated but not durable (a
// crash after the pick update lost the notification; a blind retry risked
// duplicates). pickId is unique: pick settlement is already idempotent
// (updateMany scoped to result:PENDING), so one settlement = one event.
// Delivery state machine (worker-driven, OUTSIDE the settlement
// transaction): PENDING → CLAIMED → DELIVERED | FAILED; FAILED rows with
// attempts left and stale CLAIMED rows are re-claimable.
// Parent event statuses (hardening 6.4): PENDING (appended by settlement,
// not yet expanded) → EXPANDED (immutable payload + per-recipient
// PickSettlementDelivery children materialized) → then, once EVERY child
// reached a TERMINAL state, exactly one honest terminal:
//   DELIVERED               — no child ended PERMANENT_FAILED/DEAD_LETTER
//   COMPLETED_WITH_FAILURES — at least one child failed terminally; the
//                             parent never asserts a delivery that did not
//                             happen (per-channel truth stays on children)
// The parent is COMPLETE only when all children are terminal; a partial
// failure never closes the event.
model PickSettlementEvent {
  id                       String     @id @default(cuid())
  pickId                   String     @unique
  gameId                   String
  result                   PickResult
  settledAt                DateTime
  status                   String     @default("PENDING") // PENDING | EXPANDED | DELIVERED | COMPLETED_WITH_FAILURES | FAILED (legacy)
  claimedAt                DateTime?
  deliveredAt              DateTime?
  // Set only when every child delivery reached a terminal state (6.4).
  completedAt              DateTime?
  // Immutable event-time payload (6.6): selection, pick type, team ids/names,
  // result, sport, settled time and schema version — frozen at expansion so
  // later mutations of pick/game rows can never rewrite what was announced.
  payload                  Json?
  // When the settlement-time recipient set was materialized into child rows.
  recipientsMaterializedAt DateTime?
  attemptCount             Int        @default(0)
  channelOutcomes          Json? // legacy per-channel detail (pre-delivery-rows)
  createdAt                DateTime   @default(now())

  // RESTRICT (6.2): the outbox trail is evidence of what was owed/sent.
  pick Pick @relation(fields: [pickId], references: [id], onDelete: Restrict)
  game Game @relation(fields: [gameId], references: [id], onDelete: Restrict)

  deliveries PickSettlementDelivery[]

  @@index([status, claimedAt])
  @@map("pick_settlement_events")
}

// One delivery row per follower x channel x destination x event (hardening
// 6.4/6.5). States:
//   PENDING          — materialized, not yet attempted
//   CLAIMED          — leased by a worker (leaseToken fencing)
//   DELIVERED        — terminal success; NEVER resent
//   SUPPRESSED       — terminal: a POLICY decision not to send
//                      (tier-ineligible, alerts disabled, payload expired).
//                      NEVER an infrastructure condition: an unconfigured
//                      channel or failed entitlements lookup retries/defers
//                      instead — infra failures must not become terminal
//                      policy states (6.9)
//   NO_RECIPIENT     — terminal: no destination existed (no verified email /
//                      no push subscription) — recorded honestly, no retry
//   RETRYABLE_FAILED — transient failure (including channel-unconfigured);
//                      retried with backoff+jitter
//   PERMANENT_FAILED — terminal rejection (e.g. expired push subscription)
//   DEAD_LETTER      — attempts exhausted; durable owner-queue escalation
//                      via OutboxDeadLetterReceipt
// A stale worker can never overwrite a newer claimant: every result write is
// scoped to (id, leaseToken, status: CLAIMED) and claims bump claimVersion.
model PickSettlementDelivery {
  id                 String    @id @default(cuid())
  eventId            String
  userId             String
  channel            String // "push" | "email"
  destinationId      String // push subscription id, or sha256(email) — never a raw address
  destinationVersion Int       @default(1)
  idempotencyKey     String    @unique // eventId:userId:channel:destinationId
  status             String    @default("PENDING")
  attemptCount       Int       @default(0)
  claimVersion       Int       @default(0)
  leaseToken         String?
  leaseOwner         String?
  leaseExpiresAt     DateTime?
  nextAttemptAt      DateTime?
  lastErrorCode      String?
  lastErrorClass     String? // "retryable" | "permanent" | "infrastructure"
  attemptHistory     Json? // append-only array of attempt records
  latencyMs          Int? // deliveredAt - event.settledAt (6.8)
  deliveredAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  event PickSettlementEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)

  deadLetterReceipt OutboxDeadLetterReceipt?

  @@unique([eventId, userId, channel, destinationId])
  @@index([status, nextAttemptAt])
  @@index([eventId])
  @@map("pick_settlement_deliveries")
}

// Durable owner-queue escalation for dead-lettered deliveries (hardening
// 6.5) — the outbox analogue of OwnerDecisionRequest. Appended exactly once
// per delivery (unique deliveryId) the moment it reaches DEAD_LETTER, so an
// exhausted delivery is a durable owner work item, not just a transient
// health-endpoint reason string. Append-only from pipeline code; the owner
// stamps acknowledgedAt when triaged.
model OutboxDeadLetterReceipt {
  id             String    @id @default(cuid())
  deliveryId     String    @unique
  eventId        String
  userId         String
  channel        String
  reason         Json // { errorCode, errorClass, attemptCount }
  createdAt      DateTime  @default(now())
  acknowledgedAt DateTime?

  // RESTRICT (6.2): the receipt is evidence of an owed-but-undelivered
  // alert and must survive its delivery row.
  delivery PickSettlementDelivery @relation(fields: [deliveryId], references: [id], onDelete: Restrict)

  @@index([acknowledgedAt, createdAt])
  @@map("outbox_dead_letter_receipts")
}

// Durable post-settlement work state (hardening 6.10): CLV grading, signal-
// snapshot outcome and TeamGameLog writes happen OUTSIDE the settlement
// transaction. These rows are appended IN the settlement transaction, so a
// crash after pick settlement leaves a repairable PENDING record instead of
// relying on an accidental rerun. subjectId is the pick id (CLV_GRADE,
// SNAPSHOT_OUTCOME) or the game id (TEAM_GAME_LOG).
model PostSettlementWork {
  id           String    @id @default(cuid())
  subjectId    String
  kind         String // CLV_GRADE | SNAPSHOT_OUTCOME | TEAM_GAME_LOG
  status       String    @default("PENDING") // PENDING | DONE | FAILED
  attemptCount Int       @default(0)
  lastError    String?
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  @@unique([subjectId, kind])
  @@index([status])
  @@map("post_settlement_work")
}

// ============================================================
// PERFORMANCE TRACKING
// ============================================================

// Serialized TeamStrengthFilter state, so the filter survives serverless cold starts.
// Without this the filter is reconstructed empty on every invocation, sits at ~0.5
// forever, and can never accumulate the settled observations it needs to learn.
// One live row per scope (e.g. "nba"); `version` guards the serialized layout.
model FilterStateSnapshot {
  id                 String   @id @default(cuid())
  scope              String   @unique // e.g. "nba" — one filter per league
  version            Int
  observations       Int      @default(0) // denormalized from the payload for cheap monitoring
  payload            Json // the FilterStateSnapshot from @sports/prediction-engine
  // Team-name -> filter-index map, stored in the SAME row as the payload on
  // purpose: an index IS a team's latent-slot identity, so a snapshot restored
  // against a mismatched registry silently attributes one team's learned
  // strength to another, with nothing downstream able to detect it. Writing
  // both in one upsert makes that state unrepresentable.
  teamIndex          Json?
  // The forecast-skill E-process fold state (ForecastSkillFoldState from
  // @sports/prediction-engine) and the BAEE ensemble's learned weights.
  // INDEPENDENT of payload/teamIndex — neither carries a team-identity
  // attribution hazard (the fold is one scalar running state per scope; BAEE
  // weights index into this scope's model list, not into team slots) — so
  // unlike payload/teamIndex they may be missing or invalid without forcing
  // the filter itself cold. A row written before this column existed simply
  // has null here, which resumes the fold/ensemble fresh, independently.
  forecastSkillState Json?
  baeeWeights        Json?
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())

  @@map("filter_state_snapshots")
}

// Shadow-engine predictions. NOT picks: nothing here is published, priced, or shown
// to a user. This is the single source of truth for offline evaluation — it lets the
// shadow engine be scored against the live one on the SAME games, with zero customer
// risk, before any traffic is ever routed to it.
model ShadowSignal {
  id             String    @id @default(cuid())
  gameId         String
  modelVersion   String
  shadowProb     Float // the shadow engine's home-win probability
  marketProb     Float // de-vigged market probability at evaluation time
  liveConfidence Int? // the live engine's published confidence (0-100), when there was one
  outcome        Int? // 1 = home win, 0 = away win; null until settled
  // Raw per-model probabilities that fed shadowProb (see LiveOrchestrator's
  // `modelProbs` doc for ordering/length-variance caveats). Purely additive —
  // shadowProb remains the authoritative blended value this row scores against.
  // Read-only plumbing for a future weighted ensemble; nothing consumes it yet.
  modelProbs     Json?
  settledAt      DateTime?
  evaluatedAt    DateTime  @default(now())

  // One shadow row per game per model version — a re-run must update, not duplicate,
  // or the offline Brier would be computed over repeated observations of one game.
  @@unique([gameId, modelVersion])
  @@index([settledAt])
  @@index([evaluatedAt])
  @@map("shadow_signals")
}

model PerformanceSummary {
  id           String    @id @default(cuid())
  sport        String
  league       String?
  pickType     PickType?
  tier         PickTier?
  modelVersion String
  totalPicks   Int       @default(0)
  wins         Int       @default(0)
  losses       Int       @default(0)
  pushes       Int       @default(0)
  winRate      Float     @default(0)
  period       String // e.g. "2026-04", "2026-Q1", "all-time"
  computedAt   DateTime  @default(now())

  @@unique([sport, pickType, tier, modelVersion, period])
  @@index([sport])
  @@map("performance_summaries")
}

