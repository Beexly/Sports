// Sports Prediction Platform — Prisma Schema
// Generated: 2026-04-07

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// AUTH (NextAuth.js compatible)
// ============================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  subscription  Subscription?
  alerts        Alert[]

  @@index([email])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================
// SUBSCRIPTIONS
// ============================================================

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  stripeCustomerId     String             @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  tier                 SubscriptionTier   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  canceledAt           DateTime?
  trialStart           DateTime?
  trialEnd             DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  webhookEvents    WebhookEvent[]

  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@map("subscriptions")
}

model WebhookEvent {
  id             String   @id @default(cuid())
  stripeEventId  String   @unique
  type           String
  subscriptionId String?
  payload        Json
  processedAt    DateTime @default(now())

  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([stripeEventId])
  @@map("webhook_events")
}

// ============================================================
// SPORTS / LEAGUES / TEAMS
// ============================================================

model Sport {
  id          String   @id @default(cuid())
  key         String   @unique  // e.g. "americanfootball_nfl"
  name        String             // e.g. "NFL"
  displayName String             // e.g. "National Football League"
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  leagues League[]
  games   Game[]

  @@map("sports")
}

model League {
  id          String   @id @default(cuid())
  sportId     String
  key         String   @unique
  name        String
  displayName String
  country     String?
  season      String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  sport   Sport    @relation(fields: [sportId], references: [id])
  games   Game[]
  teams   Team[]

  @@index([sportId])
  @@map("leagues")
}

model Team {
  id           String   @id @default(cuid())
  leagueId     String?
  name         String
  abbreviation String?
  city         String?
  logoUrl      String?
  createdAt    DateTime @default(now())

  league     League? @relation(fields: [leagueId], references: [id])
  homeGames  Game[]  @relation("HomeTeam")
  awayGames  Game[]  @relation("AwayTeam")

  @@index([leagueId])
  @@index([name])
  @@map("teams")
}

// ============================================================
// GAMES AND ODDS
// ============================================================

model Game {
  id             String     @id @default(cuid())
  externalId     String     @unique  // ID from The Odds API
  sportId        String
  leagueId       String?
  homeTeamId     String?
  awayTeamId     String?
  homeTeamName   String               // denormalized for speed
  awayTeamName   String
  commenceTime   DateTime
  status         GameStatus @default(SCHEDULED)
  homeScore      Int?
  awayScore      Int?
  resultFetched  Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  sport    Sport   @relation(fields: [sportId], references: [id])
  league   League? @relation(fields: [leagueId], references: [id])
  homeTeam Team?   @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam Team?   @relation("AwayTeam", fields: [awayTeamId], references: [id])
  odds     Odds[]
  picks    Pick[]

  @@index([sportId])
  @@index([commenceTime])
  @@index([status])
  @@map("games")
}

model Odds {
  id              String      @id @default(cuid())
  gameId          String
  ingestionRunId  String
  bookmaker       String
  market          OddsMarket
  homePrice       Float?
  awayPrice       Float?
  drawPrice       Float?
  spread          Float?
  homeSpreadPrice Float?
  awaySpreadPrice Float?
  total           Float?
  overPrice       Float?
  underPrice      Float?
  fetchedAt       DateTime
  createdAt       DateTime    @default(now())

  game         Game         @relation(fields: [gameId], references: [id])
  ingestionRun IngestionRun @relation(fields: [ingestionRunId], references: [id])

  @@index([gameId])
  @@index([ingestionRunId])
  @@index([fetchedAt])
  @@map("odds")
}

// ============================================================
// INGESTION
// ============================================================

model IngestionRun {
  id            String            @id @default(cuid())
  sport         String?
  status        IngestionStatus   @default(RUNNING)
  gamesUpserted Int               @default(0)
  oddsInserted  Int               @default(0)
  errorMessage  String?
  startedAt     DateTime          @default(now())
  completedAt   DateTime?

  odds Odds[]

  @@index([status])
  @@index([startedAt])
  @@map("ingestion_runs")
}

// ============================================================
// PICKS
// ============================================================

model Pick {
  id             String     @id @default(cuid())
  gameId         String
  ingestionRunId String?
  pickType       PickType
  selection      String     // e.g. "Chiefs -3.5" or "OVER 48.5"
  line           Float
  confidence     Int        // 0–100
  tier           PickTier   @default(FREE)
  reasoning      String     @db.Text
  modelVersion   String
  generatedAt    DateTime   @default(now())
  result         PickResult @default(PENDING)
  settledAt      DateTime?
  isPublished    Boolean    @default(true)

  game     Game @relation(fields: [gameId], references: [id])

  @@index([gameId])
  @@index([tier])
  @@index([generatedAt])
  @@index([result])
  @@map("picks")
}

// ============================================================
// BLOG / CONTENT
// ============================================================

model BlogPost {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  excerpt        String        @db.Text  // free preview
  content        String        @db.Text  // full content (premium)
  sport          String?
  tags           String[]
  seoTitle       String?
  seoDescription String?
  isFeatured     Boolean       @default(false)
  status         ContentStatus @default(DRAFT)
  relatedPickIds String[]
  generatedBy    String        @default("system")
  modelVersion   String?
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
  @@index([publishedAt])
  @@index([sport])
  @@map("blog_posts")
}

// ============================================================
// ALERTS
// ============================================================

model Alert {
  id        String      @id @default(cuid())
  userId    String
  sport     String?
  league    String?
  threshold Int         @default(70) // min confidence
  channel   AlertChannel @default(EMAIL)
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("alerts")
}

// ============================================================
// PERFORMANCE TRACKING
// ============================================================

model PerformanceSummary {
  id           String   @id @default(cuid())
  sport        String
  league       String?
  pickType     PickType?
  tier         PickTier?
  modelVersion String
  totalPicks   Int      @default(0)
  wins         Int      @default(0)
  losses       Int      @default(0)
  pushes       Int      @default(0)
  winRate      Float    @default(0)
  period       String   // e.g. "2026-04", "2026-Q1", "all-time"
  computedAt   DateTime @default(now())

  @@unique([sport, pickType, tier, modelVersion, period])
  @@index([sport])
  @@map("performance_summaries")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  USER
  ADMIN
}

enum SubscriptionTier {
  FREE
  PRO
  ELITE
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
  PAUSED
}

enum GameStatus {
  SCHEDULED
  LIVE
  FINAL
  POSTPONED
  CANCELED
}

enum OddsMarket {
  H2H
  SPREADS
  TOTALS
}

enum PickType {
  SPREAD
  MONEYLINE
  TOTAL
}

enum PickTier {
  FREE
  PREMIUM
}

enum PickResult {
  PENDING
  WIN
  LOSS
  PUSH
  VOID
}

enum IngestionStatus {
  RUNNING
  SUCCESS
  FAILED
  PARTIAL
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AlertChannel {
  EMAIL
  PUSH
}
