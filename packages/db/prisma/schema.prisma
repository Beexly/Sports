// ============================================================
// PROMOTIONS / AFFILIATE MARKETPLACE (Phase 4)
//
// Sportsbook promotions surfaced as a regulated, compliance-gated
// marketplace. Every promotion that renders publicly must:
//   - have a non-empty `disclosureText`
//   - have a `termsUrl`
//   - be `status=ACTIVE` AND `complianceStatus=APPROVED`
//   - not be past `expiresAt`
//
// The public payload helpers in apps/web/lib/promotions/* enforce
// these rules. The schema accepts any combination — runtime validation
// keeps the data model permissive for editorial workflow while the
// service layer refuses to publish anything noncompliant.
//
// State gating: `eligibleStates` is the authoritative allow-list.
// `restrictedStates` is a redundant deny-list for hard blocks. The
// public selector reads both and renders an honest "not available in
// your state" message rather than fabricating availability.
// ============================================================

enum PromotionStatus {
  DRAFT
  NEEDS_REVIEW
  ACTIVE
  PAUSED
  EXPIRED
  ARCHIVED
  BLOCKED
}

enum PromotionComplianceStatus {
  UNREVIEWED
  APPROVED
  NEEDS_TERMS
  NEEDS_STATE_REVIEW
  NEEDS_DISCLOSURE
  BLOCKED
}

enum PromotionOfferCategory {
  DEPOSIT_MATCH
  RISK_FREE_BET    // legacy industry term — display copy must NOT use "risk free"
  ODDS_BOOST
  BONUS_BET
  SIGNUP_BONUS
  REFERRAL
  OTHER
}

enum PromotionAffiliateType {
  CPA           // cost-per-acquisition
  REVSHARE      // revenue share
  HYBRID
  NONE          // editorial-only listing
}

model Promotion {
  id                 String                    @id @default(cuid())
  slug               String                    @unique
  sportsbookKey      String                    // e.g. "draftkings", "fanduel"
  operatorName       String                    // e.g. "DraftKings Sportsbook"
  headline           String                    // short marketing line (auditable)
  offerSummary       String                    @db.Text
  offerCategory      PromotionOfferCategory
  affiliateType      PromotionAffiliateType    @default(NONE)
  affiliateUrl       String?
  termsUrl           String?
  promoCode          String?

  // Geo gating — store JSON arrays of US state codes (e.g. ["NY","NJ"]).
  // Stored as Json (not String[]) so older Postgres dialects without array
  // support still work and so we can extend to country-state pairs later.
  eligibleStates     Json                      @default("[]")
  restrictedStates   Json                      @default("[]")
  country            String                    @default("US")
  minimumAge         Int                       @default(21)

  status             PromotionStatus           @default(DRAFT)
  complianceStatus   PromotionComplianceStatus @default(UNREVIEWED)

  // Required for public render — both must be non-empty or the public
  // selector refuses to surface the promo.
  disclosureText        String?                @db.Text
  responsibleGamingText String?                @db.Text

  lastReviewedAt     DateTime?
  reviewedBy         String?                   // free-text reviewer id (matches cockpit pattern)
  expiresAt          DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@index([status])
  @@index([complianceStatus])
  @@index([sportsbookKey])
  @@index([expiresAt])
  @@map("promotions")
}

// ============================================================
// SOURCE INTELLIGENCE (Phase 5)
//
// SourceCoverageReport captures the evidence backing a publishable
// artifact (pick, promotion, brief, content draft). The reports are
// computed by services in apps/web/lib/source-intelligence/* and the
// row exists primarily as an audit log — runtime "is this publish
// ready?" decisions are made by recomputing the report against live
// data so a stale row never gates a fresh decision.
// ============================================================

enum SourceArtifactKind {
  PICK
  PROMOTION
  BRIEF
  CONTENT_DRAFT
}

enum SourceFreshnessStatus {
  FRESH       // within the per-category freshness budget
  AGING       // exceeded soft TTL but within hard TTL
  STALE       // exceeded hard TTL — blocks publish-ready
  MISSING     // source category required but no evidence exists
  CONTRADICTORY
}

enum PublishReadinessStatus {
  PUBLISH_READY
  HOLD          // recoverable — needs fresher data
  REVIEW        // requires manual judgement
  BLOCKED       // hard-failed a compliance gate
}

model SourceCoverageReport {
  id              String                  @id @default(cuid())
  artifactKind    SourceArtifactKind
  artifactId      String                  // matches Pick.id / Promotion.id / etc.
  readiness       PublishReadinessStatus
  qualityScore    Int                     // 0..100
  generatedAt     DateTime                @default(now())
  /// Snapshot of per-category status: { ODDS: "FRESH", INJURIES: "AGING", ... }
  /// Stored as JSON so categories can evolve without a migration.
  categories      Json
  /// Free-text rationale: which sources backed the readiness decision,
  /// what is missing, and what the operator should do next.
  rationale       String                  @db.Text
  blockers        Json                    @default("[]")

  @@index([artifactKind, artifactId])
  @@index([readiness])
  @@index([generatedAt])
  @@map("source_coverage_reports")
}

// ============================================================
// MODEL CALIBRATION (Phase 4)
//
// Calibration proposals from the calibration dashboard. Recording a
// proposal NEVER mutates scoring weights. A human operator must
// review the proposal, bump the engine's MODEL_VERSION constant, and
// land a code change for any weight adjustment to take effect.
// ============================================================

enum CalibrationProposalKind {
  CONFIDENCE_BUCKET_DRIFT
  GRADE_DRIFT
  PICK_TYPE_DRIFT
  SPORT_DRIFT
  DATA_QUALITY_DRIFT
  RISK_LEVEL_DRIFT
}

enum CalibrationProposalStatus {
  OPEN
  ACKNOWLEDGED
  IMPLEMENTED
  REJECTED
}

// ============================================================
// DAILY BRIEF (Phase 5)
//
// The daily brief is composed at request time from live tables in
// `apps/web/lib/brief/compose.ts`. These persistence models exist so
// reviewers can:
//   - snapshot the brief that was published for a given day (audit log)
//   - park a review draft with section-level notes
//   - track which sections required manual judgement before publish
// ============================================================

enum BriefStatus {
  DRAFT
  NEEDS_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
  BLOCKED
}

enum BriefVisibility {
  INTERNAL
  PUBLIC
  PREMIUM
}

enum BriefSectionType {
  SLATE_OVERVIEW
  TOP_PICKS
  DATA_QUALITY
  LINE_MOVEMENT
  SCHEDULE_REST
  PERFORMANCE_CONTEXT
  PROMOTIONS
  MANUAL_REVIEW
  CONTENT_IDEAS
  RESPONSIBLE_GAMING
  WHAT_CHANGED
}

model DailyBrief {
  id                    String          @id @default(cuid())
  briefDate             DateTime        // UTC date snapshot (00:00:00Z)
  status                BriefStatus     @default(DRAFT)
  visibility            BriefVisibility @default(INTERNAL)
  title                 String
  summary               String          @db.Text
  slateSummary          String          @db.Text
  dataQualitySummary    String?         @db.Text
  manualReviewNotes     String?         @db.Text
  responsibleGamingText String          @db.Text
  generatedBy           String          // free-text id, matches cockpit pattern
  reviewedBy            String?
  reviewedAt            DateTime?
  publishedAt           DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  sections DailyBriefSection[]
  items    DailyBriefItem[]

  @@unique([briefDate])
  @@index([status])
  @@index([visibility])
  @@map("daily_briefs")
}

model DailyBriefSection {
  id              String           @id @default(cuid())
  briefId         String
  sectionType     BriefSectionType
  title           String
  content         String           @db.Text
  sortOrder       Int              @default(0)
  visibility      BriefVisibility  @default(INTERNAL)
  sourceStatus    String           @default("PENDING") // FRESH | AGING | STALE | MISSING | PENDING
  requiresReview  Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  brief DailyBrief @relation(fields: [briefId], references: [id], onDelete: Cascade)

  @@index([briefId, sortOrder])
  @@map("daily_brief_sections")
}

model DailyBriefItem {
  id          String           @id @default(cuid())
  briefId     String
  itemType    String           // GAME | PICK | PROMOTION | WATCH | TASK
  label       String
  value       String           @db.Text
  metadata    Json?
  sourceId    String?
  riskLevel   String           @default("LOW")
  visibility  BriefVisibility  @default(INTERNAL)
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  brief DailyBrief @relation(fields: [briefId], references: [id], onDelete: Cascade)

  @@index([briefId, sortOrder])
  @@map("daily_brief_items")
}

model CalibrationProposal {
  id            String                    @id @default(cuid())
  modelVersion  String                    // version observed when the proposal was generated
  kind          CalibrationProposalKind
  observation   String                    @db.Text
  proposedChange String                   @db.Text
  evidence      Json                      // bucket stats, sample size, etc.
  status        CalibrationProposalStatus @default(OPEN)
  createdAt     DateTime                  @default(now())
  acknowledgedBy String?
  acknowledgedAt DateTime?

  @@index([modelVersion])
  @@index([status])
  @@index([createdAt])
  @@map("calibration_proposals")
}

// ============================================================
// CONTENT ENGINE (Phase 8) — DRAFT-ONLY
//
// Source-backed, draft-only sports content. Every row is an
// internal artifact. There is no publish endpoint, no scheduler,
// and no automation that turns a row into a live page. Approval
// in the cockpit only means a human reviewer signed off on the
// draft; surfacing it on the public blog still requires a
// deliberate code/data change outside this surface.
//
// Coupling notes:
//   - ContentDraft loosely references existing Pick / Promotion /
//     DailyBrief rows via id arrays stored as Json. The schema
//     does NOT cascade — content rows are evidence, not source of
//     truth, and the referenced data is allowed to evolve.
//   - ContentSource captures the per-source coverage that the
//     `evaluateContentSourceCoverage` service needs at review
//     time. The same service can be run live without DB rows.
//   - ContentReview is an append-only audit log of operator
//     decisions, identical pattern to CockpitDecision.
// ============================================================

enum ContentDraftStatus {
  DRAFT
  NEEDS_SOURCE
  NEEDS_REVIEW
  NEEDS_COMPLIANCE
  APPROVED
  REJECTED
  ARCHIVED
  BLOCKED
}

enum ContentDraftVisibility {
  INTERNAL
  PUBLIC
  PREMIUM
}

enum ContentDraftType {
  DAILY_BRIEF
  MATCHUP_PREVIEW
  METHODOLOGY_EDUCATION
  PROMOTION_ROUNDUP
  WEEKLY_RECAP
  PERFORMANCE_TRANSPARENCY
  RESPONSIBLE_BETTING_EDUCATION
  MODEL_ACCOUNTABILITY_NOTE
  LINE_MOVEMENT_WATCH
  BLOG_POST
  SOCIAL_DRAFT
  NEWSLETTER_DRAFT
}

enum ContentSourceType {
  ODDS
  PICK
  PERFORMANCE
  PROMOTION_TERMS
  RESPONSIBLE_GAMING
  METHODOLOGY
  CALIBRATION
  DAILY_BRIEF
  INTERNAL_REVIEW
}

enum ContentSourceTrustLevel {
  AUTHORITATIVE   // first-party / regulator / sportsbook official terms
  PLATFORM        // generated by our own engine / policy
  REVIEWED        // third-party but reviewed by an operator
  UNVERIFIED      // pending verification — cannot back a regulated claim
  BLOCKED         // operator has explicitly rejected this source
}

enum ContentSourceStatus {
  FRESH
  AGING
  STALE
  MISSING
  PENDING
}

enum ContentSourceCoverageStatus {
  COVERED
  PARTIAL
  NEEDS_SOURCE
  BLOCKED
}

enum ContentComplianceStatus {
  NOT_APPLICABLE
  CLEAR
  REVIEW_REQUIRED
  NEEDS_DISCLOSURE
  NEEDS_RG_LANGUAGE
  BLOCKED
}

enum ContentPerformanceGateStatus {
  NOT_APPLICABLE
  GATE_ON
  GATE_OFF_REQUIRED
  GATE_OFF_BLOCKED
}

enum ContentReviewDecision {
  APPROVED
  CHANGES_REQUESTED
  REJECTED
  ESCALATED
  INTERNAL_ONLY
}

model ContentDraft {
  id                          String                       @id @default(cuid())
  title                       String
  slug                        String                       @unique
  contentType                 ContentDraftType
  status                      ContentDraftStatus           @default(DRAFT)
  visibility                  ContentDraftVisibility       @default(INTERNAL)

  sport                       String?
  league                      String?

  // Loose JSON references (no FK cascade — content is evidence, not source).
  relatedPickIds              Json                         @default("[]")
  relatedPromotionIds         Json                         @default("[]")
  relatedBriefIds             Json                         @default("[]")

  sourceCoverageStatus        ContentSourceCoverageStatus  @default(NEEDS_SOURCE)
  complianceStatus            ContentComplianceStatus      @default(REVIEW_REQUIRED)
  responsibleGamingIncluded   Boolean                      @default(false)
  affiliateDisclosureIncluded Boolean                      @default(false)
  performanceGateStatus       ContentPerformanceGateStatus @default(NOT_APPLICABLE)
  bannedPhraseScanClean       Boolean                      @default(false)

  draftBody                   String                       @db.Text
  excerpt                     String?                      @db.Text
  metadata                    Json?

  generatedBy                 String                       // free-text agent or operator id
  reviewedBy                  String?
  reviewedAt                  DateTime?
  publishedAt                 DateTime?                    // never set by the engine — operator-only
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt

  sources                     ContentSource[]
  reviews                     ContentReview[]

  @@index([status])
  @@index([contentType])
  @@index([visibility])
  @@index([sourceCoverageStatus])
  @@index([complianceStatus])
  @@index([createdAt])
  @@map("content_drafts")
}

model ContentSource {
  id           String                  @id @default(cuid())
  draftId      String
  sourceType   ContentSourceType
  sourceLabel  String
  sourceUrl    String?
  sourceStatus ContentSourceStatus     @default(PENDING)
  trustLevel   ContentSourceTrustLevel @default(UNVERIFIED)
  fetchedAt    DateTime?
  notes        String?                 @db.Text
  createdAt    DateTime                @default(now())

  draft        ContentDraft            @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId])
  @@index([sourceType])
  @@index([trustLevel])
  @@map("content_sources")
}

model ContentReview {
  id        String                 @id @default(cuid())
  draftId   String
  reviewer  String                 // free-text id, matches cockpit pattern
  decision  ContentReviewDecision
  notes     String?                @db.Text
  evidence  Json?
  createdAt DateTime               @default(now())

  draft     ContentDraft           @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId, createdAt])
  @@map("content_reviews")
}

// ============================================================
// COMMUNITY MODERATION (Stage-2 gate)
//
// Powers the graduated action ladder (NUDGE → REMOVE → MUTE →
// SUSPEND → BAN) mandated by COMMUNITY_MODERATION_POLICY.md.
// Every action is logged with actor + reason (platform law).
// Appeals are allowed once per SUSPEND/BAN; a different reviewer
// than the original actor must decide (policy law).
//
// snake_case @@map names per convention.
// No FK to User on actor/reviewer: free-text, matches cockpit pattern.
// ============================================================

enum ModerationReasonCode {
  HARASSMENT
  HATE_SPEECH
  THREATS
  DOXXING
  TOUT_BEHAVIOR
  GUARANTEED_WINNER_LANGUAGE
  PRESSURE_TO_BET
  BEGINNER_MOCKING
  LOSS_SHAMING
  CHASING_LOSSES_ENCOURAGEMENT
  SELF_EXCLUSION_CIRCUMVENTION
  UNDERAGE_PARTICIPATION
  PIRATED_CONTENT
  PERSONAL_DATA_SHARING
  SPAM_REFERRAL_FLOOD
  OTHER
}

enum ModerationReportStatus {
  OPEN
  UNDER_REVIEW
  ACTIONED
  DISMISSED
  ESCALATED
}

enum ModerationActionKind {
  NUDGE
  REMOVE
  MUTE_24H
  MUTE_7D
  SUSPEND
  BAN
}

enum ModerationAppealStatus {
  PENDING
  UNDER_REVIEW
  UPHELD
  OVERTURNED
  EXPIRED
}

// A report filed by a user or automated system against content.
model ModerationReport {
  id           String                  @id @default(cuid())
  reporterUserId String?               // null for automated/system reports
  targetUserId  String
  contentRef   String                  // opaque ref: "message:<id>", "parlay:<id>", etc.
  surface      String                  // e.g. "sunday_couch", "brotherhood_table"
  reason       ModerationReasonCode
  notes        String?                 @db.Text
  status       ModerationReportStatus  @default(OPEN)
  resolvedBy   String?                 // free-text actor id
  resolvedAt   DateTime?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  actions ModerationAction[]

  @@index([targetUserId])
  @@index([status, createdAt])
  @@index([surface])
  @@index([reason])
  @@map("moderation_reports")
}

// A moderation action taken against a user (logged, auditable).
// Every action MUST have actor + reason — enforced in the service layer.
model ModerationAction {
  id           String               @id @default(cuid())
  actor        String               // free-text operator/system id — NEVER empty
  targetUserId String
  contentRef   String?              // optional: the specific content actioned
  surface      String?
  action       ModerationActionKind
  reason       ModerationReasonCode
  notes        String?              @db.Text
  reportId     String?              // which report triggered this (optional)
  // Time-boxed actions: expiresAt required for MUTE_24H, MUTE_7D, SUSPEND.
  // BAN has no expiry. NUDGE/REMOVE have no expiry.
  expiresAt    DateTime?
  createdAt    DateTime             @default(now())

  report  ModerationReport?  @relation(fields: [reportId], references: [id], onDelete: SetNull)
  appeal  ModerationAppeal?

  @@index([targetUserId, createdAt])
  @@index([action])
  @@index([reportId])
  @@index([expiresAt])
  @@map("moderation_actions")
}

// One appeal per SUSPEND/BAN action; decided by a different reviewer.
// 7-day SLA enforced in service logic.
model ModerationAppeal {
  id           String                @id @default(cuid())
  actionId     String                @unique  // one appeal per action
  appellantId  String                // the user who was suspended/banned
  grounds      String                @db.Text
  status       ModerationAppealStatus @default(PENDING)
  // The reviewer must NOT be the same actor who took the original action.
  // Enforced in the service layer (canReview check).
  decidedBy    String?               // free-text reviewer id
  decision     String?               @db.Text
  decidedAt    DateTime?
  // SLA: appeal must be decided within 7 days of filing.
  slaDeadline  DateTime              // createdAt + 7 days; computed at creation
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  action ModerationAction @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@index([status, slaDeadline])
  @@index([appellantId])
  @@map("moderation_appeals")
}

// ============================================================
// PLAYER DATA (nflverse) — system-of-record for NFL player stats
// ------------------------------------------------------------
// Additive layer persisted from the free nflverse release assets
// (CC-BY-4.0). Every row carries provenance (sourceId), a point-in-time
// rights snapshot (captured at extraction), and fetchedAt for freshness —
// per the CLAUDE.md no-stale-data / rights invariants. These tables do NOT
// yet feed the prediction engine; wiring player signals into scoring is a
// separate, gated MODEL_VERSION step.
// ============================================================

model Player {
  id          String   @id @default(cuid())
  gsisId      String   @unique  // nflverse player_id / gsis_id (canonical)
  fullName    String
  position    String?
  recentTeam  String?  // denormalized most-recent team abbreviation
  headshotUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  gameStats    PlayerGameStat[]
  snapCounts   SnapCount[]
  injuries     Injury[]
  depthEntries DepthChartEntry[]

  @@index([position])
  @@index([recentTeam])
  @@map("players")
}

model PlayerGameStat {
  id         String  @id @default(cuid())
  playerId   String
  season     Int
  week       Int
  seasonType String  @default("REG") // REG | POST
  team       String?
  opponent   String?

  // Volume / usage (real player_stats_week columns)
  attempts         Int? // pass attempts
  carries          Int?
  receptions       Int?
  targets          Int?
  targetShare      Float?
  receivingYards   Float?
  rushingYards     Float?
  fantasyPointsPpr Float?

  // Efficiency (nflverse EPA)
  passingEpa   Float?
  rushingEpa   Float?
  receivingEpa Float?

  // Provenance / rights / freshness
  sourceId       String   @default("nflverse")
  rightsSnapshot Json
  fetchedAt      DateTime

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, season, week, seasonType])
  @@index([season, week])
  @@index([playerId])
  @@map("player_game_stats")
}

model SnapCount {
  id           String  @id @default(cuid())
  playerId     String? // resolved nflverse gsis link when available
  pfrPlayerId  String? // natural id in the snap_counts asset
  playerName   String
  season       Int
  week         Int
  seasonType   String  @default("REG")
  team         String?
  opponent     String?
  position     String?
  offenseSnaps Int?
  offensePct   Float?
  defenseSnaps Int?
  defensePct   Float?
  stSnaps      Int?
  stPct        Float?

  sourceId       String   @default("nflverse")
  rightsSnapshot Json
  fetchedAt      DateTime

  player Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@index([season, week])
  @@index([playerId])
  @@map("snap_counts")
}

model Injury {
  id             String  @id @default(cuid())
  playerId       String?
  gsisId         String?
  playerName     String
  season         Int
  week           Int
  team           String?
  position       String?
  reportStatus   String? // Out | Doubtful | Questionable | ... (free text from source)
  practiceStatus String?
  primaryInjury  String? // body part / description

  sourceId       String   @default("nflverse")
  rightsSnapshot Json
  fetchedAt      DateTime

  player Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@index([season, week])
  @@index([playerId])
  @@map("injuries")
}

model DepthChartEntry {
  id         String  @id @default(cuid())
  playerId   String?
  gsisId     String?
  playerName String
  season     Int
  week       Int
  team       String?
  position   String?
  depthRank  Int?    // depth_team rank (1 = starter)
  role       String?

  sourceId       String   @default("nflverse")
  rightsSnapshot Json
  fetchedAt      DateTime

  player Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@index([season, week, team])
  @@index([playerId])
  @@map("depth_chart_entries")
}

// ============================================================
// HISTORICAL GAMES (nflverse `schedules` / games.csv) — settled outcomes
// ------------------------------------------------------------
// One row per game since 1999 with the CLOSING line + total + moneylines AND
// the final score / result. This is the real settled (forecast, outcome)
// archive used to backtest the market model and calibrate confidence against
// actual results — distinct from the live, Odds-API-sourced `Game` table.
// ============================================================

model HistoricalGame {
  id            String  @id @default(cuid())
  gameKey       String  @unique // nflverse game_id (e.g. "2023_01_KC_DET")
  season        Int
  week          Int
  gameType      String  @default("REG") // REG | POST
  awayTeam      String // abbreviation
  homeTeam      String
  awayScore     Int?
  homeScore     Int?
  result        Float? // home margin (home_score - away_score)
  spreadLine    Float? // closing spread, home perspective
  totalLine     Float? // closing total
  awayMoneyline Int?
  homeMoneyline Int?

  sourceId       String   @default("nflverse")
  rightsSnapshot Json
  fetchedAt      DateTime

  @@index([season, week])
  @@index([season])
  @@map("historical_games")
}

// ============================================================
// TEAM-GAME EFFICIENCY (nflverse play-by-play, aggregated)
// ------------------------------------------------------------
// The public foundation for opponent-adjusted ratings and scheme/archetype
// signals. Raw ~50k plays/season are aggregated AT INGESTION to one compact row
// per team-game: offense produced + defense allowed (EPA/play and success rate).
// Additive; clearance-gated + rights/freshness stamped like the other sources.
// ============================================================

model TeamGameEfficiency {
  id            String  @id @default(cuid())
  gameKey       String  // nflverse game_id
  season        Int
  week          Int
  seasonType    String  @default("REG")
  team          String  // abbreviation
  opponent      String
  isHome        Boolean
  plays         Int     // offensive plays counted (pass + run)
  offEpaPerPlay Float
  offSuccess    Float
  defEpaPerPlay Float // allowed
  defSuccess    Float // allowed

  sourceId       String   @default("nflverse")
  rightsSnapshot Json
  fetchedAt      DateTime

  @@unique([team, gameKey])
  @@index([season, week])
  @@index([team, season])
  @@map("team_game_efficiency")
}

// ============================================================
// PLAYER RUSH PROFILE (nflverse play-by-play run direction)
// ------------------------------------------------------------
// Per-rusher season distribution of runs by gap (guard=interior, tackle=
// off-tackle, end=edge) and location (left/middle/right) + EPA/run. The basis
// for a gap/zone/power scheme lean (a proxy from public PBP direction, not
// charted blocking scheme). Additive; clearance-gated + rights/freshness.
// ============================================================

model PlayerRushProfile {
  id         String  @id @default(cuid())
  gsisId     String
  playerName String
  season     Int
  team       String?
  runs       Int
  guardRuns  Int     @default(0) // interior gap (A/B)
  tackleRuns Int     @default(0) // off-tackle (C gap)
  endRuns    Int     @default(0) // outside / edge
  leftRuns   Int     @default(0)
  middleRuns Int     @default(0)
  rightRuns  Int     @default(0)
  epaPerRun  Float

  sourceId       String   @default("nflverse")
  rightsSnapshot Json
  fetchedAt      DateTime

  @@unique([gsisId, season])
  @@index([season])
  @@map("player_rush_profiles")
}

// ============================================================
// NEXT GEN STATS (nflverse `nextgen_stats` aggregates — CC-BY-4.0)
// ------------------------------------------------------------
// The published, free NGS weekly aggregates (NOT the proprietary raw tracking
// feed): separation/cushion (receiving), time-to-throw + CPOE (passing), and
// rush-yards-over-expected (rushing). One row per player-week-variant, keyed by
// gsis id. This is Phase-A persistence — storage as a system of record, NOT a
// scoring input (wiring into the score is a separate, calibration-gated step).
// Real columns verified against the live release headers 2026-06-15.
// ============================================================

model NextGenStat {
  id         String  @id @default(cuid())
  gsisId     String
  playerName String
  position   String?
  season     Int
  week       Int
  seasonType String  @default("REG")
  team       String?
  statType   String // "passing" | "receiving" | "rushing"

  // Passing tracking signals
  avgTimeToThrow        Float?
  avgCompletedAirYards  Float?
  avgIntendedAirYards   Float?
  aggressiveness        Float?
  avgAirYardsToSticks   Float?
  completionPct         Float?
  expectedCompletionPct Float?
  cpoe                  Float? // completion_percentage_above_expectation
  passerRating          Float?

  // Receiving tracking signals
  avgCushion               Float?
  avgSeparation            Float?
  pctShareIntendedAirYards Float?
  catchPct                 Float?
  avgYac                   Float?
  avgExpectedYac           Float?
  avgYacAboveExpectation   Float?

  // Rushing tracking signals
  rushEfficiency              Float?
  pctAttemptsGte8Defenders    Float?
  avgTimeToLos                Float?
  expectedRushYards           Float?
  rushYardsOverExpected       Float?
  rushYardsOverExpectedPerAtt Float?
  rushPctOverExpected         Float?

  sourceId       String   @default("nflverse")
  rightsSnapshot Json
  fetchedAt      DateTime

  @@unique([gsisId, season, week, seasonType, statType])
  @@index([season, week])
  @@index([statType, season])
  @@map("next_gen_stats")
}

// ============================================================
// PFR ADVANCED STATS (nflverse `pfr_advstats` — CC-BY-4.0)
// ------------------------------------------------------------
// Pro-Football-Reference charting-grade weekly advanced stats, the closest
// public "who-did-what": QB pressure (sacked/blitzed/hurried/hit/pressured,
// bad-throw rate), receiving drops/broken tackles, rushing yards before/after
// contact. Per player-game, keyed by the PFR player id (no gsis in the asset).
// Phase-A persistence — storage as a system of record, NOT a scoring input.
// Real columns verified against the live release headers 2026-06-15.
// ============================================================

model PfrAdvStat {
  id          String  @id @default(cuid())
  pfrPlayerId String
  playerName  String
  season      Int
  week        Int
  seasonType  String  @default("REG")
  team        String?
  opponent    String?
  gameKey     String // nflverse/pfr game_id
  statType    String // "pass" | "rec" | "rush"

  // Passing / pressure
  timesSacked        Int?
  timesBlitzed       Int?
  timesHurried       Int?
  timesHit           Int?
  timesPressured     Int?
  timesPressuredPct  Float?
  passingBadThrows   Int?
  passingBadThrowPct Float?
  passingDrops       Int?
  passingDropPct     Float?

  // Receiving
  receivingBrokenTackles Int?
  receivingDrop          Int?
  receivingDropPct       Float?
  receivingInt           Int?
  receivingRat           Float?

  // Rushing
  carries                      Int?
  rushingYardsBeforeContact    Float?
  rushingYardsBeforeContactAvg Float?
  rushingYardsAfterContact     Float?
  rushingYardsAfterContactAvg  Float?
  rushingBrokenTackles         Int?

  sourceId       String   @default("nflverse")
  rightsSnapshot Json
  fetchedAt      DateTime

  @@unique([pfrPlayerId, gameKey, statType])
  @@index([season, week])
  @@index([statType, season])
  @@map("pfr_adv_stats")
}

// ============================================================
// TEAM WEEK STATS (nflverse `stats_team` aggregates — CC-BY-4.0)
// ------------------------------------------------------------
// Published team-week aggregates: offensive EPA/CPOE + air yards/first downs/
// TDs and headline defensive box (sacks, INTs, QB hits, TFL, PDs). Complements
// the PBP-DERIVED `TeamGameEfficiency` (per-play EPA/success) with the published
// box+CPOE view. Phase-A persistence — storage only, not a scoring input.
// Real columns verified against the live release headers 2026-06-15.
// ============================================================

model TeamWeekStat {
  id         String  @id @default(cuid())
  season     Int
  week       Int
  seasonType String  @default("REG")
  team       String
  opponent   String?

  // Offense
  completions    Int?
  attempts       Int?
  passYards      Float?
  passTds        Int?
  passInt        Int?
  sacksSuffered  Int?
  passAirYards   Float?
  passYac        Float?
  passFirstDowns Int?
  passEpa        Float?
  passCpoe       Float?
  carries        Int?
  rushYards      Float?
  rushTds        Int?
  rushFirstDowns Int?
  rushEpa        Float?
  receptions     Int?
  targets        Int?
  recYards       Float?
  recEpa         Float?

  // Defense (headline box)
  defSacks          Float?
  defInterceptions  Int?
  defQbHits         Int?
  defTacklesForLoss Int?
  defPassDefended   Int?
  defTds            Int?

  sourceId       String   @default("nflverse")
  rightsSnapshot Json
  fetchedAt      DateTime

  @@unique([team, season, week, seasonType])
  @@index([season, week])
  @@map("team_week_stats")
}

// ============================================================
// UNIVERSAL SIGNAL LEDGER ("weight absolutely everything")
// ------------------------------------------------------------
// One row per signal that moves an entity's value — hard metrics AND soft
// signals (practice status, rumors, coachspeak). Each row carries its OWN
// weight + confidence (the honesty valve) + a normalized directional `value`,
// so the weighting POLICY lives in the data (set by calibration-gated
// populators), never hardcoded. The prediction-engine `composeLedger` bridge
// blends these via the existing composite-score engine with freshness decay.
// Storage only — NOT wired into the published pick score.
// ============================================================

model Signal {
  id         String   @id @default(cuid())
  entityType String // "player" | "team"
  entityId   String // gsis id or team abbreviation
  key        String // e.g. "ngs.separation", "injury.practice_status", "rumor.holdout"
  category   String // SignalCategory value (PRODUCTION / HEALTH / NARRATIVE / ...)
  valueRaw   Float? // source reading, retained for audit
  value      Float // normalized directional reading (+ good / − bad) for the composer
  weight     Float    @default(1) // base importance (>= 0)
  confidence Float    @default(1) // 0..1 honesty valve (settled stat ≈ 1, rumor ≈ 0.2)
  capturedAt DateTime // drives freshness decay

  // Non-null with a 0 sentinel so the unique key actually enforces one row per
  // signal — Postgres treats NULLs as distinct, which would let duplicates
  // (and thus double-counted votes) through for non-seasonal signals.
  season Int @default(0) // 0 = season-agnostic / non-seasonal signal
  week   Int @default(0) // 0 = full-season / non-weekly signal

  sourceId       String   @default("nflverse")
  rightsSnapshot Json
  fetchedAt      DateTime

  @@unique([entityType, entityId, key, season, week])
  @@index([entityType, entityId])
  @@index([category])
  @@map("signals")
}
