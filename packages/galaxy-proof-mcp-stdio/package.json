{
  "name": "galaxy-proof-mcp",
  "version": "1.0.0",
  "description": "MCP server that lets any AI agent independently and trustlessly verify Galaxy Sports Edge's publish-before-kickoff pick record via the public Proof API.",
  "type": "module",
  "bin": {
    "galaxy-proof-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node smoke.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "galaxy-sports-edge",
    "sports",
    "verifiable",
    "proof",
    "audit"
  ],
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "@types/node": "^20.14.0"
  },
  "engines": {
    "node": ">=18"
  }
}
