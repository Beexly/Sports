# .bazelrc — Galaxy Sports Edge Production Monorepo Build Configuration
# Aligned with `bazel-build-optimization` & `dx-optimizer`

build --enable_platform_specific_config
build --incompatible_enable_cc_toolchain_resolution
build --experimental_strict_conflict_checks

# Resource & Parallelism Tuning
build --jobs=auto
build --local_cpu_resources=HOST_CPUS*.75
build --local_ram_resources=HOST_RAM*.75

# Local Disk & Repository Caching
build --disk_cache=~/.cache/gse-bazel-disk
build --repository_cache=~/.cache/gse-bazel-repo

# Platform-Specific AVX2 + OpenMP Flags for Native C11/C++20 Kernels
build:linux --copt=-O3 --copt=-mavx2 --copt=-mfma --copt=-fopenmp --linkopt=-fopenmp
build:windows --copt=-O3 --copt=-mavx2 --copt=-mfma --copt=-fopenmp --linkopt=-fopenmp
build:macos --copt=-O3

# Optimization Profiles
build:opt --compilation_mode=opt
build:dbg --compilation_mode=dbg
build:ci --compilation_mode=opt --test_output=errors --test_summary=detailed

# Test Defaults
test --test_output=errors
test --test_summary=detailed

try-import %workspace%/user.bazelrc
