{"$id":"gse/premise-grading/premise-grade.schema.json","$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"description":"One record in the append-only premise-grading ledger. A premise enters as a PENDING record; grading APPENDS a second record for the same premise_id with the outcome filled. The premise fields (statement, direction, evidence, sources, as_of) are immutable across a premise's chain: grading never rewrites a premise. The scorer's validator implements the subset of JSON Schema used here plus the cross-field grading-discipline rules listed in the README.","properties":{"as_of":{"type":["string","null"]},"confidence_class":{"enum":["CORROBORATED","STAMPED","STRUCTURAL","QUALITATIVE"],"type":"string"},"direction":{"enum":["FAVORS_HOME","FAVORS_AWAY","AGAINST_HOME","AGAINST_AWAY","FRICTION","NEUTRAL","NO_BET"],"type":"string"},"evidence":{"items":{"additionalProperties":false,"properties":{"as_of":{"type":["string","null"]},"detail":{"type":["string","null"]},"kind":{"minLength":1,"type":"string"},"ref":{"minLength":1,"type":"string"}},"required":["kind","ref"],"type":"object"},"minItems":1,"type":"array"},"game_key":{"minLength":1,"type":"string"},"graded_at":{"type":["string","null"]},"grader_id":{"type":["string","null"]},"ledger_seq":{"minimum":1,"type":"integer"},"magnitude_band":{"enum":["STRONG","MODERATE","WEAK","NEUTRAL",null],"type":["string","null"]},"miss_magnitude_class":{"enum":["NONE","SMALL","MODERATE","LARGE",null],"type":["string","null"]},"notes":{"type":"string"},"outcome":{"additionalProperties":false,"properties":{"outcome_artifact":{"type":["string","null"]},"realized_fact":{"type":["string","null"]},"verdict":{"enum":["PENDING","SUPPORTED","REFUTED","UNRESOLVED"],"type":"string"}},"required":["verdict","realized_fact","outcome_artifact"],"type":"object"},"premise_id":{"minLength":1,"type":"string"},"premise_type":{"minLength":1,"type":"string"},"record_version":{"const":"1.0"},"sources":{"items":{"additionalProperties":false,"properties":{"kind":{"minLength":1,"type":"string"},"ref":{"minLength":1,"type":"string"},"source_premise_id":{"type":["string","null"]}},"required":["kind","ref"],"type":"object"},"minItems":1,"type":"array"},"stated_uncertainty":{"minLength":1,"type":"string"},"statement":{"minLength":1,"type":"string"},"status":{"enum":["PENDING","GRADED"],"type":"string"},"subject":{"type":["string","null"]}},"required":["record_version","ledger_seq","premise_id","game_key","premise_type","subject","statement","direction","magnitude_band","confidence_class","stated_uncertainty","evidence","sources","as_of","status","outcome","miss_magnitude_class","graded_at","grader_id","notes"],"title":"Premise-grade record (premise-grading ledger v1)","type":"object"}