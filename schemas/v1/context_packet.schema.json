{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://galaxysportsedge.com/schemas/v1/context_packet.schema.json",
  "title": "ContextPacketV1",
  "type": "object",
  "required": [
    "schema_version",
    "packet_id",
    "game_id",
    "home_team",
    "away_team",
    "kickoff_utc",
    "as_of",
    "temporal_leakage_checked",
    "entity_resolution_verified",
    "layers",
    "corpus_citations",
    "completeness"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "packet_id": { "type": "string", "minLength": 5 },
    "game_id": { "type": "string", "minLength": 3 },
    "home_team": { "type": "string", "minLength": 2, "maxLength": 3 },
    "away_team": { "type": "string", "minLength": 2, "maxLength": 3 },
    "kickoff_utc": { "type": "string", "minLength": 10 },
    "as_of": { "type": "string", "minLength": 10 },
    "temporal_leakage_checked": { "type": "boolean", "const": true },
    "entity_resolution_verified": { "type": "boolean", "const": true },
    "layers": {
      "type": "object",
      "minProperties": 26,
      "maxProperties": 26
    },
    "corpus_citations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "chunk_id", "relevance_reason"],
        "properties": {
          "source_id": { "type": "string" },
          "chunk_id": { "type": "string" },
          "relevance_reason": { "type": "string" }
        }
      }
    },
    "completeness": {
      "type": "object",
      "required": ["populated_layers", "total_layers", "is_complete"],
      "properties": {
        "populated_layers": { "type": "integer", "const": 26 },
        "total_layers": { "type": "integer", "const": 26 },
        "is_complete": { "type": "boolean", "const": true }
      }
    }
  },
  "additionalProperties": false
}
