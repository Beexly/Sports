{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://galaxysportsedge.com/schemas/v1/context_packet.schema.json",
  "title": "GSE 26-Layer Game Context Packet Schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packet_id",
    "schema_version",
    "game_id",
    "season",
    "week",
    "home_team",
    "away_team",
    "kickoff_utc",
    "as_of_utc",
    "entity_resolution_verified",
    "resolved_entities",
    "layers",
    "completeness_summary"
  ],
  "properties": {
    "packet_id": {
      "type": "string",
      "minLength": 5
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "game_id": {
      "type": "string",
      "minLength": 3
    },
    "season": {
      "type": "integer",
      "minimum": 2000,
      "maximum": 2035
    },
    "week": {
      "type": "integer",
      "minimum": 1,
      "maximum": 25
    },
    "home_team": {
      "type": "string",
      "minLength": 2,
      "maxLength": 4
    },
    "away_team": {
      "type": "string",
      "minLength": 2,
      "maxLength": 4
    },
    "kickoff_utc": {
      "type": "string",
      "format": "date-time"
    },
    "as_of_utc": {
      "type": "string",
      "format": "date-time",
      "description": "Must satisfy as_of_utc < kickoff_utc to prevent temporal leakage."
    },
    "entity_resolution_verified": {
      "type": "boolean"
    },
    "resolved_entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["canonical_id", "full_name", "team", "position"],
        "properties": {
          "canonical_id": { "type": "string", "minLength": 2 },
          "full_name": { "type": "string", "minLength": 2 },
          "team": { "type": "string", "minLength": 2, "maxLength": 4 },
          "position": { "type": "string", "minLength": 1, "maxLength": 6 }
        }
      }
    },
    "layers": {
      "type": "array",
      "minItems": 26,
      "maxItems": 26,
      "items": {
        "$ref": "https://galaxysportsedge.com/schemas/v1/layer_output.schema.json"
      }
    },
    "completeness_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_layers",
        "active_layers",
        "waived_layers",
        "missing_upstream_layers",
        "aggregate_uncertainty_width"
      ],
      "properties": {
        "total_layers": { "type": "integer", "const": 26 },
        "active_layers": { "type": "integer", "minimum": 0, "maximum": 26 },
        "waived_layers": { "type": "integer", "minimum": 0, "maximum": 26 },
        "missing_upstream_layers": { "type": "integer", "minimum": 0, "maximum": 26 },
        "aggregate_uncertainty_width": { "type": "number", "minimum": 0 }
      }
    }
  }
}
