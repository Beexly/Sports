{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://galaxysportsedge.com/schemas/v1/reasoning_trace.schema.json",
  "title": "GSE L1-L5 Reasoning Trace Schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trace_id",
    "schema_version",
    "packet_id",
    "game_id",
    "as_of_utc",
    "ledger_sha",
    "dependency_order_verified",
    "tracks",
    "levels",
    "layer_citations",
    "fallback_fired",
    "fallback_reason"
  ],
  "properties": {
    "trace_id": { "type": "string", "minLength": 5 },
    "schema_version": { "type": "string", "const": "1.0.0" },
    "packet_id": { "type": "string", "minLength": 5 },
    "game_id": { "type": "string", "minLength": 3 },
    "as_of_utc": { "type": "string", "format": "date-time" },
    "ledger_sha": { "type": "string", "minLength": 7 },
    "dependency_order_verified": {
      "type": "boolean",
      "const": true,
      "description": "Enforces strict OL -> scheme -> QB dependency order."
    },
    "tracks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offensive_line",
        "coaching_scheme",
        "qb_behavior",
        "trust_signals",
        "scheme_matchup"
      ],
      "properties": {
        "offensive_line": { "type": "object" },
        "coaching_scheme": { "type": "object" },
        "qb_behavior": { "type": "object" },
        "trust_signals": { "type": "object" },
        "scheme_matchup": { "type": "object" }
      }
    },
    "levels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "L1_signal_extraction",
        "L2_interaction_synthesis",
        "L3_structural_valuation",
        "L4_adversary",
        "L5_synthesis"
      ],
      "properties": {
        "L1_signal_extraction": { "type": "object" },
        "L2_interaction_synthesis": { "type": "object" },
        "L3_structural_valuation": { "type": "object" },
        "L4_adversary": { "type": "object" },
        "L5_synthesis": { "type": "object" }
      }
    },
    "layer_citations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "fallback_fired": { "type": "boolean" },
    "fallback_reason": { "type": ["string", "null"] }
  }
}
