{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sports-repo.local/schemas/bet_log_v1.json",
  "title": "BetLogV1",
  "description": "Pick-level logging schema for adversarial validation and attribution. Required fields: timestamp, model_version, pre_reg_reference, probability, line_taken, outcome, pl, attribution.",
  "type": "object",
  "required": ["pick_id", "timestamp", "model_version", "pre_reg_ref", "prob_est", "line_taken", "outcome", "pl", "attribution"],
  "properties": {
    "pick_id": {"type": "string"},
    "timestamp": {"type": "string", "format": "date-time"},
    "model_version": {"type": "string"},
    "pre_reg_ref": {"type": "string", "description": "Link to pre-registration protocol (§1)"},
    "prob_est": {"type": "number", "minimum": 0, "maximum": 1},
    "line_taken": {"type": "object", "description": "Market line at time of pick"},
    "outcome": {"type": "string", "description": "win / loss / push / unresolved"},
    "pl": {"type": "number"},
    "portfolio_decision": {"type": "boolean", "description": "True if part of Whitrow simultaneous portfolio (§2)"},
    "attribution": {
      "type": "object",
      "required": ["feature_group", "adversarial_holdout_passed", "single_or_portfolio"],
      "properties": {
        "feature_group": {"type": "string"},
        "adversarial_holdout_passed": {"type": "boolean"},
        "single_or_portfolio": {"type": "string", "enum": ["single", "portfolio"]}
      }
    }
  },
  "additionalProperties": false
}
