+export interface CalibrationBucket { readonly lower: number; readonly upper: number; readonly count: number; readonly avgConfidence: number; readonly accuracy: number; readonly gap: number; }
+export function confidenceBuckets(samples: readonly { readonly probability: number; readonly outcome: 0 | 1 }[], bucketCount = 10): readonly CalibrationBucket[] { const buckets: CalibrationBucket[] = []; for (let i = 0; i < bucketCount; i += 1) { const lower = i / bucketCount; const upper = (i + 1) / bucketCount; const bucketSamples = samples.filter((sample) => sample.probability >= lower && (i === bucketCount - 1 ? sample.probability <= upper : sample.probability < upper)); const count = bucketSamples.length; const avgConfidence = count ? bucketSamples.reduce((sum, sample) => sum + sample.probability, 0) / count : 0; const accuracy = count ? bucketSamples.reduce((sum, sample) => sum + sample.outcome, 0) / count : 0; buckets.push({ lower, upper, count, avgConfidence, accuracy, gap: Math.abs(avgConfidence - accuracy) }); } return buckets; }
+export function expectedCalibrationError(samples: readonly { readonly probability: number; readonly outcome: 0 | 1 }[], bucketCount = 10): number { const buckets = confidenceBuckets(samples, bucketCount); return buckets.reduce((sum, bucket) => sum + (bucket.count / Math.max(samples.length, 1)) * bucket.gap, 0); }
+export function maximumCalibrationError(samples: readonly { readonly probability: number; readonly outcome: 0 | 1 }[], bucketCount = 10): number { return Math.max(0, ...confidenceBuckets(samples, bucketCount).map((bucket) => bucket.gap)); }
