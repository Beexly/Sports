# WORKSPACE.bazel — Galaxy Sports Edge (GSE + GSI) Monorepo Bazel Workspace
workspace(name = "galaxy_sports_edge")

load("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# Aspect Rules for JavaScript & TypeScript (`aspect_rules_js` 1.34.0 + `aspect_rules_ts` 2.1.0)
http_archive(
    name = "aspect_rules_js",
    strip_prefix = "rules_js-1.34.0",
    url = "https://github.com/aspect-build/rules_js/releases/download/v1.34.0/rules_js-v1.34.0.tar.gz",
)

http_archive(
    name = "aspect_rules_ts",
    strip_prefix = "rules_ts-2.1.0",
    url = "https://github.com/aspect-build/rules_ts/releases/download/v2.1.0/rules_ts-v2.1.0.tar.gz",
)

load("@aspect_rules_js//js:repositories.bzl", "rules_js_dependencies")
rules_js_dependencies()

load("@rules_nodejs//nodejs:repositories.bzl", "nodejs_register_toolchains")
nodejs_register_toolchains(
    name = "nodejs",
    node_version = "20.11.0",
)

load("@aspect_rules_js//npm:repositories.bzl", "npm_translate_lock")
npm_translate_lock(
    name = "npm",
    npm_package_lock = "//:package-lock.json",
    verify_node_modules_ignored = "//:.bazelignore",
)

# Rules for Python (`rules_python` 0.27.0 — Python 3.13 Vectorized / Coach Mind / Situational Engine)
http_archive(
    name = "rules_python",
    strip_prefix = "rules_python-0.27.0",
    url = "https://github.com/bazelbuild/rules_python/releases/download/0.27.0/rules_python-0.27.0.tar.gz",
)

load("@rules_python//python:repositories.bzl", "py_repositories", "python_register_toolchains")
py_repositories()

python_register_toolchains(
    name = "python_3_13",
    python_version = "3.13",
)
