{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git blame*)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git rev-parse*)",
      "Bash(git ls-files*)",
      "Bash(git check-ignore*)",
      "Bash(npm run typecheck*)",
      "Bash(npm run lint*)",
      "Bash(npm run test*)",
      "Bash(npm run guardrails*)",
      "Bash(npm run guard:*)",
      "Bash(npm run agent:eval*)",
      "Bash(npm run evals:contracts*)",
      "Bash(npm run db:generate*)",
      "Bash(npm run db:migrate:status*)",
      "Bash(npm run deploy:ready*)",
      "Bash(npm run smoke:prod*)",
      "Bash(npx vitest*)",
      "Bash(npx tsc --noEmit*)",
      "Bash(npx prisma generate*)",
      "Bash(npx prisma validate*)",
      "Bash(npx prisma migrate status*)",
      "Bash(node scripts/guardrails/*)",
      "Bash(node scripts/agent-eval/run.mjs*)",
      "Bash(ls*)",
      "Bash(wc*)"
    ],
    "ask": [
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(stripe *)",
      "Bash(psql *)",
      "Bash(npx prisma db push*)",
      "Bash(npx prisma db seed*)",
      "Bash(npx prisma migrate deploy*)",
      "Bash(npx prisma migrate dev*)",
      "Bash(npx prisma migrate resolve*)",
      "Bash(npm run db:push*)",
      "Bash(npm run db:migrate)",
      "Bash(npm run db:migrate --*)",
      "Bash(npm run db:migrate:dev*)",
      "Bash(npm run db:seed*)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npx --yes *)",
      "Bash(npx -y *)",
      "Bash(vercel *)",
      "Bash(npm publish*)",
      "mcp__Neon__run_sql",
      "mcp__Neon__run_sql_transaction",
      "mcp__Neon__prepare_database_migration",
      "mcp__Neon__complete_database_migration",
      "mcp__Neon__create_branch",
      "mcp__Neon__create_postgres_database",
      "mcp__Neon__create_postgres_role",
      "mcp__Neon__update_branch",
      "mcp__Neon__update_postgres_database",
      "mcp__Neon__update_postgres_endpoint",
      "mcp__github__merge_pull_request",
      "mcp__github__push_files",
      "mcp__github__create_or_update_file",
      "mcp__github__delete_file",
      "mcp__github__update_pull_request_branch",
      "mcp__github__create_branch",
      "mcp__Vercel__pause_project",
      "mcp__Vercel__unpause_project"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.development.local)",
      "Read(**/.env.production)",
      "Read(**/.env.production.local)",
      "Read(**/.env.test)",
      "Read(**/.env.test.local)",
      "Read(**/.env.staging)",
      "Read(**/.env.preview)",
      "Read(**/.env.vercel)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.keystore)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/id_ecdsa)",
      "Read(**/credentials.json)",
      "Read(**/*credentials*.json)",
      "Read(**/service-account*.json)",
      "Read(**/secrets.json)",
      "Read(**/secrets.yaml)",
      "Read(**/secrets.yml)",
      "Read(**/.bash_history)",
      "Read(**/.zsh_history)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.pgpass)",
      "Read(~/.git-credentials)",
      "Read(~/.bash_history)",
      "Read(~/.zsh_history)",
      "Edit(./.claude/settings.json)",
      "Write(./.claude/settings.json)",
      "Edit(./.claude/hooks/**)",
      "Write(./.claude/hooks/**)",
      "Edit(./.mcp.json)",
      "Write(./.mcp.json)",
      "Edit(./scripts/guardrails/**)",
      "Write(./scripts/guardrails/**)",
      "Edit(./.githooks/**)",
      "Write(./.githooks/**)",
      "Edit(./.github/workflows/**)",
      "Write(./.github/workflows/**)",
      "Edit(./packages/db/prisma/migrations/**)",
      "Write(./packages/db/prisma/migrations/**)",
      "Edit(./apps/web/lib/ai-control-plane/**)",
      "Write(./apps/web/lib/ai-control-plane/**)",
      "Edit(./.npmrc)",
      "Write(./.npmrc)",
      "Edit(./.gitignore)",
      "Write(./.gitignore)",
      "Edit(./package-lock.json)",
      "Write(./package-lock.json)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Bash(sudo *)",
      "Bash(su -*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf .git*)",
      "Bash(chmod 777*)",
      "Bash(npx prisma migrate reset*)",
      "Bash(prisma migrate reset*)",
      "Bash(pnpm prisma migrate reset*)",
      "Bash(yarn prisma migrate reset*)",
      "Bash(npm run db:push -- --force-reset*)",
      "Bash(git push --force origin main*)",
      "Bash(git push -f origin main*)",
      "Bash(git push origin +main*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit -n *)",
      "Bash(git config core.hooksPath*)",
      "Bash(git config --global core.hooksPath*)",
      "Bash(npm audit fix --force*)",
      "mcp__Neon__delete_project",
      "mcp__Neon__delete_branch",
      "mcp__Neon__delete_postgres_database",
      "mcp__Neon__delete_postgres_role",
      "mcp__Neon__delete_postgres_endpoint",
      "mcp__Neon__delete_data_api",
      "mcp__Neon__delete_function",
      "mcp__Neon__delete_functions_custom_domain",
      "mcp__Neon__delete_snapshot",
      "mcp__Neon__delete_storage_bucket",
      "mcp__Neon__delete_storage_object",
      "mcp__Neon__delete_storage_objects_by_prefix",
      "mcp__Neon__delete_auth_user",
      "mcp__Neon__delete_auth_oauth_provider",
      "mcp__Neon__delete_auth_trusted_domain",
      "mcp__Neon__reset_from_parent",
      "mcp__Neon__restore_snapshot",
      "mcp__Neon__finalize_branch_restore",
      "mcp__Neon__disable_auth",
      "mcp__Neon__reset_postgres_role_password",
      "mcp__Neon__set_default_branch",
      "mcp__Neon__suspend_postgres_endpoint",
      "mcp__Neon__update_project",
      "mcp__github__create_repository",
      "mcp__github__fork_repository",
      "mcp__Gmail__send_message",
      "mcp__Gmail__forward",
      "mcp__Gmail__trash_message",
      "mcp__Gmail__trash_thread",
      "mcp__Google_Drive__share_file",
      "mcp__Google_Drive__trash_file"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": false,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "git"
    ],
    "network": {
      "allowLocalBinding": true,
      "allowedDomains": [
        "registry.npmjs.org",
        "*.npmjs.org",
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "objects.githubusercontent.com",
        "raw.githubusercontent.com",
        "api.anthropic.com",
        "api.stripe.com",
        "api.vercel.com",
        "vercel.com",
        "*.neon.tech",
        "*.aws.neon.tech",
        "api.the-odds-api.com",
        "site.api.espn.com",
        "www.galaxysportsedge.com",
        "galaxysportsedge.com",
        "oauth2.googleapis.com",
        "json.schemastore.org",
        "binaries.prisma.sh"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/guardrails/agent-bash-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking command safety..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && { [ -d node_modules ] || npm ci --no-audit --no-fund; }",
            "timeout": 600,
            "statusMessage": "Installing dependencies..."
          }
        ]
      }
    ]
  }
}
