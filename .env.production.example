# =====================================================================
# Production environment template — paste into Vercel's env var screen.
#
# Defaults below are calibrated for the 30-day silent-collection phase:
# canonical history starts accumulating, but no public picks, no
# performance stats, no blog, and no paid checkout until you flip the
# relevant gate.
#
# Read docs/launch-prep/01-account-setup.md for where each value comes
# from.
# =====================================================================

# ── Required: database ───────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASS@HOST/DB?sslmode=require
DIRECT_URL=postgresql://USER:PASS@HOST/DB?sslmode=require

# ── Required: auth ───────────────────────────────────────────────────
NEXTAUTH_SECRET=  # openssl rand -base64 32
NEXTAUTH_URL=https://YOUR_DOMAIN_HERE
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Sports data ──────────────────────────────────────────────────────
# Free path works with Odds key ABSENT (ESPN public tertiary + free settle).
# THE_ODDS_API_KEY is optional denser-book enrichment — not required for signal board.
THE_ODDS_API_KEY=
# Optional aliases also accepted: ODDS_API_KEY, THEODDS_API_KEY, FREE_ODDS_API_KEY
# THERUNDOWN_API / RUNDOWN_API_KEY — backup (often 429 on free tier)
# THERUNDOWN_API=

# ── Close-out integrity (keep OFF until measured GREEN×3) ────────────
PERFORMANCE_STATS_ENABLED=false
# LIVE_BOARD=false
CALIBRATION_ADJUSTMENTS_ENABLED=false
CALIBRATION_AUTO_PUBLISH=false
RANKING_PAUSE_APPLY=false
# SELECTIVE_PUBLISH_ENABLED=true
# CRON_REQUIRE_BEARER=false
# AUTONOMY_EXECUTE=false

# ── Required: AI content generation (blog only — never picks) ────────
ANTHROPIC_API_KEY=

# ── Required: background worker queue ────────────────────────────────
REDIS_URL=rediss://default:PASS@HOST:PORT

# ── Required: Stripe (paywall stays off until performance gate opens) ─
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Per-interval price IDs are what checkout actually reads. Set all four. The
# monthly vars fall back to the legacy STRIPE_PRO_PRICE_ID / STRIPE_ELITE_PRICE_ID
# below if left unset, so a monthly-only setup still works.
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_ANNUAL_PRICE_ID=price_...
STRIPE_ELITE_MONTHLY_PRICE_ID=price_...
STRIPE_ELITE_ANNUAL_PRICE_ID=price_...
# Fantasy tier ($4.99/mo · $49/yr Founding) — required before Fantasy checkout works.
# Until these are set, the Fantasy checkout returns a clean 503 (it does not crash).
STRIPE_FANTASY_MONTHLY_PRICE_ID=price_...
STRIPE_FANTASY_ANNUAL_PRICE_ID=price_...
# Legacy single-interval vars (monthly fallback only):
STRIPE_PRO_PRICE_ID=price_...
STRIPE_ELITE_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Projections data provider. Leave UNSET for the honest default (projections render
# as "illustrative"). Setting it opts into a live source; it does NOT flip
# canPublishProjections, which stays a separate proof-gated decision.
PROJECTIONS_PROVIDER=

# ── Required: app config ──────────────────────────────────────────────
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://YOUR_DOMAIN_HERE

# ── Required: cron token (Vercel calls /api/cron/* with this) ─────────
# Generate a strong random value (openssl rand -hex 32). Vercel sends it
# as Authorization: Bearer <token>; the cron routes verify it before
# kicking off work.
CRON_SECRET=

# ── Bootstrap progression — leave defaults until prerequisites met ────
CANONICAL_HISTORY_ENABLED=true
DERIVED_MODEL_HISTORY_ENABLED=false
PUBLIC_PICKS_ENABLED=false
FEATURED_PICK_PROMOTION_ENABLED=false
PERFORMANCE_STATS_ENABLED=false
PUBLIC_BLOG_ENABLED=false
OUTCOME_LEARNING_ENABLED=false

# ── Display + data-quality knobs ──────────────────────────────────────
CONFIDENCE_DISPLAY_MODE=labels
MIN_DATA_QUALITY_FOR_GAME_LOG=40
MIN_SETTLED_PICKS_FOR_LEARNING=100

# ── Safety: ensure dev shortcuts never run in production ──────────────
DEV_FAKE_ADMIN=false
DEMO_PICKS_ENABLED=false
DEV_ADMIN_EMAIL=

# ── Analytics (free, cookieless — Cloudflare Web Analytics + Microsoft Clarity) ─
NEXT_PUBLIC_ANALYTICS_ENABLED=true
NEXT_PUBLIC_CF_BEACON_TOKEN=  # from Cloudflare dash → Web Analytics → your site
NEXT_PUBLIC_CLARITY_PROJECT_ID=  # from clarity.microsoft.com → your project

# ── Internal-LLM tier (Groq free tier — non-user-facing work off Claude ~85% cheaper) ─
INTERNAL_LLM_BASE_URL=https://api.groq.com/openai/v1
INTERNAL_LLM_MODEL=llama-3.3-70b-versatile
INTERNAL_LLM_API_KEY=   # paste from console.groq.com/keys# ── Optional: scheduled backtest harness (continuous calibration re-proof) ─
# OFF by default and NOT registered in vercel.json's crons array. Flip both
# this AND the vercel.json cron entry to activate — see
# reports/ops/backtest-harness-cron.md for the exact entry.
BACKTEST_HARNESS_ENABLED=false
BACKTEST_HARNESS_OUTPUT_DIR=

