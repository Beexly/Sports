{
  "name": "galaxy-sports-edge",
  "private": true,
  "scripts": {
    "dev:web": "next dev apps/web",
    "build:web": "next build apps/web",
    "test:web": "vitest run --config apps/web/vitest.config.ts",
    "typecheck:web": "tsc -p apps/web/tsconfig.json --noEmit",
    "smoke:prod": "powershell -ExecutionPolicy Bypass -File ./scripts/smoke-prod.ps1",
    "validate:monetization": "powershell -ExecutionPolicy Bypass -File ./docs/monetization-v3/tools/validate-monetization-v3.ps1",
    "check:env": "powershell -ExecutionPolicy Bypass -File ./scripts/check-env-contract.ps1",
    "audit:launch": "powershell -ExecutionPolicy Bypass -File ./scripts/audit-launch-readiness.ps1"
  },
  "dependencies": {
    "next": "^16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
