{
  "name": "sports-prediction-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "workers/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "start": "npm run start --workspace=apps/web",
    "test": "npm run test --workspaces --if-present",
    "test:watch": "npm run test:watch --workspace=apps/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace=packages/db",
    "db:push": "npm run db:push --workspace=packages/db",
    "db:migrate": "npm run db:migrate --workspace=packages/db",
    "db:seed": "npm run db:seed --workspace=packages/db",
    "db:studio": "npm run db:studio --workspace=packages/db",
    "build:packages": "npm run build --workspace=packages/types && npm run build --workspace=packages/db && npm run build --workspace=packages/prediction-engine && npm run build --workspace=packages/data-ingestion && npm run build --workspace=packages/ingestion-pipeline",
    "build:workers": "npm run build --workspace=workers/data-refresh && npm run build --workspace=workers/content-publishing",
    "workers:refresh": "node workers/data-refresh/dist/index.js",
    "workers:picks": "node workers/pick-generation/dist/index.js",
    "workers:content": "node workers/content-publishing/dist/index.js"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
