{
  "$schema": "https://developers.cloudflare.com/workers/configuration-schema.json",
  "name": "gse-pick-generation",
  "account_id": "46f1c1d1c65d19f3f983713b3a8ab67c",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "limits": {
    "cpu_ms": 15000
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },
  "queues": {
    "consumers": [
      {
        "queue": "gse-pick-refresh-queue",
        "max_batch_size": 10,
        "max_batch_timeout": 15
      }
    ]
  },
  "vars": {
    "ORIGIN_URL": "https://www.galaxysportsedge.com",
    "STAGE5_GATE_REQUIRED": "true"
  }
}
