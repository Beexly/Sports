{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gse-immortal-orchestrator",
  "account_id": "46f1c1d1c65d19f3f983713b3a8ab67c",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-19",
  "compatibility_flags": ["nodejs_compat"],
  "limits": {
    "cpu_ms": 2000
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "IMMORTAL_CONTROL_AGENT",
        "class_name": "ImmortalControlAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ImmortalControlAgent"]
    }
  ],
  "triggers": {
    "crons": ["0 10 * * 2", "*/15 * * * *"]
  }
}
