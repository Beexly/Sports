{
  "$schema": "https://developers.cloudflare.com/workers/configuration-schema.json",
  "name": "gse-twitter-bot",
  "account_id": "46f1c1d1c65d19f3f983713b3a8ab67c",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "limits": {
    "cpu_ms": 5000
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "vars": {
    "MUTE_BOT": "true",
    "MUSE_X_PUBLISH_APPROVED": "false",
    "DRAFT_ONLY": "true",
    "ORIGIN_URL": "https://www.galaxysportsedge.com"
  }
}
