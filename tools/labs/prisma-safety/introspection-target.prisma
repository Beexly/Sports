generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String                @id @default(cuid())
  name             String?
  email            String                @unique
  emailVerified    DateTime?
  image            String?
  role             UserRole              @default(USER)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  accounts         Account[]
  alerts           Alert[]
  claudeApiCalls   ClaudeApiCallRecord[]
  sessions         Session[]
  subscription     Subscription?
  watchlistEntries Watchlist[]

  @@index([email])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  stripeCustomerId     String             @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  tier                 SubscriptionTier   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  canceledAt           DateTime?
  pastDueSince         DateTime?
  trialStart           DateTime?
  trialEnd             DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  webhookEvents        WebhookEvent[]

  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@map("subscriptions")
}

model WebhookEvent {
  id             String        @id @default(cuid())
  stripeEventId  String        @unique
  type           String
  subscriptionId String?
  payload        Json
  processedAt    DateTime      @default(now())
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([stripeEventId])
  @@map("webhook_events")
}

model Sport {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  displayName String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  games       Game[]
  leagues     League[]

  @@map("sports")
}

model League {
  id          String   @id @default(cuid())
  sportId     String
  key         String   @unique
  name        String
  displayName String
  country     String?
  season      String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  games       Game[]
  sport       Sport    @relation(fields: [sportId], references: [id])
  teams       Team[]

  @@index([sportId])
  @@map("leagues")
}

model Team {
  id           String   @id @default(cuid())
  leagueId     String?
  name         String
  abbreviation String?
  city         String?
  logoUrl      String?
  createdAt    DateTime @default(now())
  awayGames    Game[]   @relation("AwayTeam")
  homeGames    Game[]   @relation("HomeTeam")
  league       League?  @relation(fields: [leagueId], references: [id])

  @@index([leagueId])
  @@index([name])
  @@map("teams")
}

model Game {
  id                   String                @id @default(cuid())
  externalId           String                @unique
  sportId              String
  leagueId             String?
  homeTeamId           String?
  awayTeamId           String?
  homeTeamName         String
  awayTeamName         String
  commenceTime         DateTime
  status               GameStatus            @default(SCHEDULED)
  homeScore            Int?
  awayScore            Int?
  resultFetched        Boolean               @default(false)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  restDaysHome         Int?
  restDaysAway         Int?
  isBackToBackHome     Boolean               @default(false)
  isBackToBackAway     Boolean               @default(false)
  scheduleDensityHome  Int?
  scheduleDensityAway  Int?
  openingSpread        Float?
  openingTotal         Float?
  lineMovementSpread   Float?
  lineMovementTotal    Float?
  bookmakerCoverageMax Int                   @default(0)
  dataQualityScore     Float                 @default(0)
  currentEdgeIndex     Float?
  contextComputedAt    DateTime?
  claudeApiCalls       ClaudeApiCallRecord[]
  creatorAssets        CreatorAsset[]
  gameSignals          GameSignal[]
  awayTeam             Team?                 @relation("AwayTeam", fields: [awayTeamId], references: [id])
  homeTeam             Team?                 @relation("HomeTeam", fields: [homeTeamId], references: [id])
  league               League?               @relation(fields: [leagueId], references: [id])
  sport                Sport                 @relation(fields: [sportId], references: [id])
  gateDecisions        GateDecision[]
  odds                 Odds[]
  oddsLineSnapshots    OddsLineSnapshot[]
  openingLines         OpeningLine[]
  pickSignalSnapshots  PickSignalSnapshot[]
  picks                Pick[]
  teamGameLogs         TeamGameLog[]

  @@index([sportId])
  @@index([commenceTime])
  @@index([status])
  @@map("games")
}

model OpeningLine {
  id          String     @id @default(cuid())
  gameId      String
  market      OddsMarket
  spread      Float?
  total       Float?
  homePrice   Float?
  awayPrice   Float?
  firstSeenAt DateTime   @default(now())
  game        Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, market])
  @@index([gameId])
  @@map("opening_lines")
}

model TeamGameLog {
  id            String        @id @default(cuid())
  teamName      String
  sport         String
  gameId        String
  opponentName  String
  isHome        Boolean
  gameDate      DateTime
  teamScore     Int?
  opponentScore Int?
  result        GameLogResult @default(TBD)
  spread        Float?
  atsResult     AtsResult     @default(TBD)
  createdAt     DateTime      @default(now())
  isBootstrap   Boolean       @default(true)
  game          Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, teamName])
  @@index([teamName, sport, gameDate])
  @@index([gameId])
  @@map("team_game_logs")
}

model Odds {
  id              String       @id @default(cuid())
  gameId          String
  ingestionRunId  String
  bookmaker       String
  market          OddsMarket
  homePrice       Float?
  awayPrice       Float?
  drawPrice       Float?
  spread          Float?
  homeSpreadPrice Float?
  awaySpreadPrice Float?
  total           Float?
  overPrice       Float?
  underPrice      Float?
  fetchedAt       DateTime
  createdAt       DateTime     @default(now())
  game            Game         @relation(fields: [gameId], references: [id])
  ingestionRun    IngestionRun @relation(fields: [ingestionRunId], references: [id])

  @@index([gameId])
  @@index([ingestionRunId])
  @@index([fetchedAt])
  @@index([gameId, fetchedAt])
  @@map("odds")
}

model OddsLineSnapshot {
  id         String   @id @default(cuid())
  gameId     String
  capturedAt DateTime
  phase      String
  book       String
  market     String
  side       String
  price      Float
  line       Float?
  source     String
  createdAt  DateTime @default(now())
  game       Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId, market, capturedAt])
  @@index([phase, capturedAt])
  @@map("odds_line_snapshots")
}

model IngestionRun {
  id              String           @id @default(cuid())
  sport           String?
  status          IngestionStatus  @default(RUNNING)
  gamesUpserted   Int              @default(0)
  oddsInserted    Int              @default(0)
  errorMessage    String?
  startedAt       DateTime         @default(now())
  completedAt     DateTime?
  odds            Odds[]
  sourceSnapshots SourceSnapshot[]

  @@index([status])
  @@index([startedAt])
  @@index([status, completedAt])
  @@map("ingestion_runs")
}

model Pick {
  id                     String              @id @default(cuid())
  gameId                 String
  ingestionRunId         String?
  pickType               PickType
  selection              String
  line                   Float
  confidence             Int
  edgeScore              Float               @default(0)
  consensusPct           Float               @default(0)
  bookmakerCount         Int                 @default(0)
  tier                   PickTier            @default(FREE)
  pickGrade              PickGrade           @default(LEAN)
  riskLevel              RiskLevel           @default(MODERATE)
  reasoning              String
  reasoningShort         String              @default("")
  factorBreakdown        Json?
  modelVersion           String
  generatedAt            DateTime            @default(now())
  dataFreshnessAt        DateTime?
  result                 PickResult          @default(PENDING)
  settledAt              DateTime?
  isPublished            Boolean             @default(true)
  isFeatured             Boolean             @default(false)
  clvLockLine            Float?
  clvLockPrice           Int?
  clvCloseLine           Float?
  clvClosePrice          Int?
  clvKind                String?
  clvValue               Float?
  clvVerdict             String?
  clvCapturedAt          DateTime?
  clvGradedAt            DateTime?
  bookDisagreementAtLock Float?
  isBootstrap            Boolean             @default(true)
  creatorAssets          CreatorAsset[]
  gateDecisions          GateDecision[]
  lossAutopsy            LossAutopsy?
  proofReceipt           PickProofReceipt?
  signalSnapshot         PickSignalSnapshot?
  game                   Game                @relation(fields: [gameId], references: [id])

  @@unique([gameId, pickType])
  @@index([tier])
  @@index([pickGrade])
  @@index([generatedAt])
  @@index([result])
  @@index([isFeatured])
  @@index([clvVerdict])
  @@index([settledAt])
  @@map("picks")
}

model PickProofReceipt {
  id             String           @id @default(cuid())
  pickId         String           @unique
  payload        String
  contentHash    String
  marketFairProb Float
  confidence     Int
  edgeScore      Float
  modelProb      Float?
  entryOdds      Int
  line           Float
  modelVersion   String
  asOf           DateTime
  frozenAt       DateTime         @default(now())
  slateKey       String?
  pick           Pick             @relation(fields: [pickId], references: [id])
  slate          SlateCommitment? @relation(fields: [slateKey], references: [slateKey])

  @@index([contentHash])
  @@index([slateKey])
  @@map("pick_proof_receipts")
}

model SlateCommitment {
  id                     String             @id @default(cuid())
  slateKey               String             @unique
  root                   String
  count                  Int
  committedAt            DateTime
  pedersenAggregateHex   String?
  pedersenAggregateValue String?
  pedersenBlindingSum    String?
  createdAt              DateTime           @default(now())
  receipts               PickProofReceipt[]

  @@index([committedAt])
  @@map("slate_commitments")
}

model GateDecision {
  id           String             @id @default(cuid())
  gameId       String
  pickId       String?
  status       GateDecisionStatus
  reason       String             @db.VarChar(240)
  reasonCode   String             @db.VarChar(80)
  edgeIndex    Float?
  confidence   Int?
  modelVersion String
  isBootstrap  Boolean            @default(true)
  evaluatedAt  DateTime           @default(now())
  evidenceRefs Json?
  game         Game               @relation(fields: [gameId], references: [id], onDelete: Cascade)
  pick         Pick?              @relation(fields: [pickId], references: [id])

  @@index([gameId])
  @@index([pickId])
  @@index([status, evaluatedAt])
  @@index([isBootstrap])
  @@map("gate_decisions")
}

model LossAutopsy {
  id            String            @id @default(cuid())
  pickId        String            @unique
  authorEmail   String
  authoredAt    DateTime          @default(now())
  status        LossAutopsyStatus @default(DRAFT)
  headline      String            @db.VarChar(140)
  whatWeSaw     String
  whatHappened  String
  whatWeLearned String
  rootCause     LossRootCause
  lessonTags    String[]
  modelVersion  String?
  isPublic      Boolean           @default(false)
  evidenceRefs  Json?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  pick          Pick              @relation(fields: [pickId], references: [id])

  @@index([authoredAt])
  @@index([status])
  @@index([rootCause])
  @@map("loss_autopsies")
}

model SourceSnapshot {
  id             String             @id @default(cuid())
  provider       String
  sourceKind     SourceSnapshotKind
  sport          String?
  externalId     String?
  ingestionRunId String?
  fetchedAt      DateTime
  payload        Json
  payloadHash    String
  payloadBytes   Int                @default(0)
  createdAt      DateTime           @default(now())
  ingestionRun   IngestionRun?      @relation(fields: [ingestionRunId], references: [id])

  @@index([provider, sourceKind])
  @@index([sport])
  @@index([externalId])
  @@index([fetchedAt])
  @@index([payloadHash])
  @@map("source_snapshots")
}

model GameSignal {
  id             String         @id @default(cuid())
  gameId         String
  sourceCategory SignalCategory
  sourceName     String
  signalKey      String
  signalValue    Json
  fetchedAt      DateTime
  expiresAt      DateTime?
  trustLevel     Float          @default(1.0)
  isBootstrap    Boolean        @default(true)
  createdAt      DateTime       @default(now())
  game           Game           @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, sourceName, signalKey])
  @@index([gameId, sourceCategory])
  @@index([fetchedAt])
  @@map("game_signals")
}

model PickSignalSnapshot {
  id                        String    @id @default(cuid())
  pickId                    String    @unique
  gameId                    String
  capturedAt                DateTime  @default(now())
  hadOddsSignal             Boolean   @default(false)
  hadLineMovementSignal     Boolean   @default(false)
  hadRestSignal             Boolean   @default(false)
  hadScheduleSignal         Boolean   @default(false)
  hadAtsFormSignal          Boolean   @default(false)
  hadH2HSignal              Boolean   @default(false)
  hadVenueSignal            Boolean   @default(false)
  hadWeatherSignal          Boolean   @default(false)
  hadInjurySignal           Boolean   @default(false)
  hadRatingsSignal          Boolean   @default(false)
  hadPlayerSignal           Boolean   @default(false)
  hadOfficialsSignal        Boolean   @default(false)
  hadVenueEnvironmentSignal Boolean   @default(false)
  hadPaceSignal             Boolean   @default(false)
  hadMilestoneSignal        Boolean   @default(false)
  bookmakerCount            Int       @default(0)
  dataQualityScore          Float     @default(0)
  confidenceAtPrediction    Int       @default(0)
  lineMovementDelta         Float?
  restAdvantageNet          Int?
  atsFormSampleSize         Int?
  h2hSampleSize             Int?
  scheduleDensityHome       Int?
  scheduleDensityAway       Int?
  isBootstrap               Boolean   @default(true)
  usedDerivedHistory        Boolean   @default(false)
  usedScheduleSignal        Boolean   @default(false)
  modelVersion              String    @default("")
  settlementResult          String?
  settledAt                 DateTime?
  eligibleForLearning       Boolean   @default(false)
  learningEligibleAt        DateTime?
  game                      Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  pick                      Pick      @relation(fields: [pickId], references: [id], onDelete: Cascade)

  @@index([gameId])
  @@index([capturedAt])
  @@index([eligibleForLearning])
  @@index([isBootstrap])
  @@map("pick_signal_snapshots")
}

model BlogPost {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  excerpt        String
  content        String
  sport          String?
  tags           String[]
  seoTitle       String?
  seoDescription String?
  isFeatured     Boolean       @default(false)
  status         ContentStatus @default(DRAFT)
  relatedPickIds String[]
  generatedBy    String        @default("system")
  modelVersion   String?
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
  @@index([publishedAt])
  @@index([sport])
  @@map("blog_posts")
}

model Alert {
  id        String       @id @default(cuid())
  userId    String
  sport     String?
  league    String?
  threshold Int          @default(70)
  channel   AlertChannel @default(EMAIL)
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("alerts")
}

model Watchlist {
  id         String   @id @default(cuid())
  userId     String
  entityType String
  entityId   String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId])
  @@index([userId])
  @@map("watchlist_entries")
}

model PerformanceSummary {
  id           String    @id @default(cuid())
  sport        String
  league       String?
  pickType     PickType?
  tier         PickTier?
  modelVersion String
  totalPicks   Int       @default(0)
  wins         Int       @default(0)
  losses       Int       @default(0)
  pushes       Int       @default(0)
  winRate      Float     @default(0)
  period       String
  computedAt   DateTime  @default(now())

  @@unique([sport, pickType, tier, modelVersion, period])
  @@index([sport])
  @@map("performance_summaries")
}

model JarvisMemoryEvent {
  id                   String              @id @default(cuid())
  memory_type          MemoryType
  memory_state         MemoryState         @default(candidate)
  scope                String
  title                String
  summary              String
  full_text            String?
  source_type          String
  source_ref           String?
  source_timestamp     DateTime?
  actor                String
  owner                String
  confidence           Int
  sensitivity          String              @default("normal")
  tags                 String[]
  related_decision_id  String?
  related_agent_id     String?
  supersedes_memory_id String?
  expires_at           DateTime?
  created_at           DateTime            @default(now())
  updated_at           DateTime            @updatedAt
  confirmed_at         DateTime?
  rejected_at          DateTime?
  embedding_ref        String?
  metadata             Json?
  owner_approval       Boolean             @default(false)
  /// Optional link to the SubagentRun that created this memory candidate.
  related_agent_run_id String?
  agent_run            SubagentRun?        @relation("MemoryAgentRunLink", fields: [related_agent_run_id], references: [id])
  supersedes           JarvisMemoryEvent?  @relation("MemorySupersession", fields: [supersedes_memory_id], references: [id])
  superseded_by        JarvisMemoryEvent[] @relation("MemorySupersession")
  decisions            JarvisDecision[]    @relation("MemoryDecisionLink")

  @@index([memory_state])
  @@index([memory_type])
  @@index([scope])
  @@index([created_at])
  @@map("jarvis_memory_events")
}

model JarvisDecision {
  id                    String              @id @default(cuid())
  decision_title        String
  decision_summary      String
  decision_type         String
  rationale             String
  evidence              Json?
  alternatives_rejected Json?
  owner                 String
  decision_date         DateTime
  revisit_date          DateTime?
  outcome               String?
  status                String              @default("open")
  source_refs           Json?
  created_at            DateTime            @default(now())
  updated_at            DateTime            @updatedAt
  memory_events         JarvisMemoryEvent[] @relation("MemoryDecisionLink")

  @@index([decision_date])
  @@index([status])
  @@map("jarvis_decisions")
}

model AgentHandoff {
  id                      String                @id @default(cuid())
  /// Codename of the council seat initiating the handoff.
  source_seat             String
  /// Codename of the council seat receiving the handoff.
  target_seat             String
  /// Human-readable reason for the handoff.
  reason                  String
  /// Task type from the routing rules (e.g. "pick-research", "settlement").
  task_type               String
  /// Supporting evidence text (urls, data references, test ids).
  evidence_text           String
  risk_level              AgentHandoffRiskLevel @default(low)
  /// Authority tier of the initiating seat (0–4).
  authority_tier          Int
  status                  AgentHandoffStatus    @default(pending)
  /// Whether this handoff requires explicit owner approval before proceeding.
  owner_approval_required Boolean               @default(false)
  /// Outcome narrative once the handoff is resolved — null until then.
  outcome                 String?
  created_at              DateTime              @default(now())
  updated_at              DateTime              @updatedAt

  @@index([source_seat, created_at])
  @@index([target_seat, created_at])
  @@index([status])
  @@index([created_at])
  @@map("agent_handoffs")
}

model SubagentRun {
  id                         String                     @id @default(cuid())
  /// Id of the subagent template that ran (matches SubagentTemplate.id).
  subagent_id                String
  /// Codename of the parent council seat that spawned this subagent.
  parent_seat                String
  /// Narrow task the subagent was given.
  task                       String
  /// Context provided as input to the subagent.
  input_context              String
  /// Reference to the draft artifact the subagent produced (path, id, or url).
  output_artifact_ref        String
  /// Confidence score 0–100 in the output.
  confidence                 Int
  /// Explicit uncertainty statement about the output.
  uncertainty                String
  /// Supporting evidence for the output.
  evidence                   String[]
  /// True = prohibited-actions check passed; false = violation detected.
  prohibited_actions_checked Boolean                    @default(false)
  /// Parent seat's review status — pending until parent explicitly reviews.
  parent_review_status       SubagentParentReviewStatus @default(pending_review)
  created_at                 DateTime                   @default(now())
  updated_at                 DateTime                   @updatedAt
  memory_events              JarvisMemoryEvent[]        @relation("MemoryAgentRunLink")

  @@index([subagent_id, created_at])
  @@index([parent_seat, created_at])
  @@index([parent_review_status])
  @@index([created_at])
  @@map("subagent_runs")
}

model CockpitTask {
  id               String                  @id @default(cuid())
  title            String
  description      String
  assignedAgent    OperatorAgent
  status           CockpitTaskStatus       @default(NEW)
  priority         Int                     @default(50)
  riskLevel        CockpitRiskLevel        @default(LOW)
  complianceStatus CockpitComplianceStatus @default(NOT_APPLICABLE)
  source           String
  payload          Json?
  decisionNotes    String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  decisions        CockpitDecision[]

  @@index([assignedAgent])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@map("cockpit_tasks")
}

model CockpitDecision {
  id        String            @id @default(cuid())
  taskId    String
  toStatus  CockpitTaskStatus
  reviewer  String
  note      String?
  evidence  Json?
  createdAt DateTime          @default(now())
  task      CockpitTask       @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("cockpit_decisions")
}

model CockpitMediaItem {
  id               String                  @id @default(cuid())
  briefTitle       String
  briefBody        String
  channel          String
  draftBody        String?
  qaStatus         String                  @default("DRAFT")
  complianceStatus CockpitComplianceStatus @default(REVIEW_REQUIRED)
  approved         Boolean                 @default(false)
  scheduledFor     DateTime?
  relatedTaskId    String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([qaStatus])
  @@index([complianceStatus])
  @@map("cockpit_media_items")
}

model CreatorAsset {
  id               String                       @id @default(cuid())
  gameId           String
  pickId           String?
  templateKind     CreatorAssetKind
  status           CreatorAssetStatus           @default(DRAFT)
  complianceStatus CreatorAssetComplianceStatus @default(YELLOW)
  title            String
  body             String
  markdown         String
  gateState        String                       @db.VarChar(24)
  citations        Json                         @default("[]")
  complianceFlags  Json                         @default("[]")
  modelVersion     String
  generatedBy      String
  generatedAt      DateTime                     @default(now())
  exportedAt       DateTime?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  game             Game                         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  pick             Pick?                        @relation(fields: [pickId], references: [id])

  @@index([gameId, generatedAt])
  @@index([pickId])
  @@index([templateKind])
  @@index([status])
  @@index([complianceStatus])
  @@map("creator_assets")
}

model ModelJournalEntry {
  id                      String                  @id @default(cuid())
  isoWeek                 Int
  isoYear                 Int
  status                  ModelJournalEntryStatus @default(DRAFT)
  title                   String
  slug                    String                  @unique
  body                    String
  bodyMarkdown            String
  modelVersion            String
  referencedPickIds       String[]
  referencedAutopsyIds    String[]
  referencedFactorChanges Json?
  authorEmail             String
