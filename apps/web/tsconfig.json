{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@sports/types": [
        "../../packages/types/src/index.ts"
      ],
      "@sports/db": [
        "../../packages/db/src/index.ts"
      ],
      "@sports/data-ingestion": [
        "../../packages/data-ingestion/src/index.ts"
      ],
      "@sports/ingestion-pipeline": [
        "../../packages/ingestion-pipeline/src/index.ts"
      ],
      "@sports/ai-council": [
        "../../packages/ai-council/src/index.ts"
      ]
    },
    "baseUrl": ".",
    "ignoreDeprecations": "5.0",
    "declaration": false,
    "declarationMap": false,
    "allowJs": true,
    "skipLibCheck": true,
    "preserveSymlinks": true,
    "noEmit": true,
    "incremental": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/__tests__/**",
    "lib/calibration"
  ]
}
