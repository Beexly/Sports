{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ../.. && npm run db:generate && node scripts/migrate-if-configured.mjs && npm run build --workspace=@sports/web",
  "installCommand": "cd ../.. && npm install --include=dev",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "regions": ["iad1"],
  "crons": [
    {
      "path": "/api/cron/refresh-odds?sport=americanfootball_nfl",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/refresh-odds?sport=americanfootball_ncaaf",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/refresh-odds?sport=basketball_nba",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/refresh-odds?sport=basketball_ncaab",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/refresh-odds?sport=baseball_mlb",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/refresh-odds?sport=icehockey_nhl",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/refresh-odds?sport=soccer_usa_mls",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/settle-picks",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/jarvis-snapshot",
      "schedule": "0 13 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(self \"https://js.stripe.com\")"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    }
  ]
}
