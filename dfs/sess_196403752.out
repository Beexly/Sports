    <style>
        header.sports-header {
            position: fixed;
        }

            header.sports-header .header-inner {
                border-bottom: none;
                height: 53px;
            }

        @media (max-width: 780px) {
            header.sports-header .header-inner {
                height: 45px;
                margin: 0 0 39px 0;
            }
        }

        .classic-lobby-link {
