                            (event.error && event.error.origin) ||
                            null;

                        var target = origin && origin.target;
                        var handledAsResourceLoad = false;

                        if (target) {
                            // <script>/<img>/<link> expose the failing URL on src/href
                            var failedUrl = target.src || target.href || null;
                            var tagName = target.tagName || null;

                            if (failedUrl) {
                                isResourceError = true;

                                event.context = event.context || {};
                                event.context.resource_load_error = {
                                    url: failedUrl,
                                    element: tagName,               // e.g. "SCRIPT"
                                    crossorigin: target.crossOrigin || null
                                };
