    initializeDatadogRUM();

    // Load Failed (Safari) / Failed to Fetch (Chrome) / NetworkError (FireFox) data extension
    (function () {
        if (!window.fetch || window.dkFetchContextInstalled) {
            return;
        }
        window.dkFetchContextInstalled = true;

        var nativeFetch = window.fetch;

        // Failures of the telemetry pipeline itself must not be reported through it.
        var TELEMETRY_HOSTS = ['browser-intake-datadoghq.com', 'datadoghq-browser-agent.com'];

        var OPAQUE_MESSAGES = ['load failed', 'failed to fetch', 'networkerror when attempting'];

        var GUID_SEGMENT = /\/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/gi;

        function isTelemetry(url) {
            for (var i = 0; i < TELEMETRY_HOSTS.length; i++) {
                if (url.indexOf(TELEMETRY_HOSTS[i]) !== -1) {
                    return true;
                }
            }
            return false;
        }

        function readUrl(input) {
            try {
                if (typeof input === 'string') {
                    return input;
                }
                if (input && typeof input.url === 'string') {
                    return input.url;
                }
                return String(input);
            } catch (e) {
                return 'unknown';
            }
        }

        function readMethod(input, init) {
            try {
                if (init && init.method) {
                    return String(init.method).toUpperCase();
                }
                if (input && input.method) {
                    return String(input.method).toUpperCase();
                }
            } catch (e) {
                // fall through to the default
            }
            return 'GET';
        }

        function stripParams(url) {
            var cut = url.length;
            var question = url.indexOf('?');
            var hash = url.indexOf('#');
            if (question !== -1 && question < cut) {
                cut = question;
            }
            if (hash !== -1 && hash < cut) {
                cut = hash;
            }
            return url.substring(0, cut);
        }

        // A per-session guid in the path would produce one Error Tracking issue per
        // session, which is noise rather than signal. Sport, contest and other numeric
        // ids are deliberately left intact.
        function normalizeFingerprintPath(url) {
            try {
                return url.replace(GUID_SEGMENT, '/{guid}');
            } catch (e) {
                return url;
            }
        }

        function dkCallerStack() {
            try {
                var raw = String(new Error().stack || '');
                if (!raw) {
                    return '';
                }

                var lines = raw.split('\n');
                var kept = [];
                for (var i = 0; i < lines.length; i++) {
                    var line = lines[i];
                    // The escape below is the at-sign, written as a unicode escape
                    // because Razor treats a literal at-sign in a .cshtml as the start
                    // of a code block.
                    if (i === 0 && line.indexOf('Error') === 0 && line.indexOf('\u0040') === -1) {
                        continue;
                    }
                    if (line.indexOf('dkCallerStack') !== -1 || line.indexOf('dkWrappedFetch') !== -1) {
                        continue;
                    }
                    kept.push(line);
