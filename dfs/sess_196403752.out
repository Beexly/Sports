    <script>
        // Cross-origin scripts loaded without CORS get their errors censored: window.onerror
        // receives message "Script error." and a null error object. An error caught
        // synchronously inside same-origin code is NOT censored, so wrapping the entry points
        // third parties schedule work through lets us read the real message and stack.
        //
        // Every callback is re-thrown unchanged, so the browser reports exactly what it
        // reports today. Event volume is identical with this file present or absent.
        // The recovered detail is attached to the outgoing event by the beforeSend hook in
        // _DatadogRUM.cshtml, which reads window.dkJsErrorDiagnostics.take().
        (function () {
            if (window.dkJsErrorDiagnosticsInstalled) {
                return;
            }
            window.dkJsErrorDiagnosticsInstalled = true;

            var MAX_QUEUE = 50;
            var MAX_STACK_CHARS = 2000;
            var MAX_AGE_MS = 2000;
            var RECORDED_FLAG = '__dkErrorRecorded';
            var WRAP_STORE = '__dkWrappedListeners';

            var queue = [];
            var overflowCount = 0;
            var recordedTotal = 0;
            var lastRecordedValue = null;

            function nowMs() {
                return (new Date()).getTime();
            }

            function truncate(value, max) {
                var text;
                try {
                    text = String(value === null || value === undefined ? '' : value);
                } catch (e) {
                    return '';
                }
                return text.length > max ? text.substring(0, max) : text;
            }

            // The first absolute URL in the stack identifies the script that actually threw.
            var URL_IN_STACK = /https?:\/\/[^\s)'"]+/;

            function firstUrl(stack) {
                try {
                    var match = URL_IN_STACK.exec(stack || '');
                    return match ? match[0] : '';
                } catch (e) {
                    return '';
                }
            }

            function originOf(url) {
                try {
                    if (!url) {
                        return '';
                    }
                    var afterScheme = url.indexOf('://') + 3;
                    var slash = url.indexOf('/', afterScheme);
                    return slash === -1 ? url : url.substring(0, slash);
                } catch (e) {
                    return '';
                }
            }

            function describeHandler(fn) {
                try {
                    if (typeof fn !== 'function') {
                        return '';
                    }
                    if (fn.name) {
                        return truncate(fn.name, 100);
                    }
                    // Anonymous third-party handlers are common; a short slice of the source
                    // is usually enough to recognise the vendor.
                    return truncate(String(fn).replace(/\s+/g, ' '), 120);
                } catch (e) {
                    return '';
                }
            }

            // Tag name and id only. No class lists, no text content, so no user data.
            function describeTarget(target) {
                try {
                    if (!target) {
                        return '';
                    }
                    if (target === window) {
                        return 'window';
                    }
                    if (target === document) {
                        return 'document';
                    }
                    var name = target.tagName || target.nodeName;
                    var out = name ? String(name).toLowerCase() : 'unknown';
                    if (target.id) {
                        out += '#' + truncate(target.id, 50);
                    }
                    return truncate(out, 100);
                } catch (e) {
                    return '';
                }
            }

            function record(error, source, detail, fn) {
                try {
                    // A nested wrapper can observe the same throw twice. One throw produces
                    // one browser report, so it must produce one queue entry.
                    if (error && typeof error === 'object') {
                        if (error[RECORDED_FLAG]) {
                            return;
                        }
                        try {
                            error[RECORDED_FLAG] = true;
                        } catch (e) {
                            // Frozen or sealed: fall back to identity against the last throw.
                            if (error === lastRecordedValue) {
                                return;
                            }
                        }
                    } else if (error === lastRecordedValue) {
                        // Primitives cannot be flagged.
                        return;
                    }
                    lastRecordedValue = error;

                    var name = '';
                    var message = '';
                    var stack = '';
                    if (error && typeof error === 'object') {
                        name = truncate(error.name, 100);
                        message = truncate(error.message, 500);
                        stack = truncate(error.stack, MAX_STACK_CHARS);
                    } else {
                        name = 'NonErrorThrow';
                        message = truncate(error, 500);
                    }

                    var url = firstUrl(stack);

                    recordedTotal++;

                    // An entry dropped here does not drop an error:
                    // the event is still reported, just un-enriched.
                    if (queue.length >= MAX_QUEUE) {
                        queue.shift();
                        overflowCount++;
                    }

                    queue.push({
                        t: nowMs(),
                        source: source,
                        detail: detail || '',
                        handler: describeHandler(fn),
                        name: name,
                        message: message,
                        stack: stack,
                        scriptUrl: truncate(url, 300),
                        scriptOrigin: originOf(url)
                    });
                } catch (e) {
                    // Diagnostics must never affect the page.
                }
            }

            function prune(now) {
                while (queue.length && (now - queue[0].t) > MAX_AGE_MS) {
                    queue.shift();
                }
            }

            // Called once per RUM error event, from beforeSend. FIFO, because a throw is
            // reported before the next task runs, so ordering is 1:1 in the normal case.
            function take() {
                try {
                    var now = nowMs();
                    prune(now);
                    if (!queue.length) {
                        return null;
                    }

                    var pendingAtTake = queue.length;
                    var entry = queue.shift();

                    var others = [];
                    for (var i = 0; i < queue.length && i < 3; i++) {
                        others.push(queue[i].message);
                    }

                    return {
                        entry: entry,
                        ageMs: now - entry.t,
                        pendingAtTake: pendingAtTake,
                        otherPending: others,
                        confidence: pendingAtTake === 1 ? 'high' : 'low',
                        overflowCount: overflowCount,
                        recordedTotal: recordedTotal
                    };
                } catch (e) {
                    return null;
                }
            }

            function toArray(argsLike) {
                var out = [];
                for (var i = 0; i < argsLike.length; i++) {
                    out.push(argsLike[i]);
                }
                return out;
            }

            function wrapCallback(fn, source, detail) {
                return function dkDiagnosticsCallback() {
                    try {
                        return fn.apply(this, arguments);
                    } catch (error) {
                        record(error, source, detail, fn);
                        // Unchanged, so the browser reports it exactly as it would without
                        // this file. This is what keeps the volume identical.
                        throw error;
                    }
                };
            }

            function wrapListener(listener, type) {
                return function dkDiagnosticsListener() {
                    try {
                        return listener.apply(this, arguments);
                    } catch (error) {
                        record(error, 'addEventListener',
                            String(type) + ' ' + describeTarget(this), listener);
                        throw error;
                    }
                };
            }

            function wrapScheduler(holder, methodName) {
                var native = holder[methodName];
                if (typeof native !== 'function') {
                    return;
                }
                holder[methodName] = function () {
                    var args = toArray(arguments);
                    // A string first argument is eval'd by the browser, so it cannot be wrapped.
                    if (typeof args[0] === 'function') {
                        args[0] = wrapCallback(args[0], methodName, '');
                    }
                    return native.apply(holder, args);
                };
            }

            function captureFlag(options) {
                if (typeof options === 'boolean') {
                    return options;
                }
                if (options && typeof options === 'object') {
                    return !!options.capture;
                }
                return false;
            }

            function storeKey(type, options) {
                return String(type) + '|' + (captureFlag(options) ? 'c' : 'b');
            }

            function wrapEventTarget(proto) {
                if (!proto || typeof proto.addEventListener !== 'function') {
                    return;
                }

                var nativeAdd = proto.addEventListener;
                var nativeRemove = proto.removeEventListener;

                proto.addEventListener = function (type, listener, options) {
                    // Objects implementing handleEvent, and anything unexpected, pass through.
                    if (typeof listener !== 'function') {
                        return nativeAdd.apply(this, arguments);
                    }

                    var store;
                    try {
                        store = listener[WRAP_STORE];
                        if (!store) {
                            store = {};
                            listener[WRAP_STORE] = store;
                        }
                    } catch (e) {
                        // Frozen listener: register it untouched rather than risk behaviour.
                        return nativeAdd.apply(this, arguments);
                    }

                    var key = storeKey(type, options);
                    var wrapped = store[key];
                    if (!wrapped) {
                        // One wrapper per listener, type and phase. Reusing it keeps the DOM's
                        // "registering the same listener twice is a no-op" rule intact â€” a
                        // fresh wrapper each call would double the invocations.
                        wrapped = wrapListener(listener, type);
                        store[key] = wrapped;
                    }

                    var args = toArray(arguments);
                    args[1] = wrapped;
                    return nativeAdd.apply(this, args);
                };

                if (typeof nativeRemove !== 'function') {
                    return;
                }

                // removeEventListener is given the original listener, which is not what was
                // registered. Without this, removal would silently stop working.
                proto.removeEventListener = function (type, listener, options) {
                    var wrapped = null;
                    try {
                        var store = listener && listener[WRAP_STORE];
                        if (store) {
                            var key = storeKey(type, options);
                            wrapped = store[key] || null;
                            if (wrapped) {
                                delete store[key];
                            }
                        }
                    } catch (e) {
                        wrapped = null;
                    }

                    if (wrapped) {
                        var args = toArray(arguments);
                        args[1] = wrapped;
                        nativeRemove.apply(this, args);
                    }

                    // Also remove the original: a no-op when it was never registered directly.
                    return nativeRemove.apply(this, arguments);
                };
            }

            try {
                wrapScheduler(window, 'setTimeout');
                wrapScheduler(window, 'setInterval');
                wrapScheduler(window, 'requestAnimationFrame');
            } catch (e) {
                // Leave the natives alone if anything here fails.
            }

            try {
                if (window.EventTarget && window.EventTarget.prototype) {
                    wrapEventTarget(window.EventTarget.prototype);
                }
            } catch (e) {
                // Ditto.
            }

            window.dkJsErrorDiagnostics = {
                take: take,
                pending: function () {
                    return queue.length;
                },
                stats: function () {
                    return {
                        pending: queue.length,
                        overflowCount: overflowCount,
                        recordedTotal: recordedTotal
                    };
                }
            };
        })();
    </script>






