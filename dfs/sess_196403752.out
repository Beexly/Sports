        if(envValue === 'production' || envValue === 'prod') {
            envValue = 'prod';
        }

        var isVipValue = true;

        window.DD_RUM && window.DD_RUM.init({
          clientToken: 'pub8ad058e2cad0398b000f17e802c832d4',
          applicationId: 'b8858df3-1bb9-49e8-af21-ad1c67cae28d',
          site: 'datadoghq.com',
          service: 'mvc-web',
          env: envValue,
          version: '283.13.0.0',
          sessionSampleRate: sampleRates.session,
          sessionReplaySampleRate: 0,
          trackBfcacheViews: true,
          defaultPrivacyLevel: 'mask-user-input',
          beforeSend: function (event, context) {
