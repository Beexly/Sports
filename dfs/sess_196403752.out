<script>
    // Read Datadog sample rates from Web.config
    function getDatadogSampleRates() {
        var sessionSampleRate = 1; // Default

        // Parse session sample rate
        var sessionRateStr = '100';
        if (sessionRateStr && sessionRateStr !== '') {
            var parsedSessionRate = parseInt(sessionRateStr, 10);
            if (!isNaN(parsedSessionRate) && parsedSessionRate >= 0 && parsedSessionRate <= 100) {
                sessionSampleRate = parsedSessionRate;
            }
        }

        return {
            session: sessionSampleRate,
        };
    }

    function initializeDatadogRUM() {
        // Prevent duplicate initialization
        if (window.DD_RUM && window.DD_RUM.getInternalContext()) {
            return;
        }

