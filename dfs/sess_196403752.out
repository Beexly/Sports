    <style>
        #dkjs-subnav {
            height: 44px;
            background-color: #1d1c1e;
            margin-top: 21px;
        }

        header.sports-header {
            max-height: 102px;
            position: fixed;
        }

        .dk-body-wrap {
            padding-top: 90px;
        }

        .lobbyRowExperimentGreen {
            color: #ffffff !important;
            background-color: #5EAD00 !important;
        }

            .lobbyRowExperimentGreen .icon-lineups:before {
                color: #5EAD00;
            }

            .lobbyRowExperimentGreen .dk-btn {
                color: #5EAD00 !important;
                background-image: none !important;
                background-color: #ffffff;
            }

            .lobbyRowExperimentGreen:hover {
                background-color: #7EBD33 !important;
            }

            .lobbyRowExperimentGreen .slick-cell.flash-3 {
                color: #FFEB3B !important;
                background-color: #66B900 !important;
            }

                .lobbyRowExperimentGreen .slick-cell.flash-3 a, .lobbyRowExperimentGreen .slick-cell.flash-3 span {
                    color: #FFEB3B !important;
                }

            .lobbyRowExperimentGreen span, .lobbyRowExperimentGreen a {
                color: #ffffff !important;
            }

        .lobbyRowExperimentOrange {
            color: #ffffff !important;
            background-color: #FF6D00 !important;
        }

            .lobbyRowExperimentOrange svg {
                fill: #ffffff !important;
            }

            .lobbyRowExperimentOrange .icon-lineups:before {
                color: #FF6D00;
            }

            .lobbyRowExperimentOrange .dk-btn {
                color: #FF6D00 !important;
                background-image: none !important;
                background-color: #ffffff;
            }

            .lobbyRowExperimentOrange:hover {
                background-color: #FF8A33 !important;
            }

            .lobbyRowExperimentOrange .slick-cell.flash-3 {
                color: #FFEB3B !important;
                background-color: #FF7F1F !important;
            }

                .lobbyRowExperimentOrange .slick-cell.flash-3 a, .lobbyRowExperimentGreen .slick-cell.flash-3 span {
                    color: #FFEB3B !important;
                }

            .lobbyRowExperimentOrange span, .lobbyRowExperimentOrange a {
                color: #ffffff !important;
            }

        .lobbyRowExperimentText {
            color: #FF6D00 !important;
        }

            .lobbyRowExperimentText .dk-btn {
                color: #FFFFFF !important;
            }

            .lobbyRowExperimentText:hover {
                background-color: #FFFFFF !important;
            }

            .lobbyRowExperimentText .slick-cell.flash-3 {
                color: #FF9800 !important;
                background-color: #FFFFFF !important;
            }

                .lobbyRowExperimentText .slick-cell.flash-3 a, .lobbyRowExperimentGreen .slick-cell.flash-3 span {
                    color: #FF9800 !important;
                }

            .lobbyRowExperimentText span, .lobbyRowExperimentText a {
                color: #FF6D00 !important;
            }
    </style>
