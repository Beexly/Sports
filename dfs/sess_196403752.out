            try {
                wrapScheduler(window, 'setTimeout');
                wrapScheduler(window, 'setInterval');
                wrapScheduler(window, 'requestAnimationFrame');
            } catch (e) {
                // Leave the natives alone if anything here fails.
            }

            try {
                if (window.EventTarget && window.EventTarget.prototype) {
                    wrapEventTarget(window.EventTarget.prototype);
                }
            } catch (e) {
                // Ditto.
            }

            window.dkJsErrorDiagnostics = {
                take: take,
                pending: function () {
                    return queue.length;
                },
                stats: function () {
                    return {
                        pending: queue.length,
                        overflowCount: overflowCount,
                        recordedTotal: recordedTotal
                    };
                }
            };
        })();
