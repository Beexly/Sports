                                    source: d.source,
                                    detail: d.detail,
                                    handler: d.handler,
                                    recovered_name: d.name,
                                    recovered_message: d.message,
                                    script_url: d.scriptUrl,
                                    script_origin: d.scriptOrigin,
                                    age_ms: recovered.ageMs,
                                    confidence: recovered.confidence,
                                    pending_at_take: recovered.pendingAtTake,
                                    other_pending: recovered.otherPending,
                                    overflow_count: recovered.overflowCount,
                                    recorded_total: recovered.recordedTotal
                                };

                                // Only rewrite a censored/blank message, and only when the
                                // match is unambiguous, so a real message is never mislabeled.
                                if (event.error && recovered.confidence === 'high') {
                                    var current = String(event.error.message || '');
