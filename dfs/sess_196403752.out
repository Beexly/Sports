    <script>
        // Cross-origin scripts loaded without CORS get their errors censored: window.onerror
        // receives message "Script error." and a null error object. An error caught
        // synchronously inside same-origin code is NOT censored, so wrapping the entry points
        // third parties schedule work through lets us read the real message and stack.
        //
        // Every callback is re-thrown unchanged, so the browser reports exactly what it
        // reports today. Event volume is identical with this file present or absent.
        // The recovered detail is attached to the outgoing event by the beforeSend hook in
        // _DatadogRUM.cshtml, which reads window.dkJsErrorDiagnostics.take().
        (function () {
            if (window.dkJsErrorDiagnosticsInstalled) {
                return;
            }
            window.dkJsErrorDiagnosticsInstalled = true;

            var MAX_QUEUE = 50;
            var MAX_STACK_CHARS = 2000;
            var MAX_AGE_MS = 2000;
            var RECORDED_FLAG = '__dkErrorRecorded';
            var WRAP_STORE = '__dkWrappedListeners';

