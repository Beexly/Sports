# Bazel Build Optimization Configuration (bazel-build-optimization)
# Configures platform-specific toolchains, 75% host resource bounds, disk/repo cache,
# remote gRPC cache/execution profiles, and LCOV coverage instrumentation.

build --enable_platform_specific_config
build --incompatible_enable_cc_toolchain_resolution
build --experimental_strict_conflict_checks

# Resource utilization & parallelism
build --jobs=auto
build --local_cpu_resources=HOST_CPUS*.75
build --local_ram_resources=HOST_RAM*.75

# Local disk & repository caching
build --disk_cache=~/.cache/bazel-disk
build --repository_cache=~/.cache/bazel-repo

# Remote caching & execution profiles
build:remote-cache --remote_cache=grpcs://remotebuildexecution.googleapis.com
build:remote-cache --remote_upload_local_results=true
build:remote-cache --remote_timeout=3600

build:remote-exec --remote_executor=grpcs://remotebuildexecution.googleapis.com
build:remote-exec --remote_instance_name=projects/gse-enterprise-prod/instances/default_instance
build:remote-exec --jobs=200

# CI & Test settings
build:ci --config=remote-cache
build:ci --build_metadata=ROLE=CI
test --test_output=errors
test --test_summary=detailed
coverage --combined_report=lcov
coverage --instrumentation_filter="//..."
