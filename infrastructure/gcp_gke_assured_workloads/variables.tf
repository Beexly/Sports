# variables.tf — GKE Managed Service for Prometheus (GMP) & SLO Alert Variables
# Generated by gke-alert-configuration & google-cloud-slo-alert-configuration skills.

variable "project_id" {
  description = "Google Cloud Project ID hosting the GSE/GSI GKE cluster"
  type        = string
  default     = "gse-sovereign-prod"
}

variable "cluster_name" {
  description = "GKE cluster name for PromQL metric scoping"
  type        = string
  default     = "gse-inference-us-central1"
}

variable "namespace" {
  description = "Kubernetes namespace for the GSE prediction & JEV simulation engine"
  type        = string
  default     = "gse-engine"
}

variable "notification_channels" {
  description = "List of Cloud Monitoring Notification Channel IDs"
  type        = list(string)
  default     = []
}

variable "latency_p95_threshold_seconds" {
  description = "P95 HTTP/Flow latency threshold in seconds"
  type        = number
  default     = 0.35
}

variable "slo_target" {
  description = "Availability SLO target (e.g. 0.999 for 99.9%)"
  type        = number
  default     = 0.999
}
