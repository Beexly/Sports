# Oracle VPS stack config — copy to .env on the box (never commit the real .env).

# Your domain (DNS A records: ncaa.<domain> and llm.<domain> → the VPS public IP).
DOMAIN=example.com

# Redis password for the BullMQ store (use a long random string).
REDIS_PASSWORD=change-me-to-a-long-random-string

# HTTP basic-auth gate for the internal LLM endpoint (llm.<domain>).
LLM_BASICAUTH_USER=internal
# Generate: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'yourpass'
LLM_BASICAUTH_HASH=
