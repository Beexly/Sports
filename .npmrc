# Security control — added 2026-08-16 (adversarial security assessment, "the one thing").
#
# WHY: this repo is edited around the clock by an autonomous coding agent that is
# permitted to run `npm install`. With lifecycle scripts enabled, a single malicious
# or typosquatted package executes arbitrary code as the machine owner — on a box
# holding live Stripe keys, the production DATABASE_URL, and the agent's own provider
# credentials. That failure mode is total and unrecoverable; every other finding in
# the assessment was a bounded loss. Known-CVE gates do not help here, because a fresh
# typosquat has no advisory on day zero.
#
# COST: `npm install` no longer runs postinstall/prepare, so the Prisma client is not
# auto-generated. Use `npm run setup` instead — it installs, explicitly rebuilds only
# the six packages in this tree that genuinely need native/postinstall steps
# (@prisma/client, @prisma/engines, prisma, esbuild, unrs-resolver, @sentry/cli),
# then runs db:generate.
#
# Reversible in one line: delete this file.
ignore-scripts=true
