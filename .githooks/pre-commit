#!/usr/bin/env sh
# Pre-commit guardrail (BS-040): block commits that contain a real secret.
# Registered via `core.hooksPath=.githooks` (set automatically by the repo's
# `prepare` npm script; or run `node scripts/setup-git-hooks.mjs` manually).
#
# Scans only the STAGED files, so it is fast. To bypass in a genuine
# emergency: `git commit --no-verify` (do not make a habit of it).

node scripts/guardrails/secret-scan.mjs
status=$?
if [ "$status" -ne 0 ]; then
  echo "pre-commit: secret-scan blocked this commit (see above)." 1>&2
  exit "$status"
fi

# Alignment guardrail: a commit touching the engine surface must also stage
# docs/strategy/AGENT-ALIGNMENT.md, so parallel sessions stay aligned.
# Bypass a genuine no-op with GSE_ALIGN_SKIP=1.
node scripts/guardrails/alignment-guard.mjs
status=$?
if [ "$status" -ne 0 ]; then
  echo "pre-commit: alignment-guard blocked this commit (see above)." 1>&2
  exit "$status"
fi

# Definition of done: not behind origin, test staged with the change, record staged, handoff
# entry for today. Bypass a genuine no-op with GSE_DOD_SKIP=1.
node scripts/guardrails/definition-of-done.mjs
status=$?
if [ "$status" -ne 0 ]; then
  echo "pre-commit: definition-of-done blocked this commit (see above)." 1>&2
  exit "$status"
fi

# Connected 5-Stage Workflow & Zero-Contamination Dossier Guardrail:
# Dossier guard needs pandas. Resolve an interpreter that actually has it instead of
# assuming the PATH `python` does — on this box the PATH python is a bundled runtime
# without pandas, which made this guard crash and quietly push everyone to --no-verify.
DOSSIER_PY=""
for cand in python python3 "/c/Users/Garrett/AppData/Local/Python/pythoncore-3.14-64/python.exe"; do
  if command -v "$cand" >/dev/null 2>&1 && "$cand" -c "import pandas" >/dev/null 2>&1; then
    DOSSIER_PY="$cand"
    break
  fi
done

if [ -n "$DOSSIER_PY" ]; then
  "$DOSSIER_PY" scripts/guardrails/connected-workflow-dossier-guard.py
  status=$?
  if [ "$status" -ne 0 ]; then
    echo "pre-commit: connected-workflow-dossier-guard blocked this commit (see above)." 1>&2
    exit "$status"
  fi
else
  echo "pre-commit: SKIP connected-workflow-dossier-guard — no interpreter with pandas found." 1>&2
  echo "pre-commit: install pandas (pip install pandas) to re-enable this guardrail." 1>&2
fi
exit 0
